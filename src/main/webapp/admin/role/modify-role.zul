<?xml version="1.0" encoding="UTF-8"?>
<?page title="Express Clear - CTS Admin Modify Role"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>
<zk>
<borderlayout apply="com.iispl.cts.controller.admin.RoleFormController" hflex="1" vflex="1">

    <!-- Shared Left Sidebar Navigation -->
    <west width="220px" border="none" collapsible="false">
        <include src="/components/sidebar.zul" role="ADMIN" activeTab="role-management" />
    </west>

    <!-- Main Workspace -->
    <center border="none">
        <!-- Nested Borderlayout to pin header and scroll only the form -->
        <borderlayout hflex="1" vflex="1">
            
            <!-- Fixed Header (Does NOT scroll) -->
            <north size="auto" border="none">
                <include id="incHeader" src="/components/header.zul" 
                         pageTitle="Admin Dashboard" 
                         pageSubtitle="Role Management / Modify Role" />
            </north>

            <!-- Scrollable Form Container -->
            <center border="none" autoscroll="true" style="background-color: #f1f5f9;">
                <vlayout spacing="22px" style="padding: 28px 36px;" hflex="1">
                    <vlayout spacing="3px">
                        <label value="Modify Role" sclass="page-title"/>
                        <label value="Update role details and review assigned system operators." sclass="page-subtitle"/>
                    </vlayout>

                    <!-- Card Panel -->
                    <vlayout sclass="card-panel" spacing="20px" style="padding: 24px 28px;" hflex="1">
                        <vlayout spacing="2px">
                            <label value="Role Details" sclass="cts-card-title" />
                            <label value="Modify the configuration and status for this system role." sclass="cts-card-subtitle" />
                        </vlayout>

                        <hlayout spacing="20px" hflex="1">
                            <vlayout spacing="6px" hflex="1">
                                <label value="ROLE ID" sclass="field-label"/>
                                <textbox id="txtRoleId" readonly="true" hflex="1" height="38px" sclass="input-box input-box-readonly"/>
                            </vlayout>
                            <vlayout spacing="6px" hflex="1">
                                <label value="ROLE NAME" sclass="field-label"/>
                                <textbox id="txtRoleName" placeholder="Enter role name" hflex="1" height="38px" sclass="input-box"/>
                            </vlayout>
                        </hlayout>

                        <vlayout spacing="6px" hflex="1">
                            <label value="DESCRIPTION" sclass="field-label"/>
                            <textbox id="txtDescription" placeholder="Enter role description" hflex="1" height="38px" sclass="input-box"/>
                        </vlayout>

                        <vlayout spacing="6px" width="49%">
                            <label value="STATUS" sclass="field-label"/>
                            <combobox id="cmbStatus" readonly="true" width="100%" height="38px">
                                <comboitem label="Active" value="Active"/>
                                <comboitem label="Inactive" value="Inactive"/>
                            </combobox>
                        </vlayout>

                        <!-- Assigned Operators Section -->
                        <vlayout spacing="14px" hflex="1" style="border-top: 1px solid #f1f5f9; padding-top: 20px; margin-top: 4px;">
                            <vlayout spacing="3px">
                                <label value="Assigned Operators" sclass="cts-card-title"/>
                                <label value="Bank personnel currently provisioned under this role." sclass="cts-card-subtitle"/>
                            </vlayout>

                            <listbox id="lstAssignedUsers" emptyMessage="No operators are currently assigned to this role." hflex="1" sclass="custom-listbox" span="true">
                                <listhead>
                                    <listheader label="EMPLOYEE ID" hflex="2" />
        <listheader label="OPERATOR NAME" hflex="3" />
        <listheader label="USERNAME" hflex="2" />
        <listheader label="EMAIL" hflex="4" />
        <listheader label="MOBILE" hflex="2" />
        <listheader label="STATUS" hflex="2" align="center" />
                                </listhead>
                            </listbox>
                        </vlayout>

                        <!-- Actions -->
                        <hlayout hflex="1" spacing="10px" style="margin-top: 18px;">
                            <button id="btnSave" label="UPDATE ROLE" sclass="btn-primary"/>
                            <button id="btnCancel" label="CANCEL" sclass="btn-outline"/>
                        </hlayout>
                    </vlayout>
                </vlayout>
            </center>
        </borderlayout>
    </center>
</borderlayout>
</zk>