<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>
<zk>
<borderlayout apply="com.iispl.cts.controller.admin.RoleFormController" hflex="1" vflex="1">

    <!-- Shared Left Sidebar Navigation -->
    <west width="240px" border="none" collapsible="false">
        <include src="/components/sidebar.zul" role="ADMIN" activeTab="role-management" />
    </west>

    <!-- Main Workspace -->
    <center border="none" autoscroll="true" style="background-color: #f8fafc;">
        <vlayout spacing="0" hflex="1">
            
            <!-- Shared Header -->
            <include id="incHeader" src="/components/header.zul" 
                     pageTitle="Admin Dashboard" 
                     pageSubtitle="Role Management / Modify Role" />

            <!-- Form Content Container -->
            <vlayout sclass="role-content" spacing="24px" style="padding: 24px;" hflex="1">
                <vlayout spacing="4px">
                    <label value="MODIFY ROLE" sclass="page-title"/>
                    <label value="Update role details and screen permissions." sclass="page-subtitle"/>
                </vlayout>

                <!-- Card Panel -->
                <vlayout sclass="card-panel" spacing="20px" style="padding: 32px;" hflex="1">
                    <hlayout spacing="24px" hflex="1">
                        <vlayout spacing="6px" hflex="1">
                            <label value="ROLE ID" sclass="field-label"/>
                            <textbox id="txtRoleId" readonly="true" hflex="1" height="42px" sclass="input-box input-box-readonly"/>
                        </vlayout>
                        <vlayout spacing="6px" hflex="1">
                            <label value="ROLE NAME" sclass="field-label"/>
                            <textbox id="txtRoleName" placeholder="Enter role name" hflex="1" height="42px" sclass="input-box"/>
                        </vlayout>
                    </hlayout>

                    <vlayout spacing="6px" hflex="1">
                        <label value="DESCRIPTION" sclass="field-label"/>
                        <textbox id="txtDescription" placeholder="Enter role description" hflex="1" height="42px" sclass="input-box"/>
                    </vlayout>

                    <vlayout spacing="6px" width="50%">
                        <label value="STATUS" sclass="field-label"/>
                        <combobox id="cmbStatus" readonly="true" width="100%" height="42px">
                            <comboitem label="Active" value="Active"/>
                            <comboitem label="Inactive" value="Inactive"/>
                        </combobox>
                    </vlayout>

                    <!-- Permissions Section -->
                    <vlayout spacing="16px" hflex="1" style="border-top: 1px solid #f1f5f9; padding-top: 24px; margin-bottom: 8px;">
                        <vlayout spacing="4px">
                            <label value="Screen Permissions" style="font-size: 15px; font-weight: 700; color: #0f172a;"/>
                            <label value="Select the screens this role is allowed to view and access." style="color: #64748b; font-size: 13px;"/>
                        </vlayout>

                        <checkbox id="chkSelectAll" label="Select All" style="font-weight: 700; color: #0f172a; font-size: 13px;"/>

                        <hlayout spacing="24px" hflex="1">
                            <vlayout sclass="permission-box" spacing="12px" hflex="1">
                                <label value="AVAILABLE SCREENS" sclass="permission-title"/>
                                <vlayout spacing="10px">
                                    <checkbox id="chkDashboard" label="Dashboard"/>
                                    <checkbox id="chkBatchUpload" label="Batch Upload / Batch Intake"/>
                                    <checkbox id="chkBatchList" label="Batch List"/>
                                    <checkbox id="chkUnprocessedQueue" label="Unprocessed Queue"/>
                                    <checkbox id="chkMicrRepair" label="MICR Repair"/>
                                </vlayout>
                            </vlayout>

                            <vlayout sclass="permission-box" spacing="12px" hflex="1">
                                <label value="AVAILABLE SCREENS" sclass="permission-title"/>
                                <vlayout spacing="10px">
                                    <checkbox id="chkDataEntry" label="Data Entry"/>
                                    <checkbox id="chkChequeDetails" label="Cheque Details"/>
                                    <checkbox id="chkSubmitBatch" label="Submit Batch"/>
                                    <checkbox id="chkCheckerVerification" label="Checker Verification"/>
                                    <checkbox id="chkReports" label="Reports / EOD-BOD / Admin"/>
                                </vlayout>
                            </vlayout>
                        </hlayout>
                    </vlayout>

                    <!-- Actions -->
                    <hlayout hflex="1" style="justify-content: flex-end;" spacing="12px">
                        <button id="btnCancel" label="CANCEL" height="42px" sclass="btn-outline"/>
                        <button id="btnSave" label="UPDATE ROLE" height="42px" sclass="btn-primary"/>
                    </hlayout>
                </vlayout>
            </vlayout>

        </vlayout>
    </center>
</borderlayout>
</zk>