<?xml version="1.0" encoding="UTF-8"?>
<?page title="Express Clear - CTS Admin Role Management"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>
<zk>
	<borderlayout
		apply="com.iispl.cts.controller.admin.RoleManagementController"
		hflex="1" vflex="1">

		<!-- Sidebar navigation -->
		<west width="220px" border="none" collapsible="false">
			<include src="/components/sidebar.zul" role="ADMIN"
				activeTab="role-management" />
		</west>

		<!-- Main workspace -->
		<center border="none">
			<borderlayout hflex="1" vflex="1">

				<!-- Pinned top header -->
				<north size="auto" border="none">
					<include id="incHeader" src="/components/header.zul"
						pageTitle="Admin Dashboard" pageSubtitle="Role Management"
						showNotifications="false" />
				</north>

				<!-- Non-scrollable content area -->
				<center border="none" autoscroll="false"
					style="background-color: #f8fafc; overflow: hidden;">
					<vlayout sclass="role-content" spacing="14px"
						vflex="1" hflex="1"
						style="padding: 20px 24px 16px 24px; box-sizing: border-box; overflow: hidden;">

						<!-- Page heading -->
						<vlayout spacing="2px"
							style="flex: 0 0 auto;">
							<label value="Role Management"
								sclass="page-title" />
						</vlayout>

						<!-- System roles grid container -->
						<vlayout sclass="card-panel" spacing="12px"
							hflex="1" vflex="1"
							style="padding: 16px 22px; box-sizing: border-box; overflow: hidden;">

							<!-- Toolbar with item count and add action -->
							<hlayout valign="middle" hflex="1"
								style="justify-content: space-between; flex: 0 0 auto;">
								<hlayout valign="middle"
									spacing="8px">
									<label value="System Roles"
										style="font-size: 16px; font-weight: 700; color: #0f172a;" />
									<label id="lblRoleCount"
										value="Loading roles..."
										style="color: #64748b; font-size: 12px;" />
								</hlayout>
								<space hflex="1" />

								<!-- Trigger add role dialog -->
								<button id="btnAddRole"
									label="+ Add Role" sclass="btn-primary" height="34px" />
							</hlayout>

							<!-- Roles list grid -->
							<grid id="gridRoles" sclass="role-grid"
								span="true" vflex="1" hflex="1"
								emptyMessage="No roles found.">
								<columns sizable="false">
									<column label="ROLE ID" hflex="2"
										align="left" />
									<column label="ROLE NAME" hflex="3"
										align="left" />
									<column label="DESCRIPTION"
										hflex="6" align="left" />
									<column label="STATUS" hflex="2"
										align="center" />
									<column label="ACTIONS" hflex="2"
										align="center" />
								</columns>
								<rows id="rowsRoles">
									<!-- Populated dynamically by RoleManagementController -->
								</rows>
							</grid>
						</vlayout>

					</vlayout>
				</center>
			</borderlayout>
		</center>
	</borderlayout>
</zk>