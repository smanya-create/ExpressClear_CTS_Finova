<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>
<zk>
<borderlayout apply="com.iispl.cts.controller.admin.RoleManagementController" hflex="1" vflex="1">

    <!-- Shared Left Sidebar Navigation -->
    <west width="240px" border="none" collapsible="false">
        <include src="/components/sidebar.zul" role="ADMIN" activeTab="role-management" />
    </west>

    <!-- Main Workspace -->
    <center border="none" autoscroll="true" style="background-color: #f8fafc;">
        <vlayout spacing="0" hflex="1">
            
            <!-- Shared Header -->
            <include id="incHeader" src="/components/header.zul" 
                     pageTitle="Admin Dashboard" 
                     pageSubtitle="Role Management" />

            <!-- Content Area -->
            <vlayout sclass="role-content" spacing="24px" style="padding: 24px;" hflex="1">
                <hlayout valign="top" hflex="1" style="justify-content: space-between;">
                    <vlayout spacing="4px">
                        <label value="Role Management" sclass="page-title"/>
                        <label value="Manage system roles and their permissions." sclass="page-subtitle"/>
                    </vlayout>
                    <button id="btnAddRole" label="+ ADD ROLE" sclass="btn-primary" height="40px"/>
                </hlayout>

                <!-- Search Card -->
                <vlayout sclass="card-panel" spacing="0" hflex="1">
                    <hlayout spacing="16px" valign="bottom" hflex="1">
                        <vlayout spacing="6px" hflex="1">
                            <label value="SEARCH ROLES" sclass="field-label"/>
                            <textbox id="txtSearchRoles" placeholder="Search by Role ID or Role Name..." hflex="1" height="40px" sclass="input-box"/>
                        </vlayout>
                        <vlayout spacing="6px" width="200px">
                            <label value="STATUS" sclass="field-label"/>
                            <combobox id="cmbStatusFilter" readonly="true" width="100%" height="40px">
                                <comboitem label="All Status" value="ALL"/>
                                <comboitem label="Active" value="Active"/>
                                <comboitem label="Inactive" value="Inactive"/>
                            </combobox>
                        </vlayout>
                        <button id="btnSearch" label="SEARCH" height="40px" sclass="btn-primary"/>
                        <button id="btnReset" label="RESET" height="40px" sclass="btn-secondary"/>
                    </hlayout>
                </vlayout>

                <!-- Table Card -->
                <vlayout sclass="card-panel" spacing="16px" hflex="1">
                    <hlayout valign="middle" hflex="1" style="justify-content: space-between;">
                        <label value="Roles" style="font-size: 16px; font-weight: 700; color: #0f172a;"/>
                        <label id="lblRoleCount" value="Loading roles..." style="color: #64748b; font-size: 12px;"/>
                    </hlayout>

                    <grid sclass="role-grid" hflex="1">
                        <columns sizable="true">
                            <column label="ROLE ID" width="120px"/>
                            <column label="ROLE NAME" width="200px"/>
                            <column label="DESCRIPTION" hflex="1"/>
                            <column label="STATUS" width="120px"/>
                            <column label="ACTIONS" width="120px"/>
                        </columns>
                        <rows id="rowsRoles">
                            <!-- Populated by Controller -->
                        </rows>
                    </grid>
                </vlayout>
            </vlayout>

        </vlayout>
    </center>
</borderlayout>
</zk>