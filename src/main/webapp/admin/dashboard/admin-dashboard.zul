<?xml version="1.0" encoding="UTF-8"?>
<?page title="Express Clear - CTS Admin Portal"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/dashboard.css"?>
<zk>
    <borderlayout sclass="main-layout" vflex="1" hflex="1" apply="com.iispl.cts.controller.admin.AdminDashboardController">
        
        <!-- Reusable Left Sidebar -->
        <west width="220px" border="none" collapsible="false">
            <include src="/components/sidebar.zul" role="ADMIN" activeTab="admin-dashboard" />
        </west>

        <!-- Main Body Area -->
        <center border="none" autoscroll="true" style="background: #eef3f8;">
            <vlayout spacing="0" hflex="1">
               <timer id="timerActiveUsers" delay="3000" repeats="true" onTimer="$composer.refreshActiveUsers()" />
                <!-- Reusable Header Component -->
                <include src="/components/header.zul" 
                         pageTitle="Admin Dashboard" 
                         pageSubtitle="Session Management" />

                <!-- Main Content Body Container -->
                <vlayout sclass="cts-content-wrapper" spacing="16px" hflex="1">
                    
                    <!-- Top Heading -->
                    <vlayout sclass="cts-section-header" spacing="2px">
                        <label value="Session Management" sclass="cts-main-title" />
                        <label value="Select EOD or BOD and start the required CTS session." sclass="cts-main-subtitle" />
                    </vlayout>

                    <!-- 4-Column Stat KPI Card -->
                    <hlayout sclass="cts-stats-card" hflex="1" spacing="0">
                        <vlayout sclass="cts-stat-col" hflex="1" spacing="4px">
                            <label value="CURRENT CLEARING DATE" sclass="cts-stat-header" />
                            <label id="lblClearingDate" sclass="cts-stat-num" />
                        </vlayout>
                        
                        <vlayout sclass="cts-stat-col" hflex="1" spacing="4px">
                            <label value="SESSION STATUS" sclass="cts-stat-header" />
                            <hlayout sclass="cts-status-container" valign="middle" spacing="6px">
                                <div id="dotSessionStatus" sclass="cts-status-dot-open" />
                                <label id="lblSessionStatus" value="OPEN" sclass="cts-status-text-open" />
                            </hlayout>
                        </vlayout>
                        
                        <vlayout sclass="cts-stat-col" hflex="1" spacing="4px">
                            <label value="LOGGED-IN USERS" sclass="cts-stat-header" />
                            <label id="lblLoggedInUsers" value="0" sclass="cts-stat-num" />
                        </vlayout>
                        
                        <vlayout sclass="cts-stat-col cts-stat-col-last" hflex="1" spacing="4px">
                            <label value="PENDING CHEQUES" sclass="cts-stat-header" />
                            <hlayout sclass="cts-pending-flex" valign="middle" spacing="8px">
                                <label id="lblPendingCount" value="0" sclass="cts-stat-num cts-pending-num" />
                                <label id="lblPendingTag" value="Requires attention before EOD" sclass="cts-pending-warning-tag" />
                            </hlayout>
                        </vlayout>
                    </hlayout>

                    <!-- Session Action Selection Card -->
                    <vlayout sclass="cts-action-card" spacing="14px">
                        <vlayout spacing="2px">
                            <label value="Session Action" sclass="cts-card-title" />
                            <label value="Choose the session operation you want to perform." sclass="cts-card-subtitle" />
                        </vlayout>

                        <hlayout sclass="cts-options-grid" spacing="16px" hflex="1">
                            <!-- End of Day (EOD) Box -->
                            <div id="cardEOD" sclass="cts-choice-box cts-choice-box-active" hflex="1">
                                <hlayout sclass="cts-choice-inner" spacing="12px" valign="top">
                                    <div id="ringEOD" sclass="cts-custom-radio-ring cts-radio-checked">
                                        <div sclass="cts-radio-dot" />
                                    </div>
                                    <vlayout sclass="cts-choice-text" spacing="2px" hflex="1">
                                        <label value="End of Day (EOD)" sclass="cts-choice-title" />
                                        <label value="Close the current clearing day." sclass="cts-choice-desc" />
                                        <label value="Pending transactions will be checked before EOD." sclass="cts-choice-desc" />
                                        <label id="lblEODWarnText" value="3 pending cheques detected" sclass="cts-eod-alert" />
                                    </vlayout>
                                </hlayout>
                            </div>

                            <!-- Begin of Day (BOD) Box -->
                            <div id="cardBOD" sclass="cts-choice-box" hflex="1">
                                <hlayout sclass="cts-choice-inner" spacing="12px" valign="top">
                                    <div id="ringBOD" sclass="cts-custom-radio-ring">
                                        <div sclass="cts-radio-dot" />
                                    </div>
                                    <vlayout sclass="cts-choice-text" spacing="2px" hflex="1">
                                        <label value="Begin of Day (BOD)" sclass="cts-choice-title" />
                                        <label value="Start operations for the next working day." sclass="cts-choice-desc" />
                                        <label value="Previous-day EOD must be completed." sclass="cts-choice-desc" />
                                        <label value="Required previous-day checks will be validated." sclass="cts-choice-desc cts-text-muted" />
                                    </vlayout>
                                </hlayout>
                            </div>
                        </hlayout>

                        <!-- Dark Navy Action Button -->
                        <button id="btnStartSession" label="START SESSION" sclass="cts-btn-primary" />
                    </vlayout>

                    <!-- Informational Process Text -->
                    <vlayout sclass="cts-info-text-block" spacing="4px">
                        <label value="Select EOD to close the current clearing date or select BOD to begin the next clearing date." sclass="cts-info-line" />
                        <label value="For EOD, pending transactions may trigger the forced-EOD confirmation flow." sclass="cts-info-line" style="margin-top: 8px;" />
                        <label value="For BOD, the previous clearing day's EOD and required pending checks are validated." sclass="cts-info-line" />
                    </vlayout>

                    <!-- Pending Cheques Warning Callout Banner -->
                    <hlayout id="boxWarningBanner" sclass="cts-warning-banner" visible="false" valign="middle" hflex="1">
                        <hlayout sclass="cts-warn-left" hflex="1" valign="middle" spacing="12px">
                            <label value="!" sclass="cts-warn-icon" />
                            <vlayout sclass="cts-warn-text-group" spacing="2px">
                                <label value="Pending Cheques Require Attention" sclass="cts-warn-title" />
                                <label id="lblWarningMsg" value="3 cheques are currently pending. Review their current processing stage before performing EOD." sclass="cts-warn-desc" />
                            </vlayout>
                        </hlayout>
                        
                        <vlayout sclass="cts-warn-right" spacing="4px" style="align-items: flex-end;">
                            <button id="btnViewPending" label="VIEW PENDING CHEQUES" sclass="cts-btn-view-pending" />
                            <label value="Shows batch, cheque and current processing stage" sclass="cts-warn-footnote" />
                        </vlayout>
                    </hlayout>

                    <!-- Portal Footer -->
                    <hlayout sclass="cts-portal-footer" hflex="1" style="justify-content: space-between; margin-top: 16px;">
                        <label value="Express Clear CTS · Admin Portal" sclass="cts-footer-left" />
                        <label value="Secure Session Management" sclass="cts-footer-right" />
                    </hlayout>

                </vlayout>

            </vlayout>
        </center>
    </borderlayout>
</zk>