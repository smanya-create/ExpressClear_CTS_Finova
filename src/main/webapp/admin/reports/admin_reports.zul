<?page title="Express Clear - CTS Admin Reports"?>
<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>
<zk>
<borderlayout apply="com.iispl.cts.controller.admin.AdminReportController" hflex="1" vflex="1">

    <!-- Left Navigation Sidebar -->
    <west width="240px" border="none" collapsible="false">
        <include src="/components/sidebar.zul" role="ADMIN" activeTab="reports" />
    </west>

    <center border="none">
        <borderlayout hflex="1" vflex="1">
            
            <!-- Fixed Header -->
            <north size="auto" border="none">
                <include id="incHeader" src="/components/header.zul" 
                         pageTitle="Admin Dashboard" 
                         pageSubtitle="Reports" />
            </north>

            <!-- Main Content Canvas -->
            <center border="none" autoscroll="false" style="background-color: #f8fafc; overflow: hidden;">
                <vlayout sclass="role-content" spacing="16px" vflex="1" hflex="1" 
                         style="padding: 24px; box-sizing: border-box; overflow-y: auto;">
                    
                    <!-- Page Title -->
                    <vlayout spacing="3px" style="flex: 0 0 auto;">
                        <label value="Reports" sclass="page-title" />
                    </vlayout>

                    <!-- Parameters Card Container -->
                    <vlayout sclass="card-panel" spacing="20px" 
                             style="padding: 26px 30px; margin-top: 8px; max-width: 820px; flex: 0 0 auto;">
                        
                        <label value="Report Parameters" style="font-size: 14px; font-weight: 800; color: #1e293b; letter-spacing: 0.5px;" />
                        
                        <!-- Report Type Selector -->
                        <vlayout spacing="6px" hflex="1">
                            <label value="REPORT TYPE" sclass="field-label" />
                            <combobox id="cmbReportType" readonly="true" width="100%" height="38px" style="font-size: 13px;">
                                <comboitem label="User Activity &amp; Security Audit Report" value="USER_AUDIT" />
                                <comboitem label="BOD / EOD Session Lifecycle" value="SESSION_LIFECYCLE" />
                            </combobox>
                        </vlayout>
                        
                        <!-- Date Pickers Row -->
                        <hlayout spacing="24px" hflex="1">
                            <vlayout spacing="6px" hflex="1">
                                <label value="FROM DATE" sclass="field-label" />
                                <datebox id="dtFromDate" format="dd-MM-yyyy" height="38px" hflex="1" />
                            </vlayout>

                            <vlayout spacing="6px" hflex="1">
                                <label value="TO DATE" sclass="field-label" />
                                <datebox id="dtToDate" format="dd-MM-yyyy" height="38px" hflex="1" />
                            </vlayout>
                        </hlayout>

                       <!-- Format Selector (Radio Group) -->
                        <vlayout spacing="8px">
                            <label value="EXPORT FORMAT" sclass="field-label" />
                            <radiogroup id="rgExportFormat">
                                <hlayout spacing="28px" valign="middle" style="padding-top: 2px;">
                                    <radio id="radPdf" label="PDF Document (.pdf)" value="PDF" selected="true" sclass="cts-radio" />
                                    <radio id="radCsv" label="CSV Spreadsheet (.csv)" value="CSV" sclass="cts-radio" />
                                </hlayout>
                            </radiogroup>
                        </vlayout>

                        <!-- Standard Card Divider -->
                        <div style="height: 1px; background: #e2e8f0; width: 100%; margin: 4px 0;" />

                        <!-- Single Consolidated Primary Action Button -->
                        <hlayout>
                            <button id="btnGenerateReport" label="GENERATE REPORT" 
                                    iconSclass="z-icon-file-text-o"
                                    sclass="btn-primary" height="38px" />
                        </hlayout>

                    </vlayout>

                </vlayout>
            </center>
        </borderlayout>
    </center>
</borderlayout>
</zk>