<?xml version="1.0" encoding="UTF-8"?>
<zk>
	<style src="/css/outward/maker-batch-details.css" />

	<div id="outwardMakerBatchDetailsDiv"
		sclass="outward-maker-batch-details"
		apply="com.iispl.cts.controller.outward.maker.OutwardMakerBatchDetailsController">

		<div sclass="outward-maker-batch-details-scroll">

			<!-- Page Heading -->
			<div sclass="outward-maker-batch-details-heading">
				<div
					sclass="outward-maker-batch-details-title-section">
					<label value="Batch Details"
						sclass="outward-maker-batch-details-title" />
					<label
						value="View and process outward cheques in this batch."
						sclass="outward-maker-batch-details-subtitle" />
				</div>

				<button id="outwardMakerBtnBack" label="Back"
					iconSclass="z-icon-arrow-left"
					sclass="outward-maker-btn-action-back" />
			</div>

			<!-- Batch Summary Card -->
			<div sclass="outward-maker-batch-summary">
				<div sclass="outward-maker-batch-summary-item">
					<label value="Batch Id"
						sclass="outward-maker-batch-summary-label" />
					<label id="outwardMakerLblBatchId" value="-"
						sclass="outward-maker-batch-summary-value outward-maker-batch-id-highlight" />
				</div>

				<div sclass="outward-maker-batch-summary-item">
					<label value="No. Of Cheques"
						sclass="outward-maker-batch-summary-label" />
					<label id="outwardMakerLblChequeCount" value="0"
						sclass="outward-maker-batch-summary-value" />
				</div>

				<div sclass="outward-maker-batch-summary-item">
					<label value="Total Amount"
						sclass="outward-maker-batch-summary-label" />
					<label id="outwardMakerLblTotalAmount" value="₹0.00"
						sclass="outward-maker-batch-summary-value" />
				</div>
			</div>

			<!-- Cheque Details Section -->
			<div sclass="outward-maker-cheque-section">
				<!-- Title with Subtitle stacked directly underneath -->
				<div sclass="outward-maker-cheque-section-header">
					<label value="Cheque Details"
						sclass="outward-maker-cheque-section-title" />
					<label
						value="Review outward cheque information and take the required action."
						sclass="outward-maker-cheque-section-subtitle" />
				</div>

				<!-- Pure DIV Table Card -->
				<div sclass="outward-maker-cheque-table-card">

					<!-- Table Header Row (DIV) - Compact 30px / 8.5px -->
					<div sclass="div-table-header">
						<div sclass="div-th col-chq-no">
							<label value="Cheque No." />
						</div>
						<div sclass="div-th col-acc-no">
							<label value="Payee Account No." />
						</div>
						<div sclass="div-th col-date">
							<label value="Cheque Date" />
						</div>
						<div sclass="div-th col-micr">
							<label value="MICR Code" />
						</div>
						<div sclass="div-th col-status">
							<label value="Cheque Status" />
						</div>
						<div sclass="div-th col-amount">
							<label value="Cheque Amount" />
						</div>
						<div sclass="div-th col-action">
							<label value="Action" />
						</div>
					</div>

					<!-- Table Body Rows Container (DIV) -->
					<div id="outwardMakerDivRowsContainer"
						sclass="div-table-body">
						<!-- Dynamic Row DIVs are appended here by Controller -->
					</div>

					<!-- Empty State (DIV) -->
					<div id="outwardMakerVlayoutEmptyState"
						visible="false" sclass="outward-maker-empty-state">
						<label value="No Cheques Found"
							sclass="outward-maker-empty-title" />
						<label
							value="There are currently no cheques available in this batch."
							sclass="outward-maker-empty-subtitle" />
					</div>

					<!-- Pinned Centered Pagination Bar -->
					<div sclass="outward-maker-pagination">
						<button id="outwardMakerBtnFirst"
							label="&lt;&lt;" sclass="outward-maker-pagination-button" />
						<button id="outwardMakerBtnPrevious"
							label="&lt;" sclass="outward-maker-pagination-button" />
						<label id="outwardMakerLblCurrentPage"
							value="1 / 1" sclass="outward-maker-pagination-label" />
						<button id="outwardMakerBtnNext" label="&gt;"
							sclass="outward-maker-pagination-button" />
						<button id="outwardMakerBtnLast"
							label="&gt;&gt;" sclass="outward-maker-pagination-button" />
					</div>
				</div>
			</div>

		</div>
	</div>
</zk>