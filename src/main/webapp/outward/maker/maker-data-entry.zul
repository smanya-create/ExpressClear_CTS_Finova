<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward Data Entry" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/css/outward/data-entry.css"?>

<zk xmlns:h="xhtml">

	<zscript>
	org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("CTS_USER_ROLE", "OUTWARD_MAKER");
	org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("CTS_USERNAME", "Alex");
</zscript>

	<window id="outwardDataEntryRootWin" border="none" width="100%"
		height="100%"
		style="margin: 0 !important; padding: 0 !important; position: absolute; top: 0; left: 0; right: 0; bottom: 0;">

		<borderlayout hflex="1" vflex="1"
			style="margin: 0 !important; padding: 0 !important; background: transparent;">

			<west size="220px" border="none"
				style="margin: 0 !important; padding: 0 !important; background-color: #0b1d3a !important;">

				<include src="/components/sidebar.zul"
					role="OUTWARD_MAKER" activeTab="outward-data-entry" vflex="1"
					hflex="1" />

			</west>

			<center border="none" autoscroll="true"
				sclass="main-content">

				<vlayout spacing="16px" sclass="dashboard-container"
					hflex="1">

					<include id="headerInclude"
						src="/components/header.zul" pageTitle="Maker Dashboard"
						pageSubtitle="Data Entry" />

					<include id="mainContentArea" mode="instant"
						src="/outward/maker/data-entry.zul" hflex="1" />

				</vlayout>

			</center>

		</borderlayout>

	</window>

</zk>