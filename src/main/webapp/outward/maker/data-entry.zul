<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Outward Data Entry" contentType="text/html;charset=UTF-8"?>
<zk>
	<style src="/css/outward/data-entry.css" />

	<div id="outwardDataEntryMain" width="100%" height="100%"
		sclass="outward-data-entry-page"
		apply="com.iispl.cts.controller.outward.maker.OutwardDataEntryController">

		<!-- Heading Group: Stacked vertically with title slightly higher -->
		<div sclass="outward-data-entry-heading">
			<label value="Data Entry" sclass="outward-data-entry-title" />
			<label value="Select a batch ready for cheque data entry."
				sclass="outward-data-entry-subtitle" />
		</div>

		<!-- Card Area -->
		<div sclass="outward-data-entry-table-card">
			<!-- Header: Title on far left, "1 Batch" pushed to far right corner -->
			<div sclass="card-top-bar">
				<label value="Batches Ready For Data Entry"
					sclass="outward-data-entry-card-title" />
				<label id="outwardDataEntryLblBatchCount"
					value="1 Batch" sclass="outward-data-entry-batch-count" />
			</div>

			<!-- Grid Table with Navy Header and Soft Borders -->
			<grid id="outwardDataEntryGridBatch" width="100%"
				sclass="outward-data-entry-grid">
				<columns sizable="false">
					<column label="Batch No." width="16%"
						align="center" />
					<column label="Total No. Of Cheques" width="18%"
						align="center" />
					<column label="Pending Data Entry" width="18%"
						align="center" />
					<column label="MICR Rejected" width="15%"
						align="center" />
					<column label="Status" width="19%" align="center" />
					<column label="Action" width="14%" align="center" />
				</columns>
				<rows id="outwardDataEntryRowsBatch" />
			</grid>

			<!-- Empty State -->
			<vlayout id="outwardDataEntryEmptyState" visible="false"
				sclass="outward-data-entry-empty-state">
				<label value="No Batches Ready For Data Entry"
					sclass="outward-data-entry-empty-title" />
				<label
					value="There are currently no batches available for data entry."
					sclass="outward-data-entry-empty-subtitle" />
			</vlayout>

			<!-- Centered Pagination Bar -->
			<div id="outwardDataEntryPagination"
				sclass="outward-maker-pagination">
				<button id="outwardDataEntryBtnFirst" label="&lt;&lt;"
					sclass="outward-maker-pagination-button" />
				<button id="outwardDataEntryBtnPrevious" label="&lt;"
					sclass="outward-maker-pagination-button" />
				<label id="outwardMakerLblCurrentPage" value="1 / 1"
					sclass="outward-maker-pagination-label" />
				<button id="outwardDataEntryBtnNext" label="&gt;"
					sclass="outward-maker-pagination-button" />
				<button id="outwardDataEntryBtnLast" label="&gt;&gt;"
					sclass="outward-maker-pagination-button" />
			</div>
		</div>

	</div>
</zk>