<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/outward/data-entry.css" />

	<window id="outwardDataEntryMain" border="none" width="100%"
		height="100%"
		apply="com.iispl.cts.controller.outward.maker.OutwardDataEntryController">

		<vlayout id="outwardDataEntryPage"
			sclass="outward-data-entry-page" width="100%" vflex="1"
			spacing="0">

			<vlayout id="outwardDataEntryHeading"
				sclass="outward-data-entry-heading" width="100%" spacing="3px">

				<label id="outwardDataEntryLblTitle" value="Data Entry"
					sclass="outward-data-entry-title" />

				<label id="outwardDataEntryLblSubtitle"
					value="Select a batch ready for cheque data entry"
					sclass="outward-data-entry-subtitle" />

			</vlayout>

			<groupbox id="outwardDataEntryTableCard"
				sclass="outward-data-entry-table-card" width="100%" mold="3d">

				<caption id="outwardDataEntryTableCaption">

					<hlayout id="outwardDataEntryCaptionLayout"
						sclass="outward-data-entry-caption-layout" width="100%"
						valign="middle" spacing="0">

						<label id="outwardDataEntryLblTableTitle"
							value="Batches Ready For Data Entry"
							sclass="outward-data-entry-card-title" />

						<label id="outwardDataEntryLblCaptionSpacer"
							value="" hflex="1" sclass="outward-data-entry-caption-spacer" />

						<label id="outwardDataEntryLblBatchCount"
							value="0 Batches" sclass="outward-data-entry-batch-count" />

					</hlayout>

				</caption>

				<grid id="outwardDataEntryGridBatch" width="100%"
					sclass="outward-data-entry-grid">

					<columns sizable="false">

						<column label="Batch No." width="20%"
							align="center" />

						<column label="Total No. Of Cheques" width="22%"
							align="center" />

						<column label="Pending Data Entry" width="25%"
							align="center" />

						<column label="Status" width="16%"
							align="center" />

						<column label="Action" width="17%"
							align="center" />

					</columns>

					<rows id="outwardDataEntryRowsBatch" />

				</grid>

				<vlayout id="outwardDataEntryEmptyState" visible="false"
					sclass="outward-data-entry-empty-state" width="100%"
					spacing="5px">

					<label id="outwardDataEntryLblEmptyTitle"
						value="No Batches Ready For Data Entry"
						sclass="outward-data-entry-empty-title" />

					<label id="outwardDataEntryLblEmptySubtitle"
						value="There Are Currently No Batches Available For Data Entry."
						sclass="outward-data-entry-empty-subtitle" />

				</vlayout>

			</groupbox>

			<hlayout id="outwardDataEntryPagination"
				sclass="outward-maker-pagination" width="100%" spacing="6px">

				<button id="outwardDataEntryBtnFirst" label="&lt;&lt;"
					sclass="outward-maker-pagination-button" />

				<button id="outwardDataEntryBtnPrevious" label="&lt;"
					sclass="outward-maker-pagination-button" />

				<label id="outwardDataEntryLblCurrentPage" value="1 / 1"
					sclass="outward-maker-pagination-label" />

				<button id="outwardDataEntryBtnNext" label="&gt;"
					sclass="outward-maker-pagination-button" />

				<button id="outwardDataEntryBtnLast" label="&gt;&gt;"
					sclass="outward-maker-pagination-button" />

			</hlayout>

		</vlayout>

	</window>

</zk>