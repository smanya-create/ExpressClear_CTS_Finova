<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward Processing" contentType="text/html;charset=UTF-8"?>

<zk>

	<zscript>
	org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("CTS_USER_ROLE", "OUTWARD_MAKER");
	org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("CTS_USERNAME", "Alex");
</zscript>

	<window id="outwardMakerRootWin" border="none" width="100%"
		height="100%"
		style="margin:0 !important; padding:0 !important; position:absolute; top:0; left:0; right:0; bottom:0; overflow:hidden;">

		<borderlayout hflex="1" vflex="1"
			style="margin:0 !important; padding:0 !important; background:transparent;">

			<west size="220px" border="none"
				style="margin:0 !important; padding:0 !important; background-color:#0b1d3a !important;">

				<include id="sidebarInclude"
					src="/components/sidebar.zul" role="OUTWARD_MAKER"
					activeTab="maker-dashboard" hflex="1" vflex="1" />

			</west>

			<center id="outwardMakerCenter" border="none"
				autoscroll="false"
				style="margin:0 !important; padding:0 !important; overflow:hidden;">

				<borderlayout hflex="1" vflex="1"
					style="margin:0 !important; padding:0 !important; overflow:hidden;">

					<north id="outwardMakerHeaderArea" size="84px"
						border="none"
						style="margin:0 !important; padding:0 !important; overflow:hidden;">

						<include id="headerInclude"
							src="/components/header.zul" pageTitle="Maker Dashboard"
							pageSubtitle="Outward Processing" hflex="1" vflex="1" />

					</north>

					<center id="outwardMakerContentArea" border="none"
						autoscroll="true"
						style="margin:0 !important; padding:0 !important; overflow:auto;">

						<include id="mainContentArea" mode="instant"
							src="/outward/maker/dashboard.zul" hflex="1" />

					</center>

				</borderlayout>

			</center>

		</borderlayout>

	</window>

</zk>