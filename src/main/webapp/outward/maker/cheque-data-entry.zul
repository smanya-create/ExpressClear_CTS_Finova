<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Cheque Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/outward/cheque-data-entry.css" />

	<window id="outwardChequeDataEntryWin" border="none" width="100%"
		apply="com.iispl.cts.controller.outward.maker.OutwardChequeDataEntryController">

		<vlayout id="outwardChequeDataEntryPage"
			sclass="outward-cheque-data-entry-page" width="100%" spacing="0">

			<hlayout id="outwardChequeDataEntryTopBar"
				sclass="outward-cheque-data-entry-top-bar" width="100%"
				valign="middle" spacing="0">

				<button id="outwardChequeDataEntryBtnBack"
					label="BACK TO DATA ENTRY LIST"
					sclass="outward-cheque-data-entry-back-button" />

			</hlayout>

			<hlayout id="outwardChequeDataEntryHeader"
				sclass="outward-cheque-data-entry-header" width="100%"
				valign="middle" spacing="0">

				<vlayout id="outwardChequeDataEntryTitleSection"
					sclass="outward-cheque-data-entry-title-section" hflex="1"
					spacing="4px">

					<label id="outwardChequeDataEntryLblTitle"
						value="CHEQUE DATA ENTRY"
						sclass="outward-cheque-data-entry-title" />

					<label id="outwardChequeDataEntryLblSubtitle"
						value="Review and correct cheque details against the scanned image"
						sclass="outward-cheque-data-entry-subtitle" />

				</vlayout>

				<hlayout id="outwardChequeDataEntryRecordSection"
					sclass="outward-cheque-data-entry-record-section" valign="middle"
					spacing="0">

					<label id="outwardChequeDataEntryLblRecord"
						value="CHEQUE 1" sclass="outward-cheque-data-entry-record-label" />

				</hlayout>

			</hlayout>

			<hlayout id="outwardChequeDataEntrySummary"
				sclass="outward-cheque-data-entry-summary" width="100%"
				valign="middle" spacing="10px">

				<vlayout id="outwardChequeDataEntrySummaryBatch"
					sclass="outward-cheque-data-entry-summary-item" hflex="1"
					spacing="4px">

					<label value="BATCH NO"
						sclass="outward-cheque-data-entry-summary-label" />

					<label id="outwardChequeDataEntryLblBatchId"
						value="-" sclass="outward-cheque-data-entry-summary-value" />

				</vlayout>

				<vlayout id="outwardChequeDataEntrySummaryCheque"
					sclass="outward-cheque-data-entry-summary-item" hflex="1"
					spacing="4px">

					<label value="CHEQUE NUMBER"
						sclass="outward-cheque-data-entry-summary-label" />

					<label
						id="outwardChequeDataEntryLblSummaryChequeNumber" value="-"
						sclass="outward-cheque-data-entry-summary-value" />

				</vlayout>

				<vlayout id="outwardChequeDataEntrySummaryTotal"
					sclass="outward-cheque-data-entry-summary-item" hflex="1"
					spacing="4px">

					<label value="TOTAL CHEQUES"
						sclass="outward-cheque-data-entry-summary-label" />

					<label id="outwardChequeDataEntryLblTotal" value="0"
						sclass="outward-cheque-data-entry-summary-value" />

				</vlayout>

				<vlayout id="outwardChequeDataEntrySummaryRemaining"
					sclass="outward-cheque-data-entry-summary-item" hflex="1"
					spacing="4px">

					<label value="REMAINING CHEQUES"
						sclass="outward-cheque-data-entry-summary-label" />

					<label id="outwardChequeDataEntryLblRemaining"
						value="0" sclass="outward-cheque-data-entry-summary-value" />

				</vlayout>

			</hlayout>

			<hlayout id="outwardChequeDataEntryMainArea"
				sclass="outward-cheque-data-entry-main-area" width="100%"
				valign="top" spacing="18px">

				<groupbox id="outwardChequeDataEntryImageCard"
					sclass="outward-cheque-data-entry-card outward-cheque-data-entry-image-card"
					hflex="1" mold="3d">

					<caption label="CHEQUE IMAGE"
						sclass="outward-cheque-data-entry-card-header" />

					<vlayout id="outwardChequeDataEntryImageContent"
						width="100%" spacing="10px">

						<hlayout
							id="outwardChequeDataEntryImageToggleArea" width="100%"
							valign="middle" spacing="0">

							<button
								id="outwardChequeDataEntryBtnImageToggle" label="BACK VIEW"
								sclass="outward-cheque-data-entry-image-toggle-button" />

						</hlayout>

						<vlayout
							id="outwardChequeDataEntryImageContainer"
							sclass="outward-cheque-data-entry-image-container" width="100%"
							height="420px" spacing="0">

							<image
								id="outwardChequeDataEntryChequeImage"
								sclass="outward-cheque-data-entry-cheque-image" visible="true" />

							<label
								id="outwardChequeDataEntryLblImageMessage"
								value="CHEQUE IMAGE NOT AVAILABLE"
								sclass="outward-cheque-data-entry-image-message"
								visible="false" />

						</vlayout>

						<hlayout
							id="outwardChequeDataEntryImageNavigation"
							sclass="outward-cheque-data-entry-image-navigation" width="100%"
							valign="middle" spacing="8px">

							<button
								id="outwardChequeDataEntryBtnPrevious" label="PREVIOUS"
								sclass="outward-cheque-data-entry-navigation-button" hflex="1" />

							<hlayout
								id="outwardChequeDataEntryImageControls"
								sclass="outward-cheque-data-entry-image-controls" hflex="1"
								valign="middle" spacing="8px">

								<button
									id="outwardChequeDataEntryBtnZoomOut" label="-"
									sclass="outward-cheque-data-entry-image-control-button" />

								<button
									id="outwardChequeDataEntryBtnZoomIn" label="+"
									sclass="outward-cheque-data-entry-image-control-button" />

								<button
									id="outwardChequeDataEntryBtnRotate" label="ROTATE"
									sclass="outward-cheque-data-entry-image-control-button outward-cheque-data-entry-image-control-wide" />

								<button
									id="outwardChequeDataEntryBtnReset" label="RESET"
									sclass="outward-cheque-data-entry-image-control-button outward-cheque-data-entry-image-control-wide" />

							</hlayout>

							<button id="outwardChequeDataEntryBtnNext"
								label="NEXT"
								sclass="outward-cheque-data-entry-navigation-button" hflex="1" />

						</hlayout>

					</vlayout>

				</groupbox>

				<groupbox id="outwardChequeDataEntryDetailsCard"
					sclass="outward-cheque-data-entry-card outward-cheque-data-entry-details-card"
					hflex="1" mold="3d">

					<caption label="CHEQUE DETAILS"
						sclass="outward-cheque-data-entry-card-header" />

					<vlayout id="outwardChequeDataEntryDetailsContent"
						width="100%" spacing="16px">

						<hlayout id="outwardChequeDataEntryFields"
							width="100%" valign="top" spacing="20px">

							<vlayout
								id="outwardChequeDataEntryLeftFields" hflex="1"
								spacing="14px">

								<vlayout
									id="outwardChequeDataEntryChequeNumberField" width="100%"
									spacing="5px">

									<label value="CHEQUE NUMBER"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtChequeNumber" width="100%"
										maxlength="20" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout
									id="outwardChequeDataEntryDateField" width="100%"
									spacing="5px">

									<label value="CHEQUE DATE"
										sclass="outward-cheque-data-entry-field-label" />

									<datebox
										id="outwardChequeDataEntryDtChequeDate" width="100%"
										format="dd-MM-yyyy" buttonVisible="true"
										sclass="outward-cheque-data-entry-datebox" />

								</vlayout>

								<vlayout
									id="outwardChequeDataEntryPayeeAccountField" width="100%"
									spacing="5px">

									<label value="PAYEE ACCOUNT NUMBER"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtPayeeAccount" width="100%"
										maxlength="30" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout
									id="outwardChequeDataEntryDraweeNameField" width="100%"
									spacing="5px">

									<label value="DRAWEE NAME"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtDraweeName" width="100%"
										maxlength="150" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

							</vlayout>

							<vlayout
								id="outwardChequeDataEntryRightFields" hflex="1"
								spacing="14px">

								<vlayout
									id="outwardChequeDataEntryAmountField" width="100%"
									spacing="5px">

									<label value="CHEQUE AMOUNT"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtAmount" width="100%"
										maxlength="20" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout
									id="outwardChequeDataEntryMicrField" width="100%"
									spacing="5px">

									<label value="MICR CODE"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtMicrCode" width="100%"
										maxlength="20" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout
									id="outwardChequeDataEntryPayeeNameField" width="100%"
									spacing="5px">

									<label value="PAYEE NAME"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtPayeeName" width="100%"
										maxlength="150" sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<space height="46px" />

							</vlayout>

						</hlayout>

						<vlayout id="outwardChequeDataEntryStatusArea"
							width="100%" spacing="4px">

							<label
								id="outwardChequeDataEntryLblValidationStatus" value=""
								sclass="outward-cheque-data-entry-status-label" visible="false" />

						</vlayout>

						<hlayout id="outwardChequeDataEntryActions"
							width="100%" valign="middle" spacing="10px">

							<button id="outwardChequeDataEntryBtnReject"
								label="REJECTION REQUEST"
								sclass="outward-cheque-data-entry-reject-button" hflex="1" />

							<button
								id="outwardChequeDataEntryBtnSaveNext" label="SAVE &amp; NEXT"
								sclass="outward-cheque-data-entry-save-button" hflex="1" />

						</hlayout>

						<hlayout id="outwardChequeDataEntrySubmitArea"
							width="100%" valign="middle" spacing="0">

							<button id="outwardChequeDataEntryBtnSubmit"
								label="SUBMIT TO CHECKER"
								sclass="outward-cheque-data-entry-submit-button" hflex="1"
								disabled="true" />

						</hlayout>

					</vlayout>

				</groupbox>

			</hlayout>

		</vlayout>

		<window id="outwardChequeDataEntryRejectWindow"
			title="REJECTION REQUEST" border="normal" mode="modal"
			closable="false" width="480px" visible="false"
			sclass="outward-cheque-data-entry-reject-window">

			<vlayout id="outwardChequeDataEntryRejectContent"
				width="100%" spacing="16px"
				sclass="outward-cheque-data-entry-reject-content">

				<vlayout id="outwardChequeDataEntryRejectReasonField"
					width="100%" spacing="5px">

					<label value="REJECTED REASON"
						sclass="outward-cheque-data-entry-modal-label" />

					<combobox id="outwardChequeDataEntryCmbRejectReason"
						width="100%" readonly="true"
						sclass="outward-cheque-data-entry-reason-combobox"
						placeholder="SELECT REASON" />

				</vlayout>

				<vlayout id="outwardChequeDataEntryRejectRemarksField"
					width="100%" spacing="5px">

					<label value="REMARKS"
						sclass="outward-cheque-data-entry-modal-label" />

					<textbox id="outwardChequeDataEntryTxtRejectRemarks"
						width="100%" rows="5" multiline="true" maxlength="500"
						sclass="outward-cheque-data-entry-remarks-textbox"
						placeholder="ENTER REMARKS" />

				</vlayout>

				<hlayout id="outwardChequeDataEntryRejectActions"
					width="100%" valign="middle" spacing="10px">

					<button id="outwardChequeDataEntryBtnConfirmReject"
						label="REJECT REQUEST"
						sclass="outward-cheque-data-entry-confirm-reject-button"
						hflex="1" />

					<button id="outwardChequeDataEntryBtnCancelReject"
						label="CLOSE" sclass="outward-cheque-data-entry-close-button"
						hflex="1" />

				</hlayout>

			</vlayout>

		</window>

	</window>

</zk>