<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward Cheque Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/outward/cheque-data-entry.css" />

	<window id="outwardChequeDataEntryWin" border="none" width="100%"
		vflex="1"
		apply="com.iispl.cts.controller.outward.maker.OutwardChequeDataEntryController">

		<vlayout width="100%" spacing="0px"
			sclass="outward-cheque-data-entry-page">

			<div sclass="outward-cheque-data-entry-topbar">

				<button id="outwardChequeDataEntryBtnBack"
					label="BACK TO DATA ENTRY LIST"
					sclass="outward-cheque-data-entry-back-button" />

			</div>

			<vlayout spacing="3px"
				sclass="outward-cheque-data-entry-heading">

				<label value="CHEQUE DATA ENTRY"
					sclass="outward-cheque-data-entry-title" />

				<label
					value="Enter cheque details using the scanned cheque image"
					sclass="outward-cheque-data-entry-subtitle" />

			</vlayout>

			<div sclass="outward-cheque-data-entry-summary-card"
				width="100%">

				<hlayout width="100%" spacing="0px">

					<vlayout hflex="1" spacing="2px">

						<label value="BATCH"
							sclass="outward-cheque-data-entry-summary-label" />

						<label id="outwardChequeDataEntryLblBatchId"
							value="-" sclass="outward-cheque-data-entry-summary-value" />

					</vlayout>

					<vlayout hflex="1" spacing="2px">

						<label value="TOTAL CHEQUES"
							sclass="outward-cheque-data-entry-summary-label" />

						<label id="outwardChequeDataEntryLblTotal"
							value="0" sclass="outward-cheque-data-entry-summary-value" />

					</vlayout>

					<vlayout hflex="1" spacing="2px">

						<label value="DATA ENTERED"
							sclass="outward-cheque-data-entry-summary-label" />

						<label id="outwardChequeDataEntryLblEntered"
							value="0" sclass="outward-cheque-data-entry-summary-value" />

					</vlayout>

					<vlayout hflex="1" spacing="2px">

						<label value="REMAINING"
							sclass="outward-cheque-data-entry-summary-label" />

						<label id="outwardChequeDataEntryLblRemaining"
							value="0" sclass="outward-cheque-data-entry-summary-value" />

					</vlayout>

					<vlayout hflex="1" spacing="2px">

						<label value="CURRENT RECORD"
							sclass="outward-cheque-data-entry-summary-label" />

						<label id="outwardChequeDataEntryLblRecord"
							value="0 / 0" sclass="outward-cheque-data-entry-summary-value" />

					</vlayout>

				</hlayout>

			</div>

			<hlayout width="100%" spacing="20px"
				sclass="outward-cheque-data-entry-work-area">

				<div hflex="55"
					sclass="outward-cheque-data-entry-image-card">

					<vlayout width="100%" height="100%" spacing="0px">

						<hlayout width="100%"
							sclass="outward-cheque-data-entry-card-header">

							<label value="SCANNED CHEQUE IMAGE"
								sclass="outward-cheque-data-entry-card-title" />

						</hlayout>

						<div id="outwardChequeDataEntryImageContainer"
							hflex="1" vflex="1"
							sclass="outward-cheque-data-entry-image-container">

							<image id="outwardChequeDataEntryImage"
								src="" sclass="outward-cheque-data-entry-image" visible="false" />

							<label id="outwardChequeDataEntryLblNoImage"
								value="Cheque image not available"
								sclass="outward-cheque-data-entry-no-image" />

						</div>

						<hlayout width="100%" spacing="8px"
							sclass="outward-cheque-data-entry-image-controls">

							<button
								id="outwardChequeDataEntryBtnZoomOut" label="−"
								sclass="outward-cheque-data-entry-image-icon-button" />

							<button id="outwardChequeDataEntryBtnZoomIn"
								label="+" sclass="outward-cheque-data-entry-image-icon-button" />

							<button id="outwardChequeDataEntryBtnRotate"
								label="↻" sclass="outward-cheque-data-entry-image-icon-button" />

							<button id="outwardChequeDataEntryBtnFit"
								label="FIT" sclass="outward-cheque-data-entry-image-fit-button" />

							<button id="outwardChequeDataEntryBtnFront"
								label="FRONT"
								sclass="outward-cheque-data-entry-image-side-button active" />

							<button
								id="outwardChequeDataEntryBtnBackImage" label="BACK"
								sclass="outward-cheque-data-entry-image-side-button" />

						</hlayout>

					</vlayout>

				</div>

				<div hflex="45"
					sclass="outward-cheque-data-entry-details-card">

					<vlayout width="100%" spacing="0px">

						<hlayout width="100%"
							sclass="outward-cheque-data-entry-card-header">

							<label value="CHEQUE DETAILS"
								sclass="outward-cheque-data-entry-card-title" />

						</hlayout>

						<vlayout width="100%" spacing="14px"
							sclass="outward-cheque-data-entry-form">

							<hlayout width="100%" spacing="12px">

								<vlayout hflex="1" spacing="5px">

									<label value="CHEQUE NUMBER"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtChequeNumber" width="100%"
										sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout hflex="1" spacing="5px">

									<label value="CHEQUE AMOUNT"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtAmount" width="100%"
										sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

							</hlayout>

							<hlayout width="100%" spacing="12px">

								<vlayout hflex="1" spacing="5px">

									<label value="CHEQUE DATE"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtChequeDate" width="100%"
										sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

								<vlayout hflex="1" spacing="5px">

									<label value="MICR CODE"
										sclass="outward-cheque-data-entry-field-label" />

									<textbox
										id="outwardChequeDataEntryTxtMicrCode" width="100%"
										sclass="outward-cheque-data-entry-textbox" />

								</vlayout>

							</hlayout>

							<vlayout width="100%" spacing="5px">

								<label value="PAYEE ACCOUNT NUMBER"
									sclass="outward-cheque-data-entry-field-label" />

								<textbox
									id="outwardChequeDataEntryTxtPayeeAccount" width="100%"
									sclass="outward-cheque-data-entry-textbox" />

							</vlayout>

							<vlayout width="100%" spacing="5px">

								<label value="PAYEE NAME"
									sclass="outward-cheque-data-entry-field-label" />

								<textbox
									id="outwardChequeDataEntryTxtPayeeName" width="100%"
									sclass="outward-cheque-data-entry-textbox" />

							</vlayout>

							<vlayout width="100%" spacing="5px">

								<label value="DRAWEE NAME"
									sclass="outward-cheque-data-entry-field-label" />

								<textbox
									id="outwardChequeDataEntryTxtDraweeName" width="100%"
									sclass="outward-cheque-data-entry-textbox" />

							</vlayout>

							<hlayout width="100%" spacing="10px"
								sclass="outward-cheque-data-entry-validation-area">

								<button
									id="outwardChequeDataEntryBtnValidateAccount"
									label="VALIDATE ACCOUNT"
									sclass="outward-cheque-data-entry-secondary-button" />

								<label
									id="outwardChequeDataEntryLblValidationStatus" value=""
									sclass="outward-cheque-data-entry-validation-status" />

							</hlayout>

							<hlayout width="100%" spacing="10px"
								sclass="outward-cheque-data-entry-action-area">

								<button
									id="outwardChequeDataEntryBtnReject" label="REJECT REQUEST"
									sclass="outward-cheque-data-entry-reject-button" />

								<button
									id="outwardChequeDataEntryBtnSaveNext" label="SAVE &amp; NEXT"
									sclass="outward-cheque-data-entry-save-button" />

								<button
									id="outwardChequeDataEntryBtnSubmit"
									label="SUBMIT BATCH TO CHECKER"
									sclass="outward-cheque-data-entry-submit-button"
									visible="false" />

							</hlayout>

						</vlayout>

					</vlayout>

				</div>

			</hlayout>

			<label id="outwardChequeDataEntryLblAccountValidation"
				value="" visible="false" />

			<window id="outwardChequeDataEntryRejectWindow"
				title="REJECT REQUEST" border="normal" width="480px"
				closable="false" visible="false" mode="modal">

				<vlayout width="100%" spacing="15px"
					sclass="outward-cheque-data-entry-reject-modal">

					<vlayout width="100%" spacing="5px">

						<label value="REASON"
							sclass="outward-cheque-data-entry-field-label" />

						<combobox
							id="outwardChequeDataEntryCmbRejectReason" width="100%"
							placeholder="Select reason">

							<comboitem label="CHEQUE DETAILS INCORRECT" />

							<comboitem label="CHEQUE IMAGE NOT CLEAR" />

							<comboitem label="CHEQUE IMAGE MISSING" />

							<comboitem label="OTHER" />

						</combobox>

					</vlayout>

					<vlayout width="100%" spacing="5px">

						<label value="REMARKS"
							sclass="outward-cheque-data-entry-field-label" />

						<textbox
							id="outwardChequeDataEntryTxtRejectRemarks" width="100%" rows="4"
							multiline="true" sclass="outward-cheque-data-entry-textbox" />

					</vlayout>

					<hlayout width="100%" spacing="10px">

						<button
							id="outwardChequeDataEntryBtnCancelReject" label="CANCEL"
							sclass="outward-cheque-data-entry-secondary-button" />

						<button
							id="outwardChequeDataEntryBtnConfirmReject"
							label="CONFIRM REJECTION"
							sclass="outward-cheque-data-entry-reject-button" />

					</hlayout>

				</vlayout>

			</window>

		</vlayout>

	</window>

</zk>