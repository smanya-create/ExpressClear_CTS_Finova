<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Cheque Data Entry" contentType="text/html;charset=UTF-8"?>
<zk xmlns:h="xhtml">
	
<style src="/css/outward/cheque-data-entry.css" />
	<div id="outwardChequeDataEntryWin" sclass="cts-data-entry-wrapper"
		apply="com.iispl.cts.controller.outward.maker.OutwardChequeDataEntryController">

		<!-- Top Header Section -->
		<div sclass="cts-title-group">
			<div sclass="header-title-group">
				<label value="Cheque Data Entry"
					sclass="cts-main-title" />
				<label
					value="Enter and verify outward cheque details for processing."
					sclass="cts-main-subtitle" />
			</div>

			<button id="outwardChequeDataEntryBtnBack" label="Back"
				iconSclass="z-icon-arrow-left" sclass="cts-btn-top-back" />
		</div>

		<!-- Metadata Card with 4-Column Grid -->
		<div sclass="cts-metadata-card">
			<!-- Col 1: Batch ID -->
			<div sclass="cts-meta-col">
				<label value="Batch ID" sclass="cts-meta-header" />
				<label id="outwardChequeDataEntryLblBatchId" value="-"
					sclass="cts-meta-val cts-meta-val-batch" />
			</div>

			<!-- Col 2: Total Cheques -->
			<div sclass="cts-meta-col">
				<label value="Total Cheques" sclass="cts-meta-header" />
				<label id="outwardChequeDataEntryLblTotal" value="0"
					sclass="cts-meta-val" />
			</div>

			<!-- Col 3: Progress Bar -->
			<div sclass="cts-meta-col cts-progress-meta-col">
				<label value="Progress" sclass="cts-meta-header" />
				<hlayout spacing="8px" valign="middle">
					<progressmeter id="outwardChequeDataEntryProgress"
						value="0" sclass="cts-compact-progress" />
					<label id="outwardChequeDataEntryLblRecord"
						value="0/0" sclass="cts-data-entry-progress-text" />
				</hlayout>
			</div>

			<!-- Col 4: Top Pagination Controls -->
			<div sclass="cts-meta-col cts-navigation-meta-col">
				<hlayout spacing="6px" valign="middle">
					<button id="outwardChequeDataEntryBtnTopPrevious"
						label="Previous" iconSclass="z-icon-chevron-left"
						sclass="cts-btn-secondary cts-data-entry-btn-nav" />
					<label id="outwardChequeDataEntryLblTopRecord"
						value="1 of 1" sclass="cts-data-entry-nav-counter" />
					<button id="outwardChequeDataEntryBtnTopNext"
						label="Next" iconSclass="z-icon-chevron-right" dir="reverse"
						sclass="cts-btn-secondary cts-data-entry-btn-nav" />
				</hlayout>
			</div>
		</div>

		<!-- 2-Column Main Workspace Grid -->
		<div sclass="cts-data-entry-grid">

			<!-- Left Card: Cheque Viewer -->
			<div sclass="cts-work-card">
				<div
					style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
					<label value="Cheque Image"
						sclass="cts-card-title-main" />
					<button id="outwardChequeDataEntryBtnImageToggle"
						label="Back View" iconSclass="z-icon-exchange"
						sclass="cts-btn-secondary" />
				</div>

				<div sclass="cts-cheque-image-wrapper">
					<image id="outwardChequeDataEntryChequeImage"
						sclass="cts-cheque-img-display" />
					<label id="outwardChequeDataEntryLblImageEmpty"
						visible="false" style="color: #94a3b8; font-size: 11px;" />
				</div>

				<!-- Image Controls Toolbar -->
				<hlayout spacing="8px" width="100%" valign="middle"
					style="margin-top: 10px;">
					<button id="outwardChequeDataEntryBtnZoomOut"
						iconSclass="z-icon-minus" sclass="cts-btn-img-tool"
						tooltiptext="Zoom Out" />
					<button id="outwardChequeDataEntryBtnZoomIn"
						iconSclass="z-icon-plus" sclass="cts-btn-img-tool"
						tooltiptext="Zoom In" />
					<button id="outwardChequeDataEntryBtnRotate"
						label="Rotate" iconSclass="z-icon-repeat"
						sclass="cts-btn-img-action" />
					<button id="outwardChequeDataEntryBtnReset"
						label="Reset" iconSclass="z-icon-undo"
						sclass="cts-btn-img-action" />
				</hlayout>
			</div>

			<!-- Right Card: Form Fields -->
			<div sclass="cts-work-card">
				<!-- Title Row with Peach Status Pill -->
				<div
					style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
					<label value="Cheque Information"
						sclass="cts-card-title-main" />
					<label id="outwardChequeDataEntryLblChequeStatus"
						value="Pending" sclass="cts-status-pill-peach" />
				</div>
				<label
					value="Enter the cheque details required for verification"
					sclass="cts-card-subtitle-main" />

				<!-- ONE SINGLE DYNAMIC ALERT BOX (Exact Inward Pattern - Completely Prevents Ghost Outlines) -->
				<div id="dataEntryAlertBox" visible="false"
					sclass="cts-alert-box-single">
					<label id="lblDataEntryAlertTitle"
						sclass="cts-alert-title" />
					<label id="lblDataEntryAlertMessage"
						sclass="cts-alert-msg" />
				</div>
				<label id="outwardChequeDataEntryLblValidationStatus"
					visible="false"
					style="color: #dc2626; font-size: 10px; margin-bottom: 4px; display: block;" />

				<!-- Row 1: Cheque Number & Cheque Date -->
				<div sclass="cts-form-row">
					<div sclass="cts-form-field">
						<label value="Cheque No."
							sclass="cts-field-lbl" />
						<textbox
							id="outwardChequeDataEntryTxtChequeNumber" maxlength="6"
							sclass="cts-input-text" />
					</div>
					<div sclass="cts-form-field">
						<label value="Cheque Date (DD-MM-YYYY)"
							sclass="cts-field-lbl" />
						<datebox id="outwardChequeDataEntryDtChequeDate"
							sclass="cts-input-datebox" />
					</div>
				</div>

				<!-- Row 2: Cheque Amount & MICR Code -->
				<div sclass="cts-form-row">
					<div sclass="cts-form-field">
						<label value="Cheque Amount"
							sclass="cts-field-lbl" />
						<textbox id="outwardChequeDataEntryTxtAmount"
							sclass="cts-input-text" />
					</div>
					<div sclass="cts-form-field">
						<label value="MICR Code" sclass="cts-field-lbl" />
						<textbox id="outwardChequeDataEntryTxtMicrCode"
							readonly="true" sclass="cts-input-text cts-input-readonly" />
					</div>
				</div>

				<!-- Row 3: Payee Account No. & Payee Name -->
				<div sclass="cts-form-row">
					<div sclass="cts-form-field">
						<label value="Payee Account No."
							sclass="cts-field-lbl" />
						<textbox
							id="outwardChequeDataEntryTxtPayeeAccount"
							sclass="cts-input-text" />
					</div>
					<div sclass="cts-form-field">
						<label value="Payee Name"
							sclass="cts-field-lbl" />
						<textbox id="outwardChequeDataEntryTxtPayeeName"
							sclass="cts-input-text" />
					</div>
				</div>

				<!-- Row 4: Drawee Bank Name -->
				<div sclass="cts-form-row">
					<div sclass="cts-form-field" style="flex: 2;">
						<label value="Drawee Bank Name"
							sclass="cts-field-lbl" />
						<textbox
							id="outwardChequeDataEntryTxtDraweeName" sclass="cts-input-text" />
					</div>
				</div>

				<!-- Action Buttons Row -->
				<div sclass="cts-form-action-area">
					<hlayout width="100%" spacing="10px"
						valign="middle">
						<button id="outwardChequeDataEntryBtnResetItem"
							label="Revert Item" iconSclass="z-icon-undo"
							sclass="cts-btn-secondary" hflex="1" />
						<button id="outwardChequeDataEntryBtnReject"
							label="Request Rejection" iconSclass="z-icon-times-circle"
							sclass="cts-btn-outline-danger" hflex="1.3" />
						<button id="outwardChequeDataEntryBtnApprove"
							label="Approve Cheque" iconSclass="z-icon-check"
							sclass="cts-btn-solid-primary" hflex="1.3" />
					</hlayout>

					<button id="outwardChequeDataEntryBtnSubmit"
						label="Submit Batch to Checker" iconSclass="z-icon-paper-plane"
						sclass="cts-btn-submit-batch" width="100%" disabled="true" />
				</div>
			</div>

		</div>

		<!-- Rejection Reason Modal Window -->
		<window id="outwardChequeDataEntryRejectModal"
			title="Request Instrument Rejection" border="normal" width="440px"
			visible="false" closable="true" sclass="modal-window">
			<div sclass="modal-content">
				<div sclass="modal-field">
					<label value="Rejection Reason / Return Code *"
						sclass="cts-field-lbl" />
					<combobox id="outwardChequeDataEntryCmbRejectReason"
						readonly="true" width="100%" sclass="modal-select" />
				</div>
				<div sclass="modal-field">
					<label value="Remarks" sclass="cts-field-lbl" />
					<textbox id="outwardChequeDataEntryTxtRejectRemarks"
						rows="3" multiline="true" width="100%" sclass="modal-textarea" />
				</div>
				<div sclass="modal-actions">
					<button id="outwardChequeDataEntryBtnCancelReject"
						label="Cancel" sclass="btn-modal-cancel" />
					<button id="outwardChequeDataEntryBtnConfirmReject"
						label="Confirm Rejection" sclass="btn-modal-confirm-red" />
				</div>
			</div>
		</window>

		<!-- Submit Confirm Modal Window -->
		<window id="outwardChequeDataEntrySubmitConfirmModal"
			title="Submit Batch to Checker" border="normal" width="440px"
			visible="false" closable="true" sclass="modal-window">
			<div sclass="modal-content">
				<label
					value="All cheques in this batch are resolved. Moving this batch will forward it to the Checker verification queue."
					style="font-size: 11.5px; color: #64748b; line-height: 1.4;" />
				<div sclass="confirm-summary-box">
					<div sclass="summary-row">
						<label value="Batch ID:" sclass="summary-lbl" />
						<label
							id="outwardChequeDataEntryLblConfirmBatchId" value="-"
							sclass="summary-val" />
					</div>
					<div sclass="summary-row">
						<label value="Completed Cheques:"
							sclass="summary-lbl" />
						<label
							id="outwardChequeDataEntryLblConfirmTotal" value="0 / 0"
							sclass="summary-val" />
					</div>
				</div>
				<div sclass="modal-actions">
					<button id="outwardChequeDataEntryBtnCancelSubmit"
						label="Stay in Data Entry" sclass="btn-modal-cancel" />
					<button id="outwardChequeDataEntryBtnConfirmSubmit"
						label="Submit to Checker" sclass="btn-modal-confirm-navy" />
				</div>
			</div>
		</window>

		<!-- MICR Pending Modal Window -->
		<window id="outwardChequeDataEntryMicrPendingModal"
			title="Cannot Submit Batch" border="normal" width="420px"
			visible="false" closable="true" sclass="modal-window">
			<div sclass="modal-content">
				<label
					id="outwardChequeDataEntryLblMicrPendingSubmitMessage"
					value="Batch cannot be submitted yet."
					style="font-size: 11.5px; color: #0f172a;" />
				<div sclass="modal-actions">
					<button
						id="outwardChequeDataEntryBtnCloseMicrPending" label="Close"
						sclass="btn-modal-confirm-navy" />
				</div>
			</div>
		</window>

		<!-- Submit Success Modal Window -->
		<window id="outwardChequeDataEntrySubmitSuccessModal"
			title="Batch Submitted" border="normal" width="420px" visible="false"
			closable="false" sclass="modal-window">
			<div sclass="modal-content">
				<label id="outwardChequeDataEntryLblSubmitSuccess"
					value="Batch submitted successfully."
					style="font-weight: 600; font-size: 13px; color: #16a34a;" />
				<label
					id="outwardChequeDataEntryLblSubmitSuccessDetails" value=""
					style="font-size: 11px; color: #64748b;" />
				<div sclass="modal-actions"
					style="justify-content: center;">
					<button id="outwardChequeDataEntryBtnGoToDataEntry"
						label="Back to Data Entry" sclass="btn-modal-confirm-navy" />
				</div>
			</div>
		</window>

	</div>
</zk>