<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Cheque Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/outward/cheque-data-entry.css" />

	<window id="outwardMakerRootWin" border="none" width="100%"
		height="100%"
		style="margin:0 !important; padding:0 !important; position:absolute; top:0; left:0; right:0; bottom:0; overflow:hidden;">

		<borderlayout hflex="1" vflex="1"
			style="margin:0 !important; padding:0 !important; background:transparent;">

			<west size="220px" border="none"
				style="margin:0 !important; padding:0 !important; background-color:#0b1d3a !important;">

				<include id="sidebarInclude"
					src="/components/sidebar.zul" role="OUTWARD_MAKER"
					activeTab="outward-data-entry" hflex="1" vflex="1" />

			</west>

			<center id="outwardMakerCenter" border="none"
				autoscroll="false"
				style="margin:0 !important; padding:0 !important; overflow:hidden;">

				<borderlayout hflex="1" vflex="1"
					style="margin:0 !important; padding:0 !important; overflow:hidden;">

					<north id="outwardMakerHeaderArea" size="84px"
						border="none"
						style="margin:0 !important; padding:0 !important; overflow:hidden;">

						<include id="headerInclude"
							src="/components/header.zul" pageTitle="Data Entry"
							pageSubtitle="Outward Processing" hflex="1" vflex="1" />

					</north>

					<center id="outwardMakerContentArea" border="none"
						autoscroll="true"
						style="margin:0 !important; padding:0 !important; overflow:auto;">

						<window id="outwardChequeDataEntryWin"
							border="none" width="100%"
							apply="com.iispl.cts.controller.outward.maker.OutwardChequeDataEntryController">

							<div id="outwardChequeDataEntryPage"
								sclass="outward-cheque-data-entry-page" width="100%">

								<div id="outwardChequeDataEntryTopBar"
									sclass="outward-cheque-data-entry-top-bar" width="100%">

									<button
										id="outwardChequeDataEntryBtnBack"
										label="BACK TO DATA ENTRY LIST"
										sclass="outward-cheque-data-entry-back-button" />

								</div>

								<div id="outwardChequeDataEntryHeader"
									sclass="outward-cheque-data-entry-header" width="100%">

									<div
										id="outwardChequeDataEntryTitleSection"
										sclass="outward-cheque-data-entry-title-section">

										<label
											id="outwardChequeDataEntryLblTitle" value="CHEQUE DATA ENTRY"
											sclass="outward-cheque-data-entry-title" />

										<label
											id="outwardChequeDataEntryLblSubtitle"
											value="Review and correct cheque details against the scanned image"
											sclass="outward-cheque-data-entry-subtitle" />

									</div>

									<div
										id="outwardChequeDataEntryRecordSection"
										sclass="outward-cheque-data-entry-record-section">

										<label
											id="outwardChequeDataEntryLblRecord" value="CHEQUE 1"
											sclass="outward-cheque-data-entry-record-label" />

									</div>

								</div>

								<div id="outwardChequeDataEntrySummary"
									sclass="outward-cheque-data-entry-summary" width="100%">

									<div
										id="outwardChequeDataEntrySummaryBatch"
										sclass="outward-cheque-data-entry-summary-item">

										<label value="BATCH NO"
											sclass="outward-cheque-data-entry-summary-label" />

										<label
											id="outwardChequeDataEntryLblBatchId" value="-"
											sclass="outward-cheque-data-entry-summary-value" />

									</div>

									<div
										id="outwardChequeDataEntrySummaryCheque"
										sclass="outward-cheque-data-entry-summary-item">

										<label value="CHEQUE NUMBER"
											sclass="outward-cheque-data-entry-summary-label" />

										<label
											id="outwardChequeDataEntryLblSummaryChequeNumber" value="-"
											sclass="outward-cheque-data-entry-summary-value" />

									</div>

									<div
										id="outwardChequeDataEntrySummaryTotal"
										sclass="outward-cheque-data-entry-summary-item">

										<label value="TOTAL CHEQUES"
											sclass="outward-cheque-data-entry-summary-label" />

										<label
											id="outwardChequeDataEntryLblTotal" value="0"
											sclass="outward-cheque-data-entry-summary-value" />

									</div>

									<div
										id="outwardChequeDataEntrySummaryRemaining"
										sclass="outward-cheque-data-entry-summary-item">

										<label value="REMAINING CHEQUES"
											sclass="outward-cheque-data-entry-summary-label" />

										<label
											id="outwardChequeDataEntryLblRemaining" value="0"
											sclass="outward-cheque-data-entry-summary-value" />

									</div>

								</div>

								<div id="outwardChequeDataEntryMainArea"
									sclass="outward-cheque-data-entry-main-area" width="100%">

									<div
										id="outwardChequeDataEntryImageCard"
										sclass="outward-cheque-data-entry-card outward-cheque-data-entry-image-card"
										width="50%">

										<div
											id="outwardChequeDataEntryImageHeader"
											sclass="outward-cheque-data-entry-card-header">

											<label value="CHEQUE IMAGE"
												sclass="outward-cheque-data-entry-card-title" />

											<button
												id="outwardChequeDataEntryBtnImageToggle" label="BACK VIEW"
												sclass="outward-cheque-data-entry-image-toggle-button" />

										</div>

										<div
											id="outwardChequeDataEntryImageContainer"
											sclass="outward-cheque-data-entry-image-container"
											width="100%">

											<image
												id="outwardChequeDataEntryChequeImage"
												sclass="outward-cheque-data-entry-cheque-image" width="100%"
												height="100%" visible="true" />

											<label
												id="outwardChequeDataEntryLblImageMessage"
												value="CHEQUE IMAGE NOT AVAILABLE"
												sclass="outward-cheque-data-entry-image-message"
												visible="false" />

										</div>

										<div
											id="outwardChequeDataEntryImageControls"
											sclass="outward-cheque-data-entry-image-controls">

											<button
												id="outwardChequeDataEntryBtnZoomOut" label="-"
												sclass="outward-cheque-data-entry-image-control-button" />

											<button
												id="outwardChequeDataEntryBtnZoomIn" label="+"
												sclass="outward-cheque-data-entry-image-control-button" />

											<button
												id="outwardChequeDataEntryBtnRotate" label="ROTATE"
												sclass="outward-cheque-data-entry-image-control-button outward-cheque-data-entry-image-control-wide" />

											<button
												id="outwardChequeDataEntryBtnFit" label="FIT"
												sclass="outward-cheque-data-entry-image-control-button outward-cheque-data-entry-image-control-wide" />

										</div>

									</div>

									<div
										id="outwardChequeDataEntryDetailsCard"
										sclass="outward-cheque-data-entry-card outward-cheque-data-entry-details-card"
										width="50%">

										<div
											id="outwardChequeDataEntryDetailsHeader"
											sclass="outward-cheque-data-entry-card-header">

											<label
												value="CHEQUE DETAILS"
												sclass="outward-cheque-data-entry-card-title" />

										</div>

										<div
											id="outwardChequeDataEntryFields"
											sclass="outward-cheque-data-entry-fields" width="100%">

											<div
												id="outwardChequeDataEntryChequeNumberField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="CHEQUE NUMBER"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtChequeNumber"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="20" />

											</div>

											<div
												id="outwardChequeDataEntryAmountField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="CHEQUE AMOUNT"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtAmount"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="20" />

											</div>

											<div
												id="outwardChequeDataEntryDateField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="CHEQUE DATE"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtChequeDate"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="10" placeholder="DD-MM-YYYY" />

											</div>

											<div
												id="outwardChequeDataEntryMicrField"
												sclass="outward-cheque-data-entry-field">

												<label value="MICR CODE"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtMicrCode"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="20" />

											</div>

											<div
												id="outwardChequeDataEntryPayeeAccountField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="PAYEE ACCOUNT NUMBER"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtPayeeAccount"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="30" />

											</div>

											<div
												id="outwardChequeDataEntryPayeeNameField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="PAYEE NAME"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtPayeeName"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="150" />

											</div>

											<div
												id="outwardChequeDataEntryDraweeNameField"
												sclass="outward-cheque-data-entry-field">

												<label
													value="DRAWE NAME"
													sclass="outward-cheque-data-entry-field-label" />

												<textbox
													id="outwardChequeDataEntryTxtDraweeName"
													sclass="outward-cheque-data-entry-textbox" width="100%"
													maxlength="150" />

											</div>

										</div>

										<div
											id="outwardChequeDataEntryStatusArea"
											sclass="outward-cheque-data-entry-status-area"
											width="100%">

											<label
												id="outwardChequeDataEntryLblValidationStatus" value=""
												sclass="outward-cheque-data-entry-status-label"
												visible="false" />

										</div>

										<div
											id="outwardChequeDataEntryActions"
											sclass="outward-cheque-data-entry-actions" width="100%">

											<button
												id="outwardChequeDataEntryBtnReject"
												label="REJECTION REQUEST"
												sclass="outward-cheque-data-entry-reject-button" />

											<button
												id="outwardChequeDataEntryBtnSaveNext"
												label="SAVE &amp; NEXT"
												sclass="outward-cheque-data-entry-save-button" />

											<button
												id="outwardChequeDataEntryBtnSubmit"
												label="SUBMIT TO CHECKER"
												sclass="outward-cheque-data-entry-submit-button"
												disabled="true" />

										</div>

									</div>

								</div>

							</div>

							<window
								id="outwardChequeDataEntryRejectWindow"
								title="REJECTION REQUEST" border="normal" mode="modal"
								closable="false" width="480px"
								sclass="outward-cheque-data-entry-reject-window">

								<div
									id="outwardChequeDataEntryRejectContent"
									sclass="outward-cheque-data-entry-reject-content"
									width="100%">

									<div
										id="outwardChequeDataEntryRejectReasonField"
										sclass="outward-cheque-data-entry-modal-field">

										<label value="REJECTED REASON"
											sclass="outward-cheque-data-entry-modal-label" />

										<combobox
											id="outwardChequeDataEntryCmbRejectReason"
											sclass="outward-cheque-data-entry-reason-combobox"
											width="100%" readonly="true" placeholder="SELECT REASON" />

									</div>

									<div
										id="outwardChequeDataEntryRejectRemarksField"
										sclass="outward-cheque-data-entry-modal-field">

										<label value="REMARKS"
											sclass="outward-cheque-data-entry-modal-label" />

										<textbox
											id="outwardChequeDataEntryTxtRejectRemarks"
											sclass="outward-cheque-data-entry-remarks-textbox"
											width="100%" rows="5" multiline="true" maxlength="500"
											placeholder="ENTER REMARKS" />

									</div>

									<div
										id="outwardChequeDataEntryRejectActions"
										sclass="outward-cheque-data-entry-modal-actions"
										width="100%">

										<button
											id="outwardChequeDataEntryBtnConfirmReject"
											label="REJECT REQUEST"
											sclass="outward-cheque-data-entry-confirm-reject-button" />

										<button
											id="outwardChequeDataEntryBtnCancelReject" label="CLOSE"
											sclass="outward-cheque-data-entry-close-button" />

									</div>

								</div>

							</window>

						</window>

					</center>

				</borderlayout>

			</center>

		</borderlayout>

	</window>

</zk>