<?xml version="1.0" encoding="UTF-8"?>


<zk xmlns="http://www.zkoss.org/2005/zul">

<html>
        <link rel="stylesheet"
              type="text/css"
              href="/ExpressClear_CTS_Finova/css/cts-unprocessed.css?v=1"/>
    </html>


    <window id="winUnprocessedCheques"
            border="none"
            vflex="1"
            hflex="1"
            apply="com.iispl.cts.controller.outward.maker.MakerUnprocessedChequesController"
            style="padding: 20px 24px; background: #f8fafc;">

        <vlayout spacing="16px" vflex="1">

            <!-- Page Heading -->

            <vlayout spacing="4px">

                <hlayout valign="middle"
                         style="display: flex; justify-content: space-between; width: 100%;">

                    <vlayout spacing="2px">

                        <label value="Forced EOD Unprocessed Cheques"
                               sclass="page-heading"/>

                        <label value="Rollover instruments requiring Maker MICR Repair or Data Entry to re-enter outward clearing."
                               sclass="page-subheading"/>

                    </vlayout>

                    <button id="btnRefresh"
                            iconSclass="z-icon-refresh"
                            tooltiptext="Refresh Queue"
                            style="width: 36px; height: 36px; border-radius: 50%; padding: 0; display: inline-flex; align-items: center; justify-content: center; background: #ffffff; border: 1px solid #cbd5e1; color: #475569; font-size: 15px; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05);"/>

                </hlayout>

            </vlayout>


            <!-- Maker Summary Counter Cards -->

            <hlayout spacing="16px"
                     width="100%">

                <hlayout sclass="stat-card"
                         hflex="1"
                         valign="middle"
                         style="justify-content: space-between;">

                    <vlayout spacing="2px">

                        <label value="TOTAL MAKER PENDING"
                               sclass="stat-card-title text-muted"/>

                        <label id="lblTotalCount"
                               value="0"
                               sclass="stat-card-value text-dark"/>

                    </vlayout>

                    <label sclass="z-icon-history icon-gray"/>

                </hlayout>


                <hlayout sclass="stat-card"
                         hflex="1"
                         valign="middle"
                         style="justify-content: space-between;">

                    <vlayout spacing="2px">

                        <label value="MICR REPAIR PENDING"
                               sclass="stat-card-title text-orange"/>

                        <label id="lblRepairCount"
                               value="0"
                               sclass="stat-card-value text-orange"/>

                    </vlayout>

                    <label sclass="z-icon-wrench icon-orange"/>

                </hlayout>


                <hlayout sclass="stat-card"
                         hflex="1"
                         valign="middle"
                         style="justify-content: space-between;">

                    <vlayout spacing="2px">

                        <label value="DATA ENTRY PENDING"
                               sclass="stat-card-title text-purple"/>

                        <label id="lblDataEntryCount"
                               value="0"
                               sclass="stat-card-value text-purple"/>

                    </vlayout>

                    <label sclass="z-icon-edit icon-purple"/>

                </hlayout>

            </hlayout>


            <!-- Filter Controls -->

            <hlayout spacing="12px"
                     valign="middle"
                     sclass="filter-bar">

                <label value="Filter By Action:"
                       sclass="filter-label"/>

                <combobox id="cmbStatusFilter"
                          readonly="true"
                          width="190px"
                          onSelect="$composer.onFilterChanged()">

                    <comboitem label="All Maker Actions"
                               value="ALL"/>

                    <comboitem label="Needs MICR Repair"
                               value="PENDING_REPAIR"/>

                    <comboitem label="Needs Data Entry"
                               value="PENDING_DATA_ENTRY"/>

                </combobox>


                <textbox id="txtSearchBatch"
                         placeholder="Search Batch / Cheque No / MICR..."
                         width="260px"
                         instant="true"
                         onChanging="$composer.onChanging$txtSearchBatch(event)"
                         onOK="$composer.onOK$txtSearchBatch(event)"/>

            </hlayout>


            <!-- Listbox -->

            <listbox id="lstUnprocessed"
                     vflex="1"
                     mold="paging"
                     pageSize="12"
                     emptyMessage="No Forced EOD rollover cheques pending for Maker processing.">

                <listhead sizable="true">

                    <listheader label="Original Batch / Session"
                                width="240px"/>

                    <listheader label="Cheque No"
                                width="120px"/>

                    <listheader label="MICR Code"
                                width="120px"/>

                    <listheader label="Amount"
                                width="140px"
                                align="right"/>

                    <listheader label="Required Task"
                                width="180px"/>

                    <listheader label="Reason / Remarks"
                                hflex="1"/>

                    <listheader label="Action"
                                width="145px"
                                align="center"/>

                </listhead>

            </listbox>

        </vlayout>

    </window>

</zk>