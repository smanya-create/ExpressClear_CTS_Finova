<?xml version="1.0" encoding="UTF-8"?>

<zk>

	<style src="/css/outward/maker-dashboard.css" />

	<div id="outwardMakerDivDashboard" width="100%" height="100%"
		apply="com.iispl.cts.controller.outward.maker.OutwardMakerDashboardController"
		sclass="outward-maker-dashboard">

		<div sclass="outward-maker-welcome-section">

			<label value="Welcome, Maker"
				sclass="outward-maker-welcome-title" />

			<label value="Manage and process outward cheque batches."
				sclass="outward-maker-welcome-subtitle" />

		</div>

		<div sclass="outward-maker-section-header">

			<div>

				<label value="Processing Batches"
					sclass="outward-maker-section-title" />

				<label
					value="Batches currently available for outward processing."
					sclass="outward-maker-section-subtitle" />

			</div>

		</div>

		<div sclass="outward-maker-table-card">

			<grid id="outwardMakerGridBatchDetails" width="100%"
				sclass="outward-maker-batch-grid">

				<columns sizable="true">

					<column label="Batch ID" width="24%" />

					<column label="No. of Cheques" width="18%" />

					<column label="Total Amount" width="22%" />

					<column label="Status" width="17%" />

					<column label="Action" width="19%" />

				</columns>

				<rows id="outwardMakerRowsBatchDetails" />

			</grid>

			<vlayout id="outwardMakerVlayoutEmptyState" visible="false"
				sclass="outward-maker-empty-state">

				<label value="No processing batches found"
					sclass="outward-maker-empty-title" />

				<label
					value="There are currently no batches available for outward processing."
					sclass="outward-maker-empty-subtitle" />

			</vlayout>

		</div>

		<div sclass="outward-maker-pagination">

			<button id="outwardMakerBtnFirst" label="&lt;&lt;"
				sclass="outward-maker-pagination-button" />

			<button id="outwardMakerBtnPrevious" label="&lt;"
				sclass="outward-maker-pagination-button" />

			<label id="outwardMakerLblCurrentPage" value="1 / 1"
				sclass="outward-maker-pagination-label" />

			<button id="outwardMakerBtnNext" label="&gt;"
				sclass="outward-maker-pagination-button" />

			<button id="outwardMakerBtnLast" label="&gt;&gt;"
				sclass="outward-maker-pagination-button" />

		</div>

	</div>

</zk>