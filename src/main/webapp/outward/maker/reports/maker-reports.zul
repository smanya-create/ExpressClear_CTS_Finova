<?xml version="1.0" encoding="UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/css/admin/role-management.css"?>

<zk>

   
    <style src="/css/outward/maker-report.css"/>

    <vlayout
        apply="com.iispl.cts.controller.outward.maker.MakerReportController"
        spacing="20px"
        style="padding:24px;"
        hflex="1"
        vflex="1"
        sclass="role-content">

        <!-- Page Title Header -->

        <vlayout spacing="4px">

            <label value="Reports"
                   sclass="page-title" />

            

        </vlayout>


        <!-- Filter Controls Card -->

        <vlayout sclass="card-panel"
                 spacing="20px"
                 hflex="1"
                 style="padding:24px 28px;">

            <!-- Date Inputs -->

            <hlayout spacing="16px"
                     valign="bottom"
                     hflex="1">

                <vlayout spacing="6px"
                         width="220px">

                    <label value="FROM DATE"
                           sclass="field-label" />

                    <datebox id="dtFromDate"
                             format="yyyy-MM-dd"
                             height="38px"
                             width="100%" />

                </vlayout>


                <vlayout spacing="6px"
                         width="220px">

                    <label value="TO DATE"
                           sclass="field-label" />

                    <datebox id="dtToDate"
                             format="yyyy-MM-dd"
                             height="38px"
                             width="100%" />

                </vlayout>

            </hlayout>


            <separator bar="true"
                       style="border-color:#e2e8f0;
                              margin:4px 0;" />


            <!-- Report Details Description Section -->

    


            <!-- Export Buttons -->

            <hlayout spacing="12px"
                     hflex="1"
                     style="justify-content:flex-start;
                            margin-top:12px;">

                <button id="btnExportCsv"
                        label="Download CSV"
                        height="38px"
                        sclass="btn-primary" />

                <button id="btnExportPdf"
                        label="Download PDF"
                        height="38px"
                        sclass="btn-outline"
                        />

            </hlayout>

        </vlayout>

    </vlayout>

</zk>