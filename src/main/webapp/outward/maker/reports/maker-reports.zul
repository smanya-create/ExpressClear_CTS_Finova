<?xml version="1.0" encoding="UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/maker/maker-report.css"?>
<zk>
<borderlayout apply="com.iispl.cts.controller.outward.maker.MakerReportController" hflex="1" vflex="1">

    <!-- Shared Left Sidebar Navigation -->
    <west width="240px" border="none" collapsible="false">
        <include src="/components/sidebar.zul" role="MAKER" activeTab="reports" />
    </west>

    <!-- Main Workspace -->
    <center border="none" autoscroll="true" style="background-color: #f8fafc;">
        <vlayout spacing="0" hflex="1">

            <!-- Shared Header -->
            <include id="incHeader" src="/components/header.zul" 
                     pageTitle="Maker Dashboard" 
                     pageSubtitle="Operations &amp; Audit Reports" />

            <!-- Content Area Container -->
            <vlayout spacing="20px" style="padding: 24px;" hflex="1">
                
                <!-- Page Title Header -->
                <vlayout spacing="4px">
                    <label value="OPERATIONAL REPORTS" sclass="page-title"/>
                    <label value="Generate and download maker daily balancing, exception handling, and audit logs." sclass="page-subtitle"/>
                </vlayout>

                <!-- Report Card Panel -->
                <vlayout sclass="card-panel" spacing="24px" hflex="1">
                    
                    <!-- Date Inputs (Side by Side) -->
                    <hlayout spacing="24px" hflex="1">
                        <vlayout spacing="6px" hflex="1">
                            <label value="FROM DATE" sclass="field-label"/>
                            <datebox id="dtFromDate" format="yyyy-MM-dd" constraint="no empty: Select start date" 
                                     height="40px" width="100%" sclass="input-box"/>
                        </vlayout>

                        <vlayout spacing="6px" hflex="1">
                            <label value="TO DATE" sclass="field-label"/>
                            <datebox id="dtToDate" format="yyyy-MM-dd" constraint="no empty: Select end date" 
                                     height="40px" width="100%" sclass="input-box"/>
                        </vlayout>
                    </hlayout>

                    <separator bar="true" sclass="panel-separator"/>

                    <!-- Report Details Description Section -->
                    <vlayout spacing="8px" hflex="1">
                        <label value="REPORT DETAILS" sclass="section-subtitle"/>
                        <label value="Select a clearing date range to generate the consolidated 4-part Maker audit report covering:" 
                               sclass="section-desc"/>
                        <vlayout spacing="3px" style="padding-left: 8px;">
                            <label value="• Section 1: Batches with manual MICR repairs" sclass="section-bullet"/>
                            <label value="• Section 2: Batches pending Courtesy / Legal Amount data entry" sclass="section-bullet"/>
                            <label value="• Section 3: Cheques blocked due to scan defects or unread codelines" sclass="section-bullet"/>
                            <label value="• Section 4: Balanced batches cleared and submitted to Checker" sclass="section-bullet"/>
                        </vlayout>
                    </vlayout>

                    <!-- Action Button Area -->
                    <hlayout hflex="1" style="justify-content: flex-end; padding-top: 8px;">
                        <button id="btnGenerate" label="GENERATE REPORT" height="42px" sclass="btn-primary" iconSclass="z-icon-download"/>
                    </hlayout>

                </vlayout>

            </vlayout>

        </vlayout>
    </center>
</borderlayout>
</zk>