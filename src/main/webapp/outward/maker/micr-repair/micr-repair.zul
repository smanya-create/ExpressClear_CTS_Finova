<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/outward/micr-repair.css" />

    <window id="micrEntryWindow"
            width="100%"
            height="100%"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairController"
            sclass="micr-entry-page">

        <!-- ===================================================== -->
        <!-- PAGE HEADER                                           -->
        <!-- ===================================================== -->

        <div class="page-header-entry">

            <div class="header-left">

                <button id="btnBackToList"
                        label="← Back to List"
                        sclass="btn-back"
                        onClick="@command('backToList')" />

                <div class="batch-badge">
                    BATCH:
                    <label id="lblBatchNumber"
                           value="" />
                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- COMPLETION SUCCESS MESSAGE                            -->
        <!-- ===================================================== -->

        <div id="divCompletionMessage"
             class="completion-message"
             visible="false">

            <div class="completion-content">

                <div class="completion-icon">
                    ✓
                </div>

                <label id="lblCompletionTitle"
                       value="MICR REPAIR COMPLETED"
                       sclass="completion-title" />

                <label id="lblCompletionText"
                       value=""
                       sclass="completion-text" />

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <div id="divFormContainer"
             class="micr-entry-container">


            <!-- ================================================= -->
            <!-- LEFT SIDE : CHEQUE IMAGE                          -->
            <!-- ================================================= -->

            <div id="divChequeImageSection"
                 class="cheque-image-section">

                <label id="lblChequeImageTitle"
                       value="Cheque Image"
                       sclass="section-label" />


                <div id="divChequeImageWrapper"
                     class="cheque-image-wrapper">

                    <!-- Image is populated dynamically -->
                    <image id="imgCheque"
                           width="100%"
                           height="auto" />

                </div>


                <!-- ============================================= -->
                <!-- CHEQUE DETAILS                                -->
                <!-- ============================================= -->

                <div id="divChequeDetails"
                     class="cheque-details">


                    <!-- Bank and Branch -->
                    <div class="detail-row">

                        <label id="lblBankName"
                               value=""
                               sclass="bank-name" />

                        <label id="lblBranchName"
                               value=""
                               sclass="branch-name" />

                    </div>


                    <!-- Payee -->
                    <div class="detail-row">

                        <label id="lblPayLabel"
                               value="Pay"
                               sclass="label-key" />

                        <label id="lblPayTo"
                               value=""
                               sclass="label-value" />

                    </div>


                    <!-- Amount in words -->
                    <div class="detail-row">

                        <label id="lblAmountWords"
                               value=""
                               sclass="amount-text" />

                    </div>


                    <!-- Amount -->
                    <div class="detail-row amount-box">

                        <label id="lblAmountNumeric"
                               value=""
                               sclass="amount-numeric" />

                    </div>


                    <!-- OCR Reference -->
                    <div id="divOcrReference"
                         class="ocr-reference">

                        <label id="lblOcrReference"
                               value=""
                               sclass="ocr-text" />

                    </div>

                </div>


                <!-- Image Note -->
                <div id="divChequeNote"
                     class="cheque-note">

                    <label id="lblChequeNote"
                           value="Blue fields are OCR-filled — verify against the cheque image."
                           sclass="note-text" />

                </div>

            </div>


            <!-- ================================================= -->
            <!-- RIGHT SIDE : MICR REPAIR FORM                     -->
            <!-- ================================================= -->

            <div id="divFormSection"
                 class="form-section">


                <!-- ============================================= -->
                <!-- PROGRESS                                       -->
                <!-- ============================================= -->

                <div id="divProgressContainer"
                     class="progress-container">

                    <div id="divProgressBar"
                         class="progress-bar">

                        <div id="divProgressFill"
                             class="progress-fill"
                             style="width: 0%;" />

                    </div>

                    <label id="lblProgressText"
                           value=""
                           sclass="progress-text" />

                </div>


                <!-- ============================================= -->
                <!-- MICR ERROR BADGE                               -->
                <!-- ============================================= -->

                <div id="divMicrErrorBadge"
                     class="micr-error-badge">

                    <label id="lblMicrError"
                           value="MICR ERROR" />

                </div>


                <!-- ============================================= -->
                <!-- CHEQUE NUMBER                                 -->
                <!-- ============================================= -->

                <div id="divChequeNumberGroup"
                     class="form-group">

                    <label id="lblChequeNumber"
                           value="CHEQUE NUMBER *"
                           sclass="form-label" />

                    <textbox id="txtChequeNumber"
                             readonly="true"
                             sclass="form-input" />

                </div>


                <!-- ============================================= -->
                <!-- CITY CODE + BANK CODE                         -->
                <!-- ============================================= -->

                <div id="divCityBankRow"
                     class="form-row">


                    <!-- City Code -->
                    <div id="divCityCodeGroup"
                         class="form-group">

                        <label id="lblCityCode"
                               value="CITY CODE *"
                               sclass="form-label" />

                        <textbox id="txtCityCode"
                                 sclass="form-input" />

                    </div>


                    <!-- Bank Code -->
                    <div id="divBankCodeGroup"
                         class="form-group">

                        <label id="lblBankCode"
                               value="BANK CODE *"
                               sclass="form-label" />

                        <textbox id="txtBankCode"
                                 sclass="form-input" />

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- BRANCH CODE                                   -->
                <!-- ============================================= -->

                <div id="divBranchCodeRow"
                     class="form-row">

                    <div id="divBranchCodeGroup"
                         class="form-group">

                        <label id="lblBranchCode"
                               value="BRANCH CODE *"
                               sclass="form-label" />

                        <textbox id="txtBranchCode"
                                 sclass="form-input" />

                    </div>

                </div>


                <!-- ============================================= -->
                <!-- CURRENT MICR                                  -->
                <!-- ============================================= -->

                <div id="divCurrentMicrGroup"
                     class="form-group">

                    <label id="lblCurrentMicr"
                           value="CURRENT MICR"
                           sclass="form-label" />

                    <textbox id="txtCurrentMicr"
                             readonly="true"
                             sclass="form-input ocr-filled" />

                </div>


                <!-- ============================================= -->
                <!-- REJECTION REMARKS                             -->
                <!-- Hidden initially                              -->
                <!-- Shown only when Reject Request is clicked     -->
                <!-- ============================================= -->

                <div id="divRejectRemarks"
                     class="form-group"
                     visible="false">

                    <label id="lblRejectRemarks"
                           value="REJECTION REMARKS *"
                           sclass="form-label" />

                    <textbox id="txtRemarks"
                             placeholder="Enter reason for rejection"
                             rows="4"
                             sclass="form-textarea" />

                </div>


                <!-- ============================================= -->
                <!-- ACTION BUTTONS                                -->
                <!-- ============================================= -->

                <div id="divFormActions"
                     class="form-actions">

                    <button id="btnSaveNext"
                            label="Save and Next"
                            sclass="btn-save-next"
                            onClick="@command('saveAndNext')" />

                    <button id="btnRejectRequest"
                            label="Reject Request"
                            sclass="btn-reject"
                            onClick="@command('rejectRequest')" />

                </div>


            </div>

        </div>

    </window>

</zk>