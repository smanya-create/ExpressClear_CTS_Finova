<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward Processing" contentType="text/html;charset=UTF-8"?>

<zk>

    <style src="/css/outward/micr-repair.css"/>

    <window id="winMicrRepair"
            border="none"
            width="100%"
            height="100%"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairController"
            sclass="micr-repair-window">

        <vlayout id="divMicrRepairPage"
                 width="100%"
                 height="100%"
                 spacing="10px"
                 sclass="micr-repair-page">

            <!-- =====================================================
                 TOP HEADER
                 ===================================================== -->

            <hlayout id="divMicrRepairHeader"
                     width="100%"
                     valign="middle"
                     spacing="10px"
                     sclass="micr-repair-header">

                <vlayout hflex="1"
                         spacing="2px">

                    <label id="lblMicrRepairTitle"
                           value="MICR Repair"
                           sclass="micr-repair-title"/>

                    <label id="lblMicrRepairDescription"
                           value="Review and correct MICR details against the cheque image."
                           sclass="micr-repair-description"/>

                </vlayout>


                <!-- Progress is above the Prev / Next navigation -->

                <vlayout id="divHeaderProgress"
                         width="210px"
                         spacing="2px"
                         sclass="header-progress">

                    <hlayout width="100%"
                             spacing="4px"
                             valign="middle">

                        <label id="lblProgressTitle"
                               value="PROGRESS"
                               hflex="1"
                               sclass="progress-title"/>

                        <label id="lblProgressText"
                               value="Record 0 of 0"
                               width="90px"
                               sclass="progress-text"/>

                    </hlayout>

                    <progressmeter id="prgMicrRepair"
                                   value="0"
                                   width="100%"
                                   height="6px"
                                   sclass="micr-progress-meter"/>

                </vlayout>


                <!-- Previous / position / next -->

                <hlayout id="divChequeNavigation"
                         spacing="6px"
                         valign="middle"
                         sclass="cheque-navigation">

                    <button id="btnPrevious"
                            label="Prev"
                            iconSclass="z-icon-chevron-left"
                            width="70px"
                            height="26px"
                            disabled="true"
                            sclass="micr-button navigation-button"/>

                    <label id="lblChequePosition"
                           value="1 of 1"
                           sclass="cheque-position"/>

                    <button id="btnNext"
                            label="Next"
                            iconSclass="z-icon-chevron-right"
                            width="70px"
                            height="26px"
                            disabled="true"
                            sclass="micr-button navigation-button"/>

                </hlayout>


                <button id="btnBackToList"
                        label="Back to List"
                        iconSclass="z-icon-arrow-left"
                        width="110px"
                        height="32px"
                        sclass="micr-button back-button"/>

            </hlayout>


            <!-- =====================================================
                 BATCH METADATA CARD
                 ===================================================== -->

            <div id="divBatchInformation"
                 width="100%"
                 sclass="batch-information">

                <hlayout id="divBatchInformationLayout"
                         width="100%"
                         spacing="18px"
                         valign="middle"
                         sclass="batch-information-layout">

                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblBatchIdTitle"
                               value="BATCH ID"
                               sclass="batch-label-title"/>

                        <label id="lblBatchId"
                               value="-"
                               sclass="batch-label-value"/>

                    </vlayout>

                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblMicrRepairCountTitle"
                               value="MICR REPAIR REQUIRED"
                               sclass="batch-label-title"/>

                        <label id="lblMicrRepairCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>

                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblCompletedCountTitle"
                               value="COMPLETED"
                               sclass="batch-label-title"/>

                        <label id="lblCompletedCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>

                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblRemainingCountTitle"
                               value="REMAINING"
                               sclass="batch-label-title"/>

                        <label id="lblRemainingCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>

                </hlayout>

            </div>


            <!-- =====================================================
                 TWO-COLUMN WORKSPACE
                 Both cards have the same fixed height.
                 Only MICR DATA ENTRY content scrolls.
                 ===================================================== -->

            <hlayout id="divMicrRepairContent"
                     hflex="1"
                     spacing="14px"
                     valign="top"
                     sclass="micr-repair-content">

                <!-- =================================================
                     LEFT CARD - CHEQUE IMAGE
                     ================================================= -->

                <div id="divChequeImageSection"
                     hflex="55"
                     height="100%"
                     sclass="cheque-image-section">

                    <vlayout id="divChequeImageContent"
                             width="100%"
                             height="100%"
                             spacing="7px"
                             sclass="cheque-image-content">

                        <hlayout id="divChequeImageHeader"
                                 width="100%"
                                 valign="top"
                                 spacing="5px"
                                 sclass="section-header">

                            <vlayout hflex="1"
                                     spacing="1px">

                                <label id="lblChequeImageTitle"
                                       value="CHEQUE IMAGE"
                                       sclass="section-title"/>

                      

                            </vlayout>

                            <button id="btnImagePrevious"
                                    label="Front"
                                    iconSclass="z-icon-file-image-o"
                                    width="68px"
                                    height="26px"
                                    sclass="image-side-button"/>

                            <button id="btnImageNext"
                                    label="Back"
                                    iconSclass="z-icon-file-image-o"
                                    width="68px"
                                    height="26px"
                                    sclass="image-side-button"/>

                            

                            <label id="lblImagePosition"
                                   value="1 of 2"
                                   visible="false"
                                   width="1px"/>

                        </hlayout>


                        <div id="divChequeImageContainer"
                             hflex="1"
                             sclass="cheque-image-container"
                             onMouseDown="onMouseDown$divChequeImageContainer"
                             onMouseMove="onMouseMove$divChequeImageContainer"
                             onMouseUp="onMouseUp$divChequeImageContainer">

                            <image id="imgCheque"
                                   visible="false"
                                   width="100%"
                                   height="100%"
                                   sclass="cheque-image"/>

                            <label id="lblChequeImagePlaceholder"
                                   value="Cheque image not available"
                                   sclass="cheque-image-placeholder"/>

                        </div>


                        <hlayout id="divImageControls"
                                 width="100%"
                                 spacing="6px"
                                 valign="middle"
                                 sclass="image-controls">

                            <button id="btnZoomOut"
                                    iconSclass="z-icon-minus"
                                    width="32px"
                                    height="28px"
                                    tooltiptext="Zoom Out"
                                    sclass="image-control-button compact-image-button"/>

                            <button id="btnZoom"
                                    iconSclass="z-icon-plus"
                                    width="32px"
                                    height="28px"
                                    tooltiptext="Zoom In"
                                    sclass="image-control-button compact-image-button"/>

                            <button id="btnZoomReset"
                                    label="Reset View"
                                    iconSclass="z-icon-arrows-alt"
                                    hflex="1"
                                    height="28px"
                                    sclass="image-control-button"/>

                            <button id="btnRotate"
                                    label="Rotate"
                                    iconSclass="z-icon-repeat"
                                    hflex="1"
                                    height="28px"
                                    sclass="image-control-button"/>

                        </hlayout>


                        <button id="btnImageToggle"
                                visible="false"
                                label="View Back"
                                width="1px"
                                height="1px"/>

                    </vlayout>

                </div>


                <!-- =================================================
                     RIGHT CARD - MICR DATA ENTRY
                     The inner content is independently scrollable.
                     ================================================= -->

                <div id="divMicrDetailsSection"
                     hflex="45"
                     height="100%"
                     sclass="micr-details-section">

                    <div id="divMicrDetailsScroll"
                         width="100%"
                         height="100%"
                         sclass="micr-details-scroll">

                        <vlayout id="divMicrDetailsContent"
                                 width="100%"
                                 spacing="7px"
                                 sclass="micr-details-content">

                            <hlayout id="divMicrDetailsHeader"
                                     width="100%"
                                     valign="top"
                                     spacing="5px"
                                     sclass="section-header">

                                <vlayout hflex="1"
                                         spacing="1px">

                                    <label id="lblMicrDetailsTitle"
                                           value="MICR DATA ENTRY"
                                           sclass="section-title"/>

                                    <label value="Review and correct MICR codeline fields."
                                           sclass="section-subtitle"/>

                                </vlayout>

                                <label id="lblChequeStatus"
                                       value="PENDING_MICR_REPAIR"
                                       sclass="cheque-status"/>

                            </hlayout>


                            <!-- CHECKER RETURN INFORMATION -->

                            <div id="divCheckerReturnInformation"
                                 width="100%"
                                 visible="false"
                                 sclass="checker-return-information">

                                <vlayout id="divCheckerReturnContent"
                                         width="100%"
                                         spacing="3px">

                                    <label id="lblCheckerReturnTitle"
                                           value="MESSAGE"
                                           sclass="checker-return-title"/>

                                    <hlayout width="100%"
                                             spacing="8px"
                                             valign="top">

                                        <label id="lblCheckerReasonIdTitle"
                                               value="Reason ID"
                                               width="82px"
                                               sclass="checker-label-title"/>

                                        <label id="lblCheckerReasonId"
                                               value=""
                                               hflex="1"
                                               sclass="checker-label-value"/>

                                    </hlayout>

                                    <hlayout width="100%"
                                             spacing="8px"
                                             valign="top">

                                        <label id="lblCheckerReasonTitle"
                                               value="Reason"
                                               width="82px"
                                               sclass="checker-label-title"/>

                                        <label id="lblCheckerReason"
                                               value=""
                                               hflex="1"
                                               multiline="true"
                                               sclass="checker-label-value"/>

                                    </hlayout>

                                    <hlayout width="100%"
                                             spacing="8px"
                                             valign="top">

                                        <label id="lblCheckerRemarksTitle"
                                               value="Remarks"
                                               width="82px"
                                               sclass="checker-label-title"/>

                                        <label id="lblCheckerRemarks"
                                               value=""
                                               hflex="1"
                                               multiline="true"
                                               sclass="checker-label-value"/>

                                    </hlayout>

                                </vlayout>

                            </div>


                            <!-- MICR FORM -->

                            <div sclass="cts-form-row">

                                <div sclass="cts-form-field">

                                    <label value="Cheque Number *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtChequeNumber"
                                             width="100%"
                                             readonly="true"
                                             sclass="cts-input-text readonly-field"/>

                                </div>

                                <div sclass="cts-form-field">

                                    <label value="City Code *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtCityCode"
                                             width="100%"
                                             maxlength="3"
                                             sclass="cts-input-text"
                                             onChange="onChange$txtCityCode"/>

                                </div>

                            </div>


                            <div sclass="cts-form-row">

                                <div sclass="cts-form-field">

                                    <label value="Bank Code *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtBankCode"
                                             width="100%"
                                             maxlength="3"
                                             sclass="cts-input-text"
                                             onChange="onChange$txtBankCode"/>

                                </div>

                                <div sclass="cts-form-field">

                                    <label value="Branch Code *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtBranchCode"
                                             width="100%"
                                             maxlength="3"
                                             sclass="cts-input-text"
                                             onChange="onChange$txtBranchCode"/>

                                </div>

                            </div>


                            <div sclass="cts-form-row">

                                <div sclass="cts-form-field">

                                    <label value="Current MICR *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtCurrentMicr"
                                             width="100%"
                                             readonly="true"
                                             sclass="cts-input-text error-field"/>

                                </div>

                                <div sclass="cts-form-field">

                                    <label value="Corrected MICR Code *"
                                           sclass="cts-field-lbl"/>

                                    <textbox id="txtCorrectedMicr"
                                             width="100%"
                                             maxlength="9"
                                             placeholder="Enter 9-character corrected MICR code"
                                             sclass="cts-input-text correction-field micr-code-field"
                                             onChange="onChange$txtCorrectedMicr"/>

                                </div>

                            </div>


                            <label id="lblMicrValidationMessage"
                                   value=""
                                   visible="false"
                                   multiline="true"
                                   sclass="micr-validation-message"/>


                            <!-- ACTION BUTTONS -->

                            <hlayout id="divMicrActionButtons"
                                     width="100%"
                                     spacing="8px"
                                     valign="middle"
                                     sclass="micr-action-buttons">

                                <button id="btnRejectRequest"
                                        label="Request Rejection"
                                        iconSclass="z-icon-times-circle"
                                        hflex="1"
                                        height="32px"
                                        sclass="micr-action-button reject-button"/>

                                <button id="btnSaveNext"
                                        label="Save &amp; Next"
                                        iconSclass="z-icon-check"
                                        hflex="1"
                                        height="32px"
                                        sclass="micr-action-button save-button"/>

                                <button id="btnSubmit"
                                        label="Submit"
                                        iconSclass="z-icon-check"
                                        hflex="1"
                                        height="32px"
                                        disabled="true"
                                        sclass="micr-action-button submit-button"/>

                            </hlayout>

                        </vlayout>

                    </div>

                </div>

            </hlayout>


            <!-- =====================================================
                 FOOTER
                 ===================================================== -->

            <hlayout id="divMicrRepairFooter"
                     width="100%"
                     height="28px"
                     valign="middle"
                     spacing="5px"
                     sclass="micr-repair-footer">

                <label id="lblFooterText"
                       value="CTS MICR Repair"
                       hflex="1"
                       sclass="footer-text"/>

                <label id="lblFooterVersion"
                       value="v1.0"
                       width="60px"
                       sclass="footer-version"/>

            </hlayout>


            <!-- =====================================================
                 REQUEST INSTRUMENT REJECTION POPUP
                 ===================================================== -->

            <window id="winRejectRequest"
                    title="Request Instrument Rejection"
                    width="500px"
                    mode="modal"
                    visible="false"
                    closable="true"
                    sizable="false"
                    sclass="reject-request-window">

                <vlayout id="divRejectRequestPopup"
                         width="100%"
                         spacing="12px">

                    <label id="lblRejectRequestMessage"
                           value="Please specify the CTS return reason and any remarks for the checker:"
                           multiline="true"
                           sclass="reject-request-description"/>

                    <vlayout width="100%" spacing="4px">

                        <label id="lblRejectReasonTitle"
                               value="Rejection Reason / Return Code *"
                               sclass="reject-field-label"/>

                        <combobox id="cmbRejectReason"
                                  width="100%"
                                  readonly="true"
                                  autodrop="true"
                                  placeholder="Select rejected reason"
                                  sclass="reject-reason-combobox"/>

                    </vlayout>

                    <vlayout width="100%" spacing="4px">

                        <label id="lblRejectRemarksTitle"
                               value="Rejection Remark"
                               sclass="reject-field-label"/>

                        <textbox id="txtRejectRemarks"
                                 width="100%"
                                 height="80px"
                                 multiline="true"
                                 placeholder="Enter remarks"
                                 sclass="reject-remarks"/>

                    </vlayout>

                    <hlayout id="divRejectRequestButtons"
                             width="100%"
                             spacing="8px"
                             valign="middle">

                        <label hflex="1" value=""/>

                        <button id="btnCancelReject"
                                label="Cancel"
                                width="90px"
                                sclass="reject-cancel-button"/>

                        <button id="btnProceedReject"
                                label="Proceed"
                                iconSclass="z-icon-check"
                                width="100px"
                                sclass="reject-confirm-button"/>

                    </hlayout>

                </vlayout>

            </window>


            <!-- SAVE CONFIRMATION POPUP -->

            <window id="winConfirmSave"
                    title="Confirm Save Changes"
                    width="420px"
                    closable="true"
                    sizable="false"
                    mode="modal"
                    visible="false"
                    sclass="micr-popup">

                <vlayout id="divConfirmSavePopup"
                         width="100%"
                         spacing="12px">

                    <label id="lblConfirmSaveMessage"
                           value="Are you sure you want to save the MICR changes?"
                           multiline="true"/>

                    <hlayout id="divConfirmSaveButtons"
                             width="100%"
                             spacing="8px"
                             valign="middle">

                        <label hflex="1" value=""/>

                        <button id="btnCancelSave"
                                label="Cancel"
                                width="90px"/>

                        <button id="btnConfirmSave"
                                label="Save"
                                iconSclass="z-icon-check"
                                width="90px"/>

                    </hlayout>

                </vlayout>

            </window>


            <!-- INFORMATION POPUP -->

            <window id="winMicrInformation"
                    title="MICR Repair"
                    width="400px"
                    closable="true"
                    sizable="false"
                    mode="modal"
                    visible="false"
                    sclass="micr-popup">

                <vlayout id="divMicrInformationPopup"
                         width="100%"
                         spacing="12px">

                    <label id="lblMicrInformationMessage"
                           value=""
                           multiline="true"/>

                    <hlayout id="divMicrInformationButton"
                             width="100%"
                             valign="middle">

                        <label hflex="1" value=""/>

                        <button id="btnCloseMicrInformation"
                                label="OK"
                                width="80px"/>

                    </hlayout>

                </vlayout>

            </window>

        </vlayout>

    </window>

</zk>