<?xml version="1.0" encoding="UTF-8"?>
<zk>

	<style src="/css/outward/micr-repair.css" />
    <window id="micrEntryWindow"  
            width="100%" height="100%" sclass="micr-entry-page">
        
        <!-- Page Header -->
        <div class="page-header-entry">
            <div class="header-left">
                <button label="← Back to List" sclass="btn-back" 
                        onClick="@command('backToList')" />
                <div class="batch-badge">BATCH: B004</div>
            </div>
        </div>

        <!-- Completion Success Message (Hidden initially) -->
        <div id="completionMessage" class="completion-message" style="display:none;">
            <div class="completion-content">
                <div class="completion-icon">✓</div>
                <label value="MICR REPAIR COMPLETED" sclass="completion-title" />
                <label value="Both MICR-error cheques have been repaired. Batch B004 is ready for Data Entry." 
                       sclass="completion-text" />
            </div>
        </div>

        <!-- Main Content Container -->
        <div id="formContainer" class="micr-entry-container">
            
            <!-- Left Side: Cheque Image -->
            <div class="cheque-image-section">
                <label value="Cheque Image" sclass="section-label" />
                
                <div class="cheque-image-wrapper">
                    <image id="chequeImage" src="/images/cheque-sample.png" width="100%" height="auto" />
                </div>
                
                <div class="cheque-details">
                    <div class="detail-row">
                        <label id="bankName" value="HDFC Bank Ltd" sclass="bank-name" />
                        <label id="branchName" value="Main Branch" sclass="branch-name" />
                    </div>
                    
                    <div class="detail-row">
                        <label value="Pay" sclass="label-key" />
                        <label id="payTo" value="CBS Bank Limited" sclass="label-value" />
                    </div>
                    
                    <div class="detail-row">
                        <label id="amountWords" value="Twelve Thousand Five Hundred Only" sclass="amount-text" />
                    </div>
                    
                    <div class="detail-row amount-box">
                        <label id="amountNumeric" value="₹ 12,500.00" sclass="amount-numeric" />
                    </div>
                    
                    <div class="ocr-reference">
                        <label id="ocrReference" value=":100041: 600987001 :29:" sclass="ocr-text" />
                    </div>
                </div>
                
                <div class="cheque-note">
                    <label value="Blue fields are OCR-filled — verify against the cheque image." sclass="note-text" />
                </div>
            </div>

            <!-- Right Side: MICR Data Entry Form -->
            <div class="form-section">
                
                <!-- Progress Indicator -->
                <div class="progress-container">
                    <div class="progress-bar">
                        <div id="progressFill" class="progress-fill" style="width: 50%;"></div>
                    </div>
                    <label id="progressText" value="Record 1 of 2" sclass="progress-text" />
                </div>

                <!-- MICR Error Badge -->
                <div class="micr-error-badge">
                    <label value="MICR ERROR" />
                </div>

                <!-- Form Fields -->
                <div class="form-group">
                    <label value="CHEQUE NUMBER *" sclass="form-label" />
                    <textbox id="chequeNumber" value="100041" readonly="true" sclass="form-input" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label value="CITY CODE *" sclass="form-label" />
                        <textbox id="cityCode" value="600" sclass="form-input" />
                    </div>
                    <div class="form-group">
                        <label value="BANK CODE *" sclass="form-label" />
                        <textbox id="bankCode" value="987" sclass="form-input" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label value="BRANCH CODE *" sclass="form-label" />
                        <textbox id="branchCode" value="001" sclass="form-input" />
                    </div>
                    <div class="form-group">
                        <label value="TRANSACTION CODE *" sclass="form-label" />
                        <textbox id="transactionCode" value="29" sclass="form-input" />
                    </div>
                </div>

                <div class="form-group">
                    <label value="CURRENT MICR REPAIR *" sclass="form-label" />
                    <textbox id="currentMicr" value="600987001" readonly="true" 
                             sclass="form-input ocr-filled" />
                </div>

                <div class="form-group">
                    <label value="CORRECTED MICR CODE *" sclass="form-label" />
                    <textbox id="correctedMicr" placeholder="Enter corrected MICR code" 
                             sclass="form-input" />
                </div>

                <div class="form-group">
                    <label value="REMARKS" sclass="form-label" />
                    <textbox id="remarks" placeholder="Optional remarks" rows="4" 
                             sclass="form-textarea" />
                </div>

                <!-- Action Buttons -->
                <div class="form-actions">
                    <button id="saveNextBtn" label="Save and Next" sclass="btn-save-next" 
                            onClick="@command('saveAndNext')" />
                    <button id="rejectBtn" label="Reject Request" sclass="btn-reject" 
                            onClick="@command('rejectRequest')" />
                </div>
            </div>
        </div>

        <!-- Move to Data Entry Button (Visible after completion) -->
        <div id="moveDataEntryButtonContainer" class="move-data-entry-container" style="display:none;">
            <button id="moveDataEntryBtn" label="MOVE BATCH TO DATA ENTRY" sclass="btn-move-data-entry" 
                    onClick="@command('moveToDataEntry')" />
        </div>
    </window>
</zk>