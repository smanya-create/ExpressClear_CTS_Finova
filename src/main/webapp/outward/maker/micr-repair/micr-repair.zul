<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - MICR Repair" contentType="text/html;charset=UTF-8"?>

<zk>

    <style src="/css/outward/micr-repair.css"/>

    <window id="micrEntryWindow"
            border="none"
            width="100%"
            height="100%"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairController"
            style="margin:0 !important; padding:0 !important;">

        <vlayout width="100%"
                 height="100%"
                 spacing="0"
                 sclass="outward-cheque-data-entry-page">

            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->

            <hlayout width="100%"
                     valign="middle"
                     sclass="micr-page-header">

                <vlayout hflex="1"
                         spacing="3px">

                    <label value="MICR REPAIR"
                           sclass="outward-cheque-data-entry-title" />

                    <label value="Review and correct MICR details against the cheque image."
                           sclass="outward-cheque-data-entry-subtitle" />

                </vlayout>

                <button id="btnBackToList"
                        label="Back to List"
                        sclass="outward-cheque-back-button" />

            </hlayout>


            <!-- =====================================================
                 BATCH SUMMARY
                 ===================================================== -->

            <div width="100%"
                 sclass="outward-cheque-batch-summary">

                <hlayout width="100%"
                         valign="middle"
                         spacing="0">

                    <vlayout hflex="1"
                             spacing="3px">

                        <label value="BATCH"
                               sclass="outward-cheque-summary-label" />

                        <label id="lblBatchNumber"
                               value="-"
                               sclass="outward-cheque-summary-value" />

                    </vlayout>


                    <vlayout width="220px"
                             spacing="3px">

                        <label value="MICR REPAIR REQUIRED"
                               sclass="outward-cheque-summary-label" />

                        <label id="lblMicrRepairRequired"
                               value="0"
                               sclass="outward-cheque-summary-value" />

                    </vlayout>


                    <vlayout width="150px"
                             spacing="3px">

                        <label value="COMPLETED"
                               sclass="outward-cheque-summary-label" />

                        <label id="lblCompletedCheques"
                               value="0"
                               sclass="outward-cheque-summary-value" />

                    </vlayout>


                    <vlayout width="150px"
                             spacing="3px">

                        <label value="REMAINING"
                               sclass="outward-cheque-summary-label" />

                        <label id="lblRemainingCheques"
                               value="0"
                               sclass="outward-cheque-summary-value" />

                    </vlayout>

                </hlayout>

            </div>


            <!-- =====================================================
                 MAIN CONTENT
                 LEFT = 55%
                 RIGHT = 45%
                 ===================================================== -->

            <hlayout width="100%"
                     spacing="14px"
                     valign="top"
                     sclass="outward-cheque-content-layout">


                <!-- =================================================
                     LEFT SIDE - CHEQUE IMAGE
                     ================================================= -->

                <div id="micrRepairImageCard"
                     hflex="55"
                     sclass="outward-cheque-image-card">

                    <vlayout width="100%"
                             height="100%"
                             spacing="10px">


                        <!-- TITLE -->

                        <hlayout width="100%"
                                 valign="middle">

                            <label value="CHEQUE IMAGE"
                                   hflex="1"
                                   sclass="outward-cheque-card-title" />

                            <label id="lblRecordPosition"
                                   value="Record 0 of 0"
                                   sclass="outward-cheque-record-label" />

                        </hlayout>


                        <!-- IMAGE VIEWER -->

                        <div id="micrRepairImageContainer"
                             width="100%"
                             height="400px"
                             sclass="outward-cheque-image-container">

                            <image id="imgCheque"
                                   visible="false"
                                   sclass="outward-cheque-image" />

                            <label id="lblChequeImageTitle"
                                   value="Cheque Front Image"
                                   sclass="outward-cheque-image-placeholder" />

                        </div>


                        <!-- =================================================
                             FIVE IMAGE BUTTONS
                             ================================================= -->

                        <hlayout id="micrRepairImageButtons"
                                 width="100%"
                                 spacing="8px"
                                 valign="middle"
                                 sclass="outward-cheque-image-buttons">

                            <button id="btnZoom"
                                    label="Zoom In"
                                    hflex="1"
                                    sclass="outward-cheque-image-control zoom-button" />

                            <button id="btnZoomOut"
                                    label="Zoom Out"
                                    hflex="1"
                                    sclass="outward-cheque-image-control zoom-button" />

                            <button id="btnZoomReset"
                                    label="Reset"
                                    hflex="1"
                                    sclass="outward-cheque-image-control reset-button" />

                            <button id="btnRotate"
                                    label="Rotate"
                                    hflex="1"
                                    sclass="outward-cheque-image-control zoom-button" />

                            <button id="btnImageToggle"
                                    label="View Back"
                                    hflex="1"
                                    sclass="outward-cheque-image-control zoom-button" />

                        </hlayout>


                        <!-- =================================================
                             PREVIOUS / 1 OF N / NEXT
                             ================================================= -->

                        <hlayout width="100%"
                                 spacing="8px"
                                 valign="middle"
                                 sclass="outward-cheque-image-navigation">

                            <button id="btnPrevious"
                                    label="Previous"
                                    hflex="1"
                                    sclass="outward-cheque-navigation-button" />

                            <label id="lblChequeNavigation"
                                   value=""
                                   hflex="1"
                                   sclass="outward-cheque-navigation-label" />

                            <button id="btnNext"
                                    label="Next"
                                    hflex="1"
                                    sclass="outward-cheque-navigation-button" />

                        </hlayout>

                    </vlayout>

                </div>


                <!-- =================================================
                     RIGHT SIDE - MICR DATA ENTRY
                     ================================================= -->

                <div id="micrRepairDetailsCard"
                     hflex="45"
                     sclass="outward-cheque-details-card">

                    <vlayout width="100%"
                             height="100%"
                             spacing="10px">


                        <!-- TITLE -->

                        <hlayout width="100%"
                                 valign="middle">

                            <label value="MICR DATA ENTRY"
                                   hflex="1"
                                   sclass="outward-cheque-card-title" />

                        </hlayout>


                        <separator />


                        <!-- =================================================
                             MICR FIELDS
                             ================================================= -->

                        <grid width="100%"
                              sclass="outward-cheque-form-grid">

                            <columns>

                                <column width="50%" />
                                <column width="50%" />

                            </columns>

                            <rows>


                                <!-- CHEQUE NUMBER / CITY CODE -->

                                <row>

                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="CHEQUE NUMBER"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtChequeNumber"
                                                 width="100%"
                                                 readonly="true"
                                                 sclass="outward-cheque-readonly-field" />

                                    </vlayout>


                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="CITY CODE"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtCityCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="outward-cheque-field" />

                                    </vlayout>

                                </row>


                                <!-- BANK CODE / BRANCH CODE -->

                                <row>

                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="BANK CODE"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtBankCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="outward-cheque-field" />

                                    </vlayout>


                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="BRANCH CODE"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtBranchCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="outward-cheque-field" />

                                    </vlayout>

                                </row>


                                <!-- CURRENT / CORRECTED MICR -->

                                <row>

                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="CURRENT MICR"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtCurrentMicr"
                                                 width="100%"
                                                 readonly="true"
                                                 sclass="outward-cheque-readonly-field" />

                                    </vlayout>


                                    <vlayout width="100%"
                                             spacing="4px">

                                        <label value="CORRECTED MICR"
                                               sclass="outward-cheque-field-label" />

                                        <textbox id="txtCorrectedMicr"
                                                 width="100%"
                                                 maxlength="9"
                                                 sclass="outward-cheque-field" />

                                    </vlayout>

                                </row>

                            </rows>

                        </grid>


                        <!-- VALIDATION -->

                        <label id="lblMicrError"
                               value=""
                               visible="false"
                               sclass="outward-cheque-account-validation invalid" />


                        <!-- =================================================
                             REJECT / SAVE NEXT
                             ================================================= -->

                        <hlayout width="100%"
                                 spacing="10px"
                                 valign="middle"
                                 sclass="outward-cheque-action-buttons">

                            <button id="btnRejectRequest"
                                    label="Request Reject"
                                    hflex="1"
                                    sclass="outward-cheque-reject-button" />

                            <button id="btnSaveNext"
                                    label="Save &amp; Next"
                                    hflex="1"
                                    sclass="outward-cheque-save-button" />

                        </hlayout>


                        <!-- =================================================
                             PROGRESS
                             ================================================= -->

                        <vlayout width="100%"
                                 spacing="5px"
                                 sclass="outward-cheque-progress-section">

                            <hlayout width="100%"
                                     valign="middle">

                                <label value="PROGRESS"
                                       hflex="1"
                                       sclass="outward-cheque-field-label" />

                                <label id="lblProgressText"
                                       value="Record 0 of 0"
                                       sclass="outward-cheque-record-label" />

                            </hlayout>


                            <div width="100%"
                                 sclass="outward-cheque-progress-track">

                                <div id="divProgressFill"
                                     width="0%"
                                     sclass="outward-cheque-progress-fill" />

                            </div>

                        </vlayout>

                    </vlayout>

                </div>

            </hlayout>

        </vlayout>

    </window>

</zk>