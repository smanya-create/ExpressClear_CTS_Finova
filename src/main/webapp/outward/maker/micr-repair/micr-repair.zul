<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - MICR Repair" contentType="text/html;charset=UTF-8"?>

<zk>

    <!-- =========================================================
         MICR REPAIR CSS
         ========================================================= -->
    <style src="/outward/maker/micr-repair/micr-repair.css"/>


    <!-- =========================================================
         MAIN WINDOW
         ========================================================= -->
    <window id="winMicrRepair"
            border="none"
            width="100%"
            height="100%"
            
            sclass="micr-repair-window"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairController">


        <!-- =====================================================
             PAGE
             ===================================================== -->
        <vlayout id="divMicrRepairPage"
                 width="100%"
                 height="100%"
                 spacing="8px"
                 sclass="micr-repair-page">


            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->
            <hlayout id="divMicrRepairHeader"
                     width="100%"
                     height="52px"
                     valign="middle"
                     spacing="10px"
                     sclass="micr-repair-header">

                <!-- TITLE AREA -->
                <vlayout hflex="1"
                         spacing="2px"
                         sclass="micr-repair-title-area">

                    <label id="lblMicrRepairTitle"
                           value="MICR REPAIR"
                           sclass="micr-repair-title"/>

                    <label id="lblMicrRepairDescription"
                           value="Review and correct MICR details against the cheque image."
                           sclass="micr-repair-description"/>

                </vlayout>


                <!-- CHEQUE NAVIGATION -->
                <hlayout id="divChequeNavigation"
                         valign="middle"
                         spacing="8px"
                         sclass="cheque-navigation">

                    <button id="btnPrevious"
                            label="Previous"
                            width="90px"
                            height="32px"
                            disabled="true"
                            sclass="micr-button"/>

                    <label id="lblChequePosition"
                           value="0 of 0"
                           width="70px"
                           sclass="cheque-position"/>

                    <button id="btnNext"
                            label="Next"
                            width="90px"
                            height="32px"
                            disabled="true"
                            sclass="micr-button"/>

                </hlayout>


                <!-- BACK TO LIST -->
                <button id="btnBackToList"
                        label="Back to List"
                        width="100px"
                        height="32px"
                        sclass="micr-button back-button"/>

            </hlayout>



            <!-- =====================================================
                 BATCH INFORMATION
                 ===================================================== -->
            <div id="divBatchInformation"
                 width="100%"
                 height="58px"
                 sclass="batch-information">

                <hlayout width="100%"
                         height="100%"
                         valign="middle"
                         spacing="20px"
                         sclass="batch-information-layout">


                    <!-- BATCH ID -->
                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblBatchIdTitle"
                               value="BATCH ID"
                               sclass="batch-label-title"/>

                        <label id="lblBatchId"
                               value="-"
                               sclass="batch-label-value"/>

                    </vlayout>


                    <!-- MICR REPAIR REQUIRED -->
                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblMicrRepairCountTitle"
                               value="MICR REPAIR REQUIRED"
                               sclass="batch-label-title"/>

                        <label id="lblMicrRepairCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>


                    <!-- COMPLETED -->
                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblCompletedCountTitle"
                               value="COMPLETED"
                               sclass="batch-label-title"/>

                        <label id="lblCompletedCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>


                    <!-- REMAINING -->
                    <vlayout hflex="1"
                             spacing="2px"
                             sclass="batch-information-item">

                        <label id="lblRemainingCountTitle"
                               value="REMAINING"
                               sclass="batch-label-title"/>

                        <label id="lblRemainingCount"
                               value="0"
                               sclass="batch-label-value"/>

                    </vlayout>

                </hlayout>

            </div>



            <!-- =====================================================
                 MAIN CONTENT
                 LEFT  = CHEQUE IMAGE
                 RIGHT = MICR DETAILS
                 ===================================================== -->
            <hlayout id="divMicrRepairContent"
                     width="100%"
                     height="470px"
                     spacing="10px"
                     valign="top"
                     sclass="micr-repair-content">


                <!-- =================================================
                     LEFT SIDE - CHEQUE IMAGE
                     ================================================= -->
                <div id="divChequeImageSection"
                     hflex="55"
                     height="470px"
                     sclass="cheque-image-section">

                    <vlayout id="divChequeImageContent"
                             width="100%"
                             height="470px"
                             spacing="6px"
                             sclass="cheque-image-content">


                        <!-- IMAGE HEADER -->
                        <hlayout id="divChequeImageHeader"
                                 width="100%"
                                 height="34px"
                                 valign="middle"
                                 spacing="5px"
                                 sclass="section-header">

                            <label id="lblChequeImageTitle"
                                   value="CHEQUE IMAGE"
                                   hflex="1"
                                   sclass="section-title"/>

                            <label id="lblImageRecordPosition"
                                   value="Record 0 of 0"
                                   width="100px"
                                   sclass="record-position"/>

                        </hlayout>



                        <!-- =================================================
                             IMAGE CONTAINER
                             ================================================= -->
                        <div id="divChequeImageContainer"
                             width="100%"
                             height="350px"
                             sclass="cheque-image-container">

                            <image id="imgCheque"
                                   visible="false"
                                   width="100%"
                                   height="100%"
                                   sclass="cheque-image"/>

                            <label id="lblChequeImagePlaceholder"
                                   value="Cheque image not available"
                                   sclass="cheque-image-placeholder"/>

                        </div>



                        <!-- =================================================
                             IMAGE CONTROLS
                             ================================================= -->
                        <hlayout id="divImageControls"
                                 width="100%"
                                 height="32px"
                                 spacing="6px"
                                 valign="middle"
                                 sclass="image-controls">

                            <button id="btnZoom"
                                    label="Zoom In"
                                    hflex="1"
                                    height="32px"
                                    sclass="image-control-button"/>

                            <button id="btnZoomOut"
                                    label="Zoom Out"
                                    hflex="1"
                                    height="32px"
                                    sclass="image-control-button"/>

                            <button id="btnZoomReset"
                                    label="Reset"
                                    hflex="1"
                                    height="32px"
                                    sclass="image-control-button"/>

                            <button id="btnRotate"
                                    label="Rotate"
                                    hflex="1"
                                    height="32px"
                                    sclass="image-control-button"/>

                            <button id="btnImageToggle"
                                    label="View Back"
                                    hflex="1"
                                    height="32px"
                                    sclass="image-control-button"/>

                        </hlayout>



                        <!-- =================================================
                             IMAGE NAVIGATION
                             ================================================= -->
                        <hlayout id="divImageNavigation"
                                 width="100%"
                                 height="32px"
                                 spacing="6px"
                                 valign="middle"
                                 sclass="image-navigation">

                            <button id="btnImagePrevious"
                                    label="Previous"
                                    hflex="1"
                                    height="32px"
                                    disabled="true"
                                    sclass="image-control-button"/>

                            <label id="lblImagePosition"
                                   value="0 of 0"
                                   hflex="1"
                                   sclass="image-position"/>

                            <button id="btnImageNext"
                                    label="Next"
                                    hflex="1"
                                    height="32px"
                                    disabled="true"
                                    sclass="image-control-button"/>

                        </hlayout>

                    </vlayout>

                </div>



                <!-- =================================================
                     RIGHT SIDE - MICR DETAILS
                     ================================================= -->
                <div id="divMicrDetailsSection"
                     hflex="45"
                     height="470px"
                     sclass="micr-details-section">

                    <vlayout id="divMicrDetailsContent"
                             width="100%"
                             height="470px"
                             spacing="6px"
                             sclass="micr-details-content">


                        <!-- =================================================
                             MICR DETAILS HEADER
                             ================================================= -->
                        <hlayout id="divMicrDetailsHeader"
                                 width="100%"
                                 height="34px"
                                 valign="middle"
                                 spacing="5px"
                                 sclass="section-header">

                            <label id="lblMicrDetailsTitle"
                                   value="MICR DETAILS"
                                   hflex="1"
                                   sclass="section-title"/>

                            <label id="lblChequeStatus"
                                   value="PENDING_MICR_REPAIR"
                                   width="150px"
                                   sclass="cheque-status"/>

                        </hlayout>



                        <!-- =================================================
                             CHECKER RETURN / REJECTION INFORMATION
                             ================================================= -->
                        <div id="divCheckerReturnInformation"
                             width="100%"
                             visible="false"
                             sclass="checker-return-information">

                            <vlayout id="divCheckerReturnContent"
                                     width="100%"
                                     spacing="3px">

                                <label id="lblCheckerReturnTitle"
                                       value="CHECKER RETURN / REJECTION REQUEST"
                                       sclass="checker-return-title"/>


                                <!-- REASON ID -->
                                <hlayout width="100%"
                                         spacing="8px"
                                         valign="top">

                                    <label id="lblCheckerReasonIdTitle"
                                           value="Reason ID"
                                           width="90px"
                                           sclass="checker-label-title"/>

                                    <label id="lblCheckerReasonId"
                                           value=""
                                           hflex="1"
                                           sclass="checker-label-value"/>

                                </hlayout>


                                <!-- REASON -->
                                <hlayout width="100%"
                                         spacing="8px"
                                         valign="top">

                                    <label id="lblCheckerReasonTitle"
                                           value="Reason"
                                           width="90px"
                                           sclass="checker-label-title"/>

                                    <label id="lblCheckerReason"
                                           value=""
                                           hflex="1"
                                           multiline="true"
                                           sclass="checker-label-value"/>

                                </hlayout>


                                <!-- REMARKS -->
                                <hlayout width="100%"
                                         spacing="8px"
                                         valign="top">

                                    <label id="lblCheckerRemarksTitle"
                                           value="Remarks"
                                           width="90px"
                                           sclass="checker-label-title"/>

                                    <label id="lblCheckerRemarks"
                                           value=""
                                           hflex="1"
                                           multiline="true"
                                           sclass="checker-label-value"/>

                                </hlayout>

                            </vlayout>

                        </div>



                        <!-- =================================================
                             MICR FORM
                             ================================================= -->
                        <grid id="grdMicrDetails"
                              width="100%"
                              sclass="micr-details-grid">

                            <columns>

                                <column width="50%"/>

                                <column width="50%"/>

                            </columns>


                            <rows>


                                <!-- =================================================
                                     CHEQUE NUMBER / CITY CODE
                                     ================================================= -->
                                <row>

                                    <!-- CHEQUE NUMBER -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblChequeNumberTitle"
                                               value="CHEQUE NUMBER"
                                               sclass="field-label"/>

                                        <textbox id="txtChequeNumber"
                                                 width="100%"
                                                 readonly="true"
                                                 sclass="micr-textbox readonly-field"/>

                                    </vlayout>


                                    <!-- CITY CODE -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblCityCodeTitle"
                                               value="CITY CODE"
                                               sclass="field-label"/>

                                        <textbox id="txtCityCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="micr-textbox"/>

                                    </vlayout>

                                </row>



                                <!-- =================================================
                                     BANK CODE / BRANCH CODE
                                     ================================================= -->
                                <row>

                                    <!-- BANK CODE -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblBankCodeTitle"
                                               value="BANK CODE"
                                               sclass="field-label"/>

                                        <textbox id="txtBankCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="micr-textbox"/>

                                    </vlayout>


                                    <!-- BRANCH CODE -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblBranchCodeTitle"
                                               value="BRANCH CODE"
                                               sclass="field-label"/>

                                        <textbox id="txtBranchCode"
                                                 width="100%"
                                                 maxlength="3"
                                                 sclass="micr-textbox"/>

                                    </vlayout>

                                </row>



                                <!-- =================================================
                                     CURRENT MICR / CORRECTED MICR
                                     ================================================= -->
                                <row>

                                    <!-- CURRENT MICR -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblCurrentMicrTitle"
                                               value="CURRENT MICR"
                                               sclass="field-label"/>

                                        <textbox id="txtCurrentMicr"
                                                 width="100%"
                                                 readonly="true"
                                                 sclass="micr-textbox readonly-field"/>

                                    </vlayout>


                                    <!-- CORRECTED MICR -->
                                    <vlayout width="100%"
                                             spacing="3px"
                                             sclass="micr-field">

                                        <label id="lblCorrectedMicrTitle"
                                               value="CORRECTED MICR"
                                               sclass="field-label"/>

                                        <textbox id="txtCorrectedMicr"
                                                 width="100%"
                                                 maxlength="9"
                                                 sclass="micr-textbox corrected-micr-field"/>

                                    </vlayout>

                                </row>

                            </rows>

                        </grid>



                        <!-- =================================================
                             VALIDATION MESSAGE
                             ================================================= -->
                        <label id="lblMicrValidationMessage"
                               value=""
                               visible="false"
                               multiline="true"
                               sclass="micr-validation-message"/>



                        <!-- =================================================
                             ACTION BUTTONS
                             ================================================= -->
                        <hlayout id="divMicrActionButtons"
                                 width="100%"
                                 height="36px"
                                 spacing="8px"
                                 valign="middle"
                                 sclass="micr-action-buttons">

                            <button id="btnRejectRequest"
                                    label="Request Reject"
                                    hflex="1"
                                    height="36px"
                                    sclass="micr-action-button reject-button"/>

                            <button id="btnSaveNext"
                                    label="Save &amp; Next"
                                    hflex="1"
                                    height="36px"
                                    sclass="micr-action-button save-button"/>

                            <button id="btnSubmit"
                                    label="Submit"
                                    hflex="1"
                                    height="36px"
                                    disabled="true"
                                    sclass="micr-action-button submit-button"/>

                        </hlayout>



                        <!-- =================================================
                             PROGRESS
                             ================================================= -->
                        <vlayout id="divMicrProgress"
                                 width="100%"
                                 spacing="3px"
                                 sclass="micr-progress">

                            <hlayout width="100%"
                                     spacing="5px"
                                     valign="middle">

                                <label id="lblProgressTitle"
                                       value="PROGRESS"
                                       hflex="1"
                                       sclass="progress-title"/>

                                <label id="lblProgressText"
                                       value="Record 0 of 0"
                                       width="100px"
                                       sclass="progress-text"/>

                            </hlayout>


                            <progressmeter id="prgMicrRepair"
                                           value="0"
                                           width="100%"
                                           sclass="micr-progress-meter"/>

                        </vlayout>

                    </vlayout>

                </div>

            </hlayout>



            <!-- =====================================================
                 FOOTER
                 ===================================================== -->
            <hlayout id="divMicrRepairFooter"
                     width="100%"
                     height="28px"
                     valign="middle"
                     spacing="5px"
                     sclass="micr-repair-footer">

                <label id="lblFooterText"
                       value="CTS MICR Repair"
                       hflex="1"
                       sclass="footer-text"/>

                <label id="lblFooterVersion"
                       value="v1.0"
                       width="60px"
                       sclass="footer-version"/>

            </hlayout>



            <!-- =====================================================
                 REJECT REQUEST POPUP
                 ===================================================== -->
            <window id="winRejectRequest"
                    title="Reject Request"
                    width="500px"
                    closable="true"
                    sizable="false"
                    mode="modal"
                    visible="false"
                    sclass="micr-popup">

                <vlayout id="divRejectRequestPopup"
                         width="100%"
                         spacing="10px">


                    <label id="lblRejectRequestMessage"
                           value="Select the rejection reason and enter remarks."
                           multiline="true"/>


                    <!-- REJECTED REASON -->
                    <vlayout width="100%"
                             spacing="3px">

                        <label id="lblRejectReasonTitle"
                               value="Rejected Reason"/>

                        <combobox id="cmbRejectReason"
                                  width="100%"
                                  readonly="true"
                                  autodrop="true"
                                  placeholder="Select rejected reason"/>

                    </vlayout>


                    <!-- REMARKS -->
                    <vlayout width="100%"
                             spacing="3px">

                        <label id="lblRejectRemarksTitle"
                               value="Remarks"/>

                        <textbox id="txtRejectRemarks"
                                 width="100%"
                                 height="80px"
                                 multiline="true"
                                 placeholder="Enter remarks"/>

                    </vlayout>


                    <!-- BUTTONS -->
                    <hlayout id="divRejectRequestButtons"
                             width="100%"
                             spacing="8px"
                             valign="middle">

                        <label hflex="1"
                               value=""/>

                        <button id="btnCancelReject"
                                label="Cancel"
                                width="90px"/>

                        <button id="btnProceedReject"
                                label="Proceed"
                                width="100px"/>

                    </hlayout>

                </vlayout>

            </window>



            <!-- =====================================================
                 SAVE CONFIRMATION POPUP
                 ===================================================== -->
            <window id="winConfirmSave"
                    title="Confirm Save Changes"
                    width="420px"
                    closable="true"
                    sizable="false"
                    mode="modal"
                    visible="false"
                    sclass="micr-popup">

                <vlayout id="divConfirmSavePopup"
                         width="100%"
                         spacing="12px">

                    <label id="lblConfirmSaveMessage"
                           value="Are you sure you want to save the MICR changes?"
                           multiline="true"/>


                    <hlayout id="divConfirmSaveButtons"
                             width="100%"
                             spacing="8px"
                             valign="middle">

                        <label hflex="1"
                               value=""/>

                        <button id="btnCancelSave"
                                label="Cancel"
                                width="90px"/>

                        <button id="btnConfirmSave"
                                label="Save"
                                width="90px"/>

                    </hlayout>

                </vlayout>

            </window>



            <!-- =====================================================
                 INFORMATION POPUP
                 ===================================================== -->
            <window id="winMicrInformation"
                    title="MICR Repair"
                    width="400px"
                    closable="true"
                    sizable="false"
                    mode="modal"
                    visible="false"
                    sclass="micr-popup">

                <vlayout id="divMicrInformationPopup"
                         width="100%"
                         spacing="12px">

                    <label id="lblMicrInformationMessage"
                           value=""
                           multiline="true"/>


                    <hlayout id="divMicrInformationButton"
                             width="100%"
                             valign="middle">

                        <label hflex="1"
                               value=""/>

                        <button id="btnCloseMicrInformation"
                                label="OK"
                                width="80px"/>

                    </hlayout>

                </vlayout>

            </window>


        </vlayout>

    </window>

</zk>