<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - Outward MICR Repair" contentType="text/html;charset=UTF-8"?>

<zk>

    <style src="/css/outward/micr-repair-view.css?v=5" />

    <div id="micrRepairView"
         width="100%"
         height="100%"
         apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairViewController"
         sclass="outward-micr-repair-view-page"
         style="overflow-y: auto; overflow-x: hidden;">

        <vlayout width="100%" spacing="16px">

            <!-- Page Title -->
            <vlayout spacing="4px"
                      sclass="outward-micr-repair-title-section">

                <label value="MICR Repair"
                       sclass="outward-micr-repair-title" />

            </vlayout>


            <!-- Main Section Card -->
            <div sclass="outward-micr-repair-section-card"
                 width="100%">

                <vlayout width="100%" spacing="12px">


                    <!-- Section Header -->
                    <hlayout width="100%"
                             valign="middle"
                             style="display: flex; justify-content: space-between; align-items: center;">

                        <vlayout spacing="3px">

                            <label value="Batches Requiring MICR Repair"
                                   sclass="outward-micr-repair-section-title" />

                        </vlayout>


                        <!-- Batch Result Count -->
                        <label id="batchResultCount"
                               value="0 Batches"
                               sclass="outward-micr-repair-result-count" />

                    </hlayout>


                    <!-- Filter Bar -->
                    <div sclass="outward-micr-repair-filter-bar">

                        <hlayout valign="middle"
                                 spacing="12px">

                            <!-- Search Label -->
                            <label value="Search Batch ID"
                                   sclass="outward-micr-repair-filter-label" />


                            <!-- Batch ID Filter -->
                            <textbox id="batchIdFilter"
                                     placeholder="Enter full or partial Batch ID"
                                     width="340px"
                                     sclass="outward-micr-repair-filter-input"
                                     onChanging="$composer.onChanging$batchIdFilter(event)" />


                            <!-- Status Filter -->
                            <combobox id="cmbStatusFilter"
                                      readonly="true"
                                      width="170px"
                                      sclass="outward-micr-repair-status-filter"
                                      placeholder="Filter by Status">

                                <comboitem label="All Statuses"
                                           value="ALL" />

                                <comboitem label="Pending Maker"
                                           value="PENDING_MAKER" />

                                <comboitem label="Checker Returned"
                                           value="CHECKER_RETURNED" />

                            </combobox>


                            <!-- Clear Button -->
                            <button id="btnClearFilter"
                                    label="Clear"
                                    sclass="outward-micr-repair-clear-button"
                                    onClick="$composer.clearBatchFilter()" />

                        </hlayout>

                    </div>


                    <!-- MICR Repair Batch Grid -->
                    <grid id="grdMicrRepairBatches"
                          width="100%"
                          sclass="outward-micr-repair-grid">

                        <columns sizable="false">

                            <column label="Batch"
                                    width="18%"
                                    align="center" />

                            <column label="Received Date"
                                    width="18%"
                                    align="center" />

                            <column label="Total Cheques"
                                    width="16%"
                                    align="center" />

                            <column label="MICR Errors"
                                    width="16%"
                                    align="center" />

                            <column label="Status"
                                    width="16%"
                                    align="center" />

                            <column label="Action"
                                    width="16%"
                                    align="center" />

                        </columns>


                        <rows id="rowsMicrRepairBatches" />

                    </grid>


                    <!-- Pagination -->
                    <paging id="pagingMicrRepair"
                            pageSize="10"
                            detailed="true"
                            sclass="outward-micr-repair-paging" />


                    <!-- Empty State -->
                    <div id="divMicrRepairEmpty"
                         width="100%"
                         visible="false"
                         sclass="outward-micr-repair-empty-card">

                        <vlayout width="100%"
                                 spacing="6px">

                            <label value="No MICR repair required"
                                   sclass="outward-micr-repair-empty-title" />

                            <label value="There are currently no Outward batches requiring MICR repair."
                                   sclass="outward-micr-repair-empty-message" />

                        </vlayout>

                    </div>

                </vlayout>

            </div>

        </vlayout>

    </div>

</zk>