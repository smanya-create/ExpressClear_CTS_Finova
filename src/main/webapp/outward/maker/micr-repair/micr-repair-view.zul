<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS - MICR Repair" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet" type="text/css"
        href="/css/outward/micr-repair-view.css"?>

<zk>

    <div id="micrRepairViewMain"
         width="100%"
         apply="com.iispl.cts.controller.outward.maker.OutwardMakerMicrRepairViewController"
         sclass="micr-repair-view-page">

        <vlayout width="100%" spacing="20px">

            <!-- ================================================= -->
            <!-- PAGE TITLE -->
            <!-- ================================================= -->

            <vlayout spacing="4px"
                     sclass="micr-repair-view-title-section">

                <label id="lblMicrRepairViewTitle"
                       value="MICR REPAIR"
                       sclass="micr-repair-view-title" />

                <label id="lblMicrRepairViewSubtitle"
                       value="Select a batch requiring MICR repair."
                       sclass="micr-repair-view-subtitle" />

            </vlayout>


            <!-- ================================================= -->
            <!-- SCANNING BATCHES -->
            <!-- ================================================= -->

            <div id="divMicrRepairScanSection"
                 width="100%"
                 sclass="micr-repair-section-card"
                 visible="false">

                <vlayout width="100%" spacing="8px">

                    <vlayout spacing="3px">

                        <label id="lblMicrRepairScanTitle"
                               value="Scanning Batches"
                               sclass="micr-repair-section-title" />

                        <label id="lblMicrRepairScanSubtitle"
                               value="Batches from scanning that contain cheques requiring MICR repair."
                               sclass="micr-repair-section-subtitle" />

                    </vlayout>


                    <!-- SCAN BATCH TABLE -->

                    <grid id="grdMicrRepairScanBatches"
                          width="100%"
                          sclass="micr-repair-grid">

                        <columns sizable="false">

                            <column id="colMicrRepairScanBatch"
                                    label="BATCH"
                                    width="22%" />

                            <column id="colMicrRepairScanTotal"
                                    label="TOTAL CHEQUES"
                                    width="18%" />

                            <column id="colMicrRepairScanErrors"
                                    label="MICR ERRORS"
                                    width="18%" />

                            <column id="colMicrRepairScanStatus"
                                    label="STATUS"
                                    width="22%" />

                            <column id="colMicrRepairScanAction"
                                    label="ACTION"
                                    width="20%" />

                        </columns>

                        <rows id="rowsMicrRepairScanBatches" />

                    </grid>


                    <!-- SCAN PAGINATION -->

                    <paging id="pagingMicrRepairScan"
                            pageSize="10"
                            detailed="true"
                            visible="false"
                            sclass="micr-repair-paging" />

                </vlayout>

            </div>


            <!-- ================================================= -->
            <!-- CHECKER RETURNED BATCHES -->
            <!-- ================================================= -->

            <div id="divMicrRepairCheckerSection"
                 width="100%"
                 sclass="micr-repair-section-card"
                 visible="false">

                <vlayout width="100%" spacing="8px">

                    <vlayout spacing="3px">

                        <label id="lblMicrRepairCheckerTitle"
                               value="Batches Returned by Checker"
                               sclass="micr-repair-section-title" />

                        <label id="lblMicrRepairCheckerSubtitle"
                               value="Batches returned by Checker to Maker that require MICR repair."
                               sclass="micr-repair-section-subtitle" />

                    </vlayout>


                    <!-- CHECKER RETURNED TABLE -->

                    <grid id="grdMicrRepairCheckerBatches"
                          width="100%"
                          sclass="micr-repair-grid">

                        <columns sizable="false">

                            <column id="colMicrRepairCheckerBatch"
                                    label="BATCH"
                                    width="22%" />

                            <column id="colMicrRepairCheckerTotal"
                                    label="TOTAL CHEQUES"
                                    width="18%" />

                            <column id="colMicrRepairCheckerErrors"
                                    label="MICR ERRORS"
                                    width="18%" />

                            <column id="colMicrRepairCheckerStatus"
                                    label="STATUS"
                                    width="22%" />

                            <column id="colMicrRepairCheckerAction"
                                    label="ACTION"
                                    width="20%" />

                        </columns>

                        <rows id="rowsMicrRepairCheckerBatches" />

                    </grid>


                    <!-- CHECKER PAGINATION -->

                    <paging id="pagingMicrRepairChecker"
                            pageSize="10"
                            detailed="true"
                            visible="false"
                            sclass="micr-repair-paging" />

                </vlayout>

            </div>


            <!-- ================================================= -->
            <!-- NO MICR REPAIR MESSAGE -->
            <!-- ================================================= -->

            <div id="divMicrRepairEmpty"
                 width="100%"
                 visible="false"
                 sclass="micr-repair-empty-card">

                <vlayout width="100%"
                         spacing="6px">

                    <label id="lblMicrRepairEmptyTitle"
                           value="No MICR repair required"
                           sclass="micr-repair-empty-title" />

                    <label id="lblMicrRepairEmptyMessage"
                           value="There are currently no batches requiring MICR repair."
                           sclass="micr-repair-empty-message" />

                </vlayout>

            </div>

        </vlayout>

    </div>

</zk>