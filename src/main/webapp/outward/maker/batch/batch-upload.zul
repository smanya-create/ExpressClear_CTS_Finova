<?xml version="1.0" encoding="UTF-8"?>

<zk>

	<style src="/css/outward/batch-upload.css"/>
	<window id="uploadBatchWindow"
		apply="com.iispl.cts.controller.outward.maker.OutwardMakerBatchUploadController"
		border="none" width="100%" height="100%"
		contentStyle="padding:0; margin:0; overflow:auto;">

		<div width="100%" sclass="upload-batch-page">

			<!-- =========================================================
				PAGE HEADER
				========================================================= -->

			<div sclass="page-header">

				<label value="Upload Batch" sclass="page-title" />

				<label
					value="Enter batch control information and scan the cheque folder."
					sclass="page-description" />

			</div>


			<!-- =========================================================
				BATCH CONTROL INFORMATION
				========================================================= -->

			<groupbox id="batchControlGroup" width="100%"
				sclass="batch-control-groupbox">

				<caption label="BATCH CONTROL INFORMATION"
					sclass="groupbox-caption" />

				<vlayout width="100%" spacing="16px"
					sclass="batch-control-vlayout">


					<!-- =================================================
						EXPECTED COUNT + EXPECTED AMOUNT
						================================================= -->

					<hlayout width="100%" spacing="16px"
						sclass="batch-control-hlayout">

						<div sclass="form-group-wrapper">

							<label value="Expected Cheque Count *"
								sclass="form-label" />

							<intbox id="txtExpectedTotalCheques"
								placeholder="Enter expected number of cheques"
								sclass="form-input" width="100%" />

						</div>


						<div sclass="form-group-wrapper">

							<label value="Expected Total Amount *"
								sclass="form-label" />

							<decimalbox
								id="txtExpectedTotalChequeAmount"
								placeholder="Enter expected total amount" sclass="form-input"
								width="100%" />

						</div>

					</hlayout>


					<!-- =================================================
						CHEQUE ZIP
						================================================= -->

					<div sclass="form-group-full folder-group">

						<label value="Cheque Folder *"
							sclass="form-label" />

						<hlayout width="100%" spacing="12px"
							sclass="folder-row">

							<textbox id="txtChequeFolder"
								placeholder="Cheque ZIP file selected" readonly="true" hflex="1"
								sclass="form-input folder-input" />

							<button id="btnBrowse" label="Browse"
								sclass="btn-browse" upload="true,maxsize=104857600" />

						</hlayout>

						<label
							value="Note: Please select a ZIP file containing one XML file and cheque front/back JPEG images."
							sclass="form-hint" />

					</div>


					<!-- =================================================
						BATCH NUMBER
						================================================= -->

					<div class="form-group-full">

						<label value="Batch Number" sclass="form-label" />

						<textbox id="txtBatchNumber" readonly="true"
							placeholder="Generated from batch XML" sclass="form-input"
							width="100%" />

						<label
							value="Automatically generated from the uploaded batch XML"
							sclass="form-hint" />

					</div>


					<!-- =================================================
						VALIDATE BUTTON
						================================================= -->

					<div sclass="form-actions-inline">

						<button id="btnValidateBatch"
							label="Validate Batch" sclass="btn-validate" disabled="true" />

					</div>

				</vlayout>

			</groupbox>


			<!-- =========================================================
				SUCCESS MESSAGE
				IMPORTANT:
				This is BEFORE Scanning Batches
				========================================================= -->

			<div id="divSuccessMessage" visible="false"
				sclass="success-message">

				<div sclass="success-icon">✓</div>

				<vlayout spacing="4px">

					<label value="Batch Uploaded Successfully"
						sclass="success-title" />

					<label id="lblSuccessText" value=""
						sclass="success-text" />

				</vlayout>

			</div>


			<!-- =========================================================
				SCANNING BATCHES
				ONLY BATCH INFORMATION IS DISPLAYED
				========================================================= -->

			<groupbox id="batchDetailsGroup" visible="false"
				width="100%" sclass="batch-details-section">

				<caption label="Scanning Batches"
					sclass="groupbox-caption" />

				<div width="100%" sclass="batch-details-content">

					<label
						value="Batches from scanning that contain cheques requiring MICR repair."
						sclass="batch-details-description" />


					<listbox id="lstBatchDetails" width="100%"
						sclass="batch-details-table" emptyMessage="No batch found">

						<listhead sizable="false">

							<listheader label="BATCH" width="18%" />

							<listheader label="SCAN DATE" width="16%" />

							<listheader label="TOTAL CHEQUES"
								width="18%" />

							<listheader label="MICR ERRORS" width="16%" />

							<listheader label="STATUS" width="16%" />

							<listheader label="ACTION" width="16%" />

						</listhead>

					</listbox>

				</div>

			</groupbox>


			<!-- =========================================================
				FOOTER
				========================================================= -->

			<div sclass="page-footer">

				<label value="Express Clear CTS · Maker Portal" />

				<label value="Secure Batch Processing" />

			</div>

		</div>

	</window>

</zk>