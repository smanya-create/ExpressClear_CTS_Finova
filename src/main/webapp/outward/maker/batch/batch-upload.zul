<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/outward/batch-upload.css" />

    <window id="uploadBatchWindow"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerBatchUploadController"
            border="none"
            width="100%"
            height="100%"
            contentStyle="padding:0;">

        <div width="100%"
             height="100%"
             style="overflow:auto;">

            <!-- ================= PAGE HEADER ================= -->

            <div sclass="page-header">

                <label value="Upload Batch"
                       sclass="page-title" />

                <label value="Enter batch control information and scan the cheque folder."
                       sclass="page-description" />

            </div>


            <!-- ================= BATCH CONTROL ================= -->

            <groupbox id="batchControlGroup"
                      width="100%"
                      sclass="batch-control-window"
                      style="margin-bottom:24px;
                             background-color:white;
                             border-radius:4px;
                             border:1px solid #ddd;">

                <caption label="BATCH CONTROL INFORMATION"
                          sclass="groupbox-caption" />

                <vlayout width="100%"
                         spacing="16px"
                         sclass="batch-control-vlayout">


                    <!-- ================= EXPECTED VALUES ================= -->

                    <hlayout width="100%"
                             spacing="16px"
                             sclass="batch-control-hlayout">

                        <div class="form-group-wrapper">

                            <label value="Expected Cheque Count *"
                                   sclass="form-label" />

                            <intbox id="expectedTotalCheques"
                                    placeholder="Enter expected number of cheques"
                                    sclass="form-input"
                                    width="100%" />

                        </div>


                        <div class="form-group-wrapper">

                            <label value="Expected Total Amount *"
                                   sclass="form-label" />

                            <decimalbox id="expectedTotalChequeAmount"
                                        placeholder="Enter expected total amount"
                                        sclass="form-input"
                                        width="100%" />

                        </div>

                    </hlayout>


                    <!-- ================= CHEQUE ZIP ================= -->

                    <div class="form-group-full folder-group">

                        <label value="Cheque Folder *"
                               sclass="form-label" />

                        <hlayout width="100%"
                                 spacing="12px"
                                 sclass="folder-row">

                            <textbox id="chequeFolder"
                                     placeholder="Cheque ZIP file selected"
                                     readonly="true"
                                     hflex="1"
                                     sclass="form-input folder-input" />

                            <button id="browseButton"
                                    label="Browse"
                                    sclass="btn-browse"
                                    upload="true,maxsize=104857600" />

                        </hlayout>

                        <label value="Note: Please select a ZIP file containing one XML file and cheque front/back JPEG images."
                               sclass="form-hint" />

                    </div>


                    <!-- ================= BATCH NUMBER ================= -->

                    <div class="form-group-full">

                        <label value="Batch Number"
                               sclass="form-label" />

                        <textbox id="batchNumber"
                                 readonly="true"
                                 placeholder="Generated from batch XML"
                                 sclass="form-input"
                                 width="100%" />

                        <label value="Automatically generated from the uploaded batch XML"
                               sclass="form-hint" />

                    </div>


                    <!-- ================= VALIDATE ================= -->

                    <div class="form-actions-inline">

                        <button id="validateBatchButton"
                                label="Validate Batch"
                                sclass="btn-validate"
                                disabled="true" />

                    </div>

                </vlayout>

            </groupbox>


            <!-- ================= SUCCESS MESSAGE ================= -->

            <div id="successMessage"
                 visible="false"
                 class="success-message"
                 style="margin:16px 0 24px 0;">

                <div class="success-icon">
                    ✓
                </div>

                <vlayout spacing="4px">

                    <label value="Batch Uploaded Successfully"
                           sclass="success-title" />

                    <label id="successText"
                           value=""
                           sclass="success-text" />

                </vlayout>

            </div>


            <!-- ================= SCANNED CHEQUES ================= -->

            <groupbox id="scannedChequesWindow"
                      visible="false"
                      width="100%"
                      sclass="scanned-cheques-window"
                      style="background-color:white;
                             border-radius:4px;
                             border:1px solid #ddd;
                             margin-bottom:24px;">

                <caption label="Scanned Cheques"
                          sclass="groupbox-caption" />

                <div width="100%"
                     height="500px"
                     style="overflow:auto;
                            padding:16px;
                            box-sizing:border-box;">

                    <hlayout width="100%"
                             spacing="12px"
                             style="margin-bottom:16px;">

                        <label id="scannedChequeTitle"
                               value="Scanned Cheques"
                               sclass="section-title" />

                        <div sclass="stat-badge normal">

                            <label id="normalCount"
                                   value="0 NORMAL" />

                        </div>

                        <div sclass="stat-badge micr-repair">

                            <label id="micrRepairCount"
                                   value="0 MICR REPAIR" />

                        </div>

                    </hlayout>


                    <!-- ================= CHEQUE LIST ================= -->

                    <listbox id="chequeList"
                             width="100%"
                             sclass="scanned-cheques-table"
                             mold="paging"
                             pageSize="5"
                             emptyMessage="No cheques found">

                        <listhead sizable="false">

                            <listheader label="ITEM NO."
                                        width="15%" />

                            <listheader label="PAYEE NAME"
                                        width="25%" />

                            <listheader label="MICR CODE"
                                        width="25%" />

                            <listheader label="STATUS"
                                        width="20%" />

                            <listheader label="ACTION"
                                        width="15%" />

                        </listhead>

                    </listbox>

                </div>

            </groupbox>


            <!-- ================= FOOTER ================= -->

            <div class="page-footer">

                <label value="Express Clear CTS · Maker Portal" />

                <label value="Secure Batch Processing" />

            </div>

        </div>

    </window>

</zk>