<zk>

    <window id="winBatchUpload"
            apply="com.iispl.cts.controller.outward.maker.OutwardMakerBatchUploadController"
            title="Batch Upload"
            width="100%"
            height="100%"
            border="none">

        <vlayout width="100%" height="100%" spacing="15px">

            <groupbox id="grpBatchUpload"
                      width="100%"
                      closable="false">

                <caption label="Batch Upload"/>

                <vlayout width="100%" spacing="10px">

                    <hlayout width="100%" spacing="10px">

                        <vlayout width="250px">

                            <label value="Expected Total Cheques"/>

                            <intbox id="txtExpectedTotalCheques"
                                    width="100%"/>

                        </vlayout>


                        <vlayout width="250px">

                            <label value="Expected Total Cheque Amount"/>

                            <decimalbox id="txtExpectedTotalChequeAmount"
                                        width="100%"/>

                        </vlayout>

                    </hlayout>


                    <hlayout width="100%" spacing="10px">

                        <textbox id="txtChequeFolder"
                                 width="500px"
                                 readonly="true"/>

                        <button id="btnBrowse" label="Browse"
								sclass="btn-browse" upload="true,maxsize=104857600" />

                                
                                

                        <button id="btnValidateBatch"
                                label="Validate Batch"
                                disabled="true"/>

                    </hlayout>

                </vlayout>

            </groupbox>


            <!-- Success Message -->

            <div id="divSuccessMessage"
                 visible="false"
                 width="100%">

                <label id="lblSuccessText"
                       value=""
                       width="100%"/>

            </div>


            <!-- Batch Details -->

            <groupbox id="batchDetailsGroup"
                      width="100%"
                      visible="false"
                      closable="false">

                <caption label="Batch Details"/>

                <listbox id="lstBatchDetails"
                         width="100%"
                         height="220px">

                    <listhead>

                        <listheader label="Batch ID"
                                    width="20%"/>

                        <listheader label="Scan Date"
                                    width="20%"/>

                        <listheader label="Total Cheques"
                                    width="15%"/>

                        <listheader label="MICR Errors"
                                    width="15%"/>

                        <listheader label="Status"
                                    width="15%"/>

                        <listheader label="Action"
                                    width="15%"/>

                    </listhead>

                </listbox>

            </groupbox>


            <!-- Cheque Details -->

            <groupbox id="grpChequeDetails"
                      width="100%"
                      visible="false"
                      closable="false">

                <caption label="Cheque Details"/>

                <vlayout width="100%" spacing="10px">

                    <hlayout width="100%" spacing="10px">

                        <label id="lblChequeFilter"
                               value="Filter:"/>

                        <combobox id="cmbChequeFilter"
                                  width="220px"
                                  readonly="true">

                            <comboitem label="All Cheques"
                                       value="ALL"/>

                            <comboitem label="Normal Cheques"
                                       value="NORMAL"/>

                            <comboitem label="MICR Repair Cheques"
                                       value="MICR_REPAIR"/>

                        </combobox>

                        <label id="lblTotalCheques"
                               value=""/>

                    </hlayout>


                    <!-- Cheque List -->

                    <listbox id="lstCheques"
                             width="100%"
                             height="230px">

                        <listhead>

                            <listheader label="Cheque ID"
                                        width="20%"/>

                            <listheader label="Cheque Number"
                                        width="15%"/>

                            <listheader label="Amount"
                                        width="15%"/>

                            <listheader label="Status"
                                        width="20%"/>

                            <listheader label="MICR"
                                        width="15%"/>

                            <listheader label="Action"
                                        width="15%"/>

                        </listhead>

                    </listbox>


                    <hlayout width="100%"
                             spacing="10px">

                        <button id="btnChequePrevious"
                                label="Previous"
                                disabled="true"/>

                        <label id="lblChequePage"
                               value="Page 1"/>

                        <button id="btnChequeNext"
                                label="Next"
                                disabled="true"/>

                    </hlayout>

                </vlayout>

            </groupbox>

        </vlayout>

    </window>

</zk>