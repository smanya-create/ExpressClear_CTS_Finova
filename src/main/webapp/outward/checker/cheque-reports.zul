<?page title="ExpressClear CTS - Checker Reports" contentType="text/html;charset=UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/outward/cheque-reports.css"?>

<zk>


	<!-- =========================================================
		MAIN WINDOW
		========================================================= -->
	<window id="reportsWindow" border="none" width="100%" height="100%"
		sclass="reports-window"
		apply="com.iispl.cts.controller.outward.checker.OutwardChequeReportController">

		<!-- =====================================================
			WINDOW HOST
			===================================================== -->
		<div id="windowHost" />

		<vlayout width="100%" height="100%" spacing="0">

			<!-- TOP PAGE GAP -->
			<div width="100%" height="10px" sclass="top-page-gap" />

			<!-- MAIN BORDER LAYOUT -->
			<borderlayout width="100%" vflex="1">

				<!-- SIDEBAR -->
				<west width="220px" border="none" collapsible="false" splittable="false">
					<include src="/components/sidebar.zul" width="100%" height="100%" activeTab="outward-checker-reports" />
				</west>

				<!-- MAIN CENTER -->
				<center border="none">
					<borderlayout width="100%" height="100%">

						<!-- HEADER -->
						<north height="90px" border="none">
							<div sclass="header-wrapper" width="100%" height="90px">					
								<div sclass="common-header-container">
									<include src="/components/header.zul" pageTitle = "Outward Processing" width="100%" height="100%" />
								</div>
							</div>
						</north>

						<!-- MAIN CONTENT -->
						<center border="none" autoscroll="false">
							<div sclass="main-page" width="100%" height="100%">
								<div sclass="content-area" width="100%" height="100%">

									<!-- PAGE HEADING -->
									<div sclass="page-heading">
										<label value="Reports" sclass="section-title" />
										<label value="Generate and download operational clearing settlement and rejection reports." sclass="section-description" />
									</div>

									<!-- REPORT CARD -->
									<div sclass="report-card" width="70%" height="auto">

										<!-- REPORT TYPE SELECTOR -->
										<div sclass="date-field" width="100%" style="margin-bottom: 14px;">
											<label value="REPORT TYPE" sclass="field-label" />
											<combobox id="cmbReportType" readonly="true" width="100%" height="38px">
												<comboitem label="Outward Clearing &amp; Batch Settlement Report (Pending, Verified, NPCI)" value="OUTWARD_CLEARING_SETTLEMENT" />
												<comboitem label="Outward Cheque Rejection Audit Report (Rejections Only)" value="OUTWARD_REJECTIONS_AUDIT" />
											</combobox>
										</div>

										<!-- DATE ROW -->
										<div sclass="date-row" width="100%">
											<div sclass="date-field">
												<label value="FROM DATE" sclass="field-label" />
												<datebox id="dateFrom" format="yyyy-MM-dd" width="100%" buttonVisible="true" sclass="report-datebox" />
											</div>

											<div sclass="date-field">
												<label value="TO DATE" sclass="field-label" />
												<datebox id="dateTo" format="yyyy-MM-dd" width="100%" buttonVisible="true" sclass="report-datebox" />
											</div>
										</div>

										<!-- DIVIDER -->
										<div sclass="report-divider" style="margin: 18px 0;" />

										<!-- REPORT DETAILS -->
										<div sclass="report-details" style="margin-bottom: 16px;">
											<label value="REPORT DETAILS" sclass="details-title" />
											<label value="Select a report type and date range, then export as a raw CSV spreadsheet or print-ready PDF document." sclass="details-description" />
										</div>

										<!-- ACTION BUTTONS: CSV & PDF -->
										<div sclass="button-row" style="display: flex; gap: 14px; align-items: center;">
											<button id="btnExportCsv" label="DOWNLOAD CSV REPORT" sclass="generate-report-button" height="38px" />
											<button id="btnExportPdf" label="DOWNLOAD PDF REPORT" sclass="generate-report-button" height="38px" 
												style="background: #ffffff !important; color: #173b61 !important; border: 1.5px solid #173b61 !important;" />
										</div>

									</div>

								</div>
							</div>
						</center>

						

					</borderlayout>
				</center>

			</borderlayout>
		</vlayout>
	</window>
</zk>