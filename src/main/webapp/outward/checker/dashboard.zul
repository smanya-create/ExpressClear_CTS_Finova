<?xml version="1.0" encoding="UTF-8"?>
<?page title="Checker Dashboard" contentType="text/html;charset=UTF-8"?>

<zk title="CTS - Checker Dashboard">

    <style src="/css/outward/checker-dashboard.css" />

    <borderlayout
        hflex="1"
        vflex="1"
        apply="com.iispl.cts.controller.outward.checker.OutwardCheckerDashboardController">

        <west
            width="265px"
            splittable="false"
            collapsible="false">

            <include
                src="/components/sidebar.zul"
                role="OUTWARD_CHECKER"
                activeTab="checker-dashboard" />

        </west>

        <center>

            <borderlayout
                hflex="1"
                vflex="1">

                <north
                    height="75px"
                    splittable="false"
                    collapsible="false">

                    <include
                        src="/components/header.zul"
                        pageTitle="Checker Dashboard" />

                </north>

                <center>

                    <div
                        sclass="outward-checker-dashboard"
                        hflex="1"
                        vflex="1">

                        <div
                            sclass="outward-checker-dashboard-scroll">

                            <div
                                sclass="outward-checker-welcome-section">

                                <label
                                    value="Dashboard"
                                    sclass="outward-checker-welcome-title" />

                                <label
                                    value="Batches received from Maker and awaiting Checker action."
                                    sclass="outward-checker-welcome-subtitle" />

                            </div>

                            <div
                                sclass="outward-checker-summary-card">

                                <div
                                    sclass="outward-checker-summary-item">

                                    <label
                                        value="BATCHES AWAITING CHECKER"
                                        sclass="outward-checker-summary-label" />

                                    <label
                                        id="lblTotalBatches"
                                        sclass="outward-checker-summary-value" />

                                </div>

                                <div
                                    sclass="outward-checker-summary-item">

                                    <label
                                        value="CHEQUES"
                                        sclass="outward-checker-summary-label" />

                                    <label
                                        id="lblTotalCheques"
                                        sclass="outward-checker-summary-value" />

                                </div>

                            </div>

                            <div
                                sclass="outward-checker-section-header">

                                <label
                                    value="Batches Received from Maker"
                                    sclass="outward-checker-section-title" />

                                <label
                                    value="Completed Maker processing and submitted for Checker verification."
                                    sclass="outward-checker-section-subtitle" />

                            </div>

                            <div
                                sclass="outward-checker-table-card">

                                <listbox
                                    id="lstBatches"
                                    sclass="outward-checker-batch-table"
                                    height="270px"
                                    mold="paging"
                                    autopaging="false">

                                    <listhead>

                                        <listheader
                                            label="BATCH"
                                            width="12%" />

                                        <listheader
                                            label="NO. OF CHEQUES"
                                            width="14%" />

                                        <listheader
                                            label="TOTAL AMOUNT"
                                            width="19%" />

                                        <listheader
                                            label="SUBMITTED BY"
                                            width="14%" />

                                        <listheader
                                            label="SUBMITTED AT"
                                            width="16%" />

                                        <listheader
                                            label="STATUS"
                                            width="17%" />

                                        <listheader
                                            label="Action"
                                            width="90px" />

                                    </listhead>

                                </listbox>

                            </div>

                            <div
                                sclass="outward-checker-pagination">

                                <button
                                    id="btnPrevious"
                                    label="‹"
                                    disabled="true"
                                    sclass="outward-checker-pagination-button" />

                                <label
                                    id="lblPage"
                                    value="1/1"
                                    sclass="outward-checker-pagination-label" />

                                <button
                                    id="btnNext"
                                    label="›"
                                    disabled="true"
                                    sclass="outward-checker-pagination-button" />

                            </div>

                        </div>

                    </div>

                </center>

            </borderlayout>

        </center>

    </borderlayout>

</zk>