<?xml version="1.0" encoding="UTF-8"?>

<zk xmlns:h="xhtml" title="CTS - Checker Dashboard">

	<style src="/css/outward/checker-dashboard.css" />

	<borderlayout hflex="1" vflex="1"
		apply="com.iispl.cts.controller.outward.checker.OutwardCheckerDashboardController">

		<west width="265px" splittable="false" collapsible="false">

			<include src="/components/sidebar.zul"
				role="OUTWARD_CHECKER" activeTab="checker-dashboard" />

		</west>

		<center>

			<borderlayout hflex="1" vflex="1">

				<north height="75px" splittable="false"
					collapsible="false">

					<include src="/components/header.zul"
						pageTitle="Checker Dashboard" />

				</north>

				<center>

					<div sclass="dashboard-content">

						<label value="Dashboard" sclass="page-title" />

						<label
							value="Batches received from Maker and awaiting Checker action."
							sclass="page-description" />

						<div sclass="summary-card">

							<div sclass="summary-item">

								<label value="CURRENT SESSION"
									sclass="summary-label" />

								<label value="BOD"
									sclass="summary-value" />

							</div>

							<div sclass="summary-item">

								<label value="BATCHES AWAITING CHECKER"
									sclass="summary-label" />

								<label id="lblTotalBatches"
									sclass="summary-value" />

							</div>

							<div sclass="summary-item">

								<label value="CHEQUES"
									sclass="summary-label" />

								<label id="lblTotalCheques"
									sclass="summary-value" />

							</div>

						</div>

						<div sclass="section-header">

							<label value="Batches Received from Maker"
								sclass="section-title" />

							<label
								value="Completed Maker processing and submitted for Checker verification."
								sclass="section-description" />

						</div>
						<listbox id="lstBatches" sclass="batch-table"
							height="270px">

							<listhead>
								<listheader label="BATCH" width="12%"
									style="background:#1d5689; color:white;" />

								<listheader label="NO. OF CHEQUES"
									width="14%" style="background:#1d5689; color:white;" />

								<listheader label="TOTAL AMOUNT"
									width="19%" style="background:#1d5689; color:white;" />

								<listheader label="SUBMITTED BY"
									width="14%" style="background:#1d5689; color:white;" />

								<listheader label="SUBMITTED AT"
									width="16%" style="background:#1d5689; color:white;" />

								<listheader label="STATUS" width="13%"
									style="background:#1d5689; color:white;" />

								<listheader label="Action" width="90px"
									style="background:#1d5689; color:white;" />
							</listhead>

						</listbox>
						<vlayout hflex="1" style="margin-top:10px;">

							<hbox hflex="1" pack="center"
								spacing="10px">

								<button id="btnPrevious"
									label="Previous" disabled="true" sclass="pagination-button" />

								<label id="lblPage" value="1/5"
									sclass="page-number" />

								<button id="btnNext" label="Next"
									sclass="pagination-button" />

							</hbox>

						</vlayout>

					</div>

				</center>

			</borderlayout>

		</center>

	</borderlayout>

</zk>