<?page title="Batch Selected" contentType="text/html;charset=UTF-8"?>

<window id="batchProceedPopup"
        mode="modal"
        border="normal"
        width="340px"
        closable="true"
        sizable="false"
        apply="com.iispl.cts.controller.outward.checker.BatchProceedPopupController"
        style="background:#ffffff;
               overflow:hidden;">

    <vlayout spacing="10px"
             style="padding:16px;
                    background:#ffffff;
                    box-sizing:border-box;">

        <label value="Batch Selected"
               style="font-size:17px;
                      font-weight:bold;" />

        <hlayout spacing="10px"
                  style="align-items:center;">

            <label value="Batch ID:"
                   style="font-weight:bold;" />

            <label id="lblPopupBatchId" />

        </hlayout>

        <label value="Do you want to proceed with this batch for verification?"
               multiline="true"
               style="font-size:12px;" />

        <hlayout spacing="10px"
                 style="display:flex;
                        justify-content:flex-end;
                        gap:10px;">

            <button id="btnProceed"
                    label="PROCEED"
                    sclass="btn-proceed"
                    style="background:#1d5689;
                           background-image:none;
                           color:white;
                           border:none;
                           border-radius:6px;
                           font-size:9px;
                           font-weight:bold;
                           padding:8px 15px;
                           cursor:pointer;" />

            <button id="btnCancel"
                    label="CANCEL"
                    sclass="btn-cancel"
                    style="background:#1d5689;
                           background-image:none;
                           color:white;
                           border:none;
                           border-radius:6px;
                           font-size:9px;
                           font-weight:bold;
                           padding:8px 15px;
                           cursor:pointer;" />

        </hlayout>

    </vlayout>

</window>