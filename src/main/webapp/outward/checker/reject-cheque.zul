<?page title="Reject Cheque" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/css/outward/reject-cheque.css"?>

<zk>

    <window
        id="rejectWindow"
        title="Reject Cheque"
        border="normal"
        width="680px"
        closable="true"
        sizable="false"
        mode="modal"
        position="center"
        sclass="reject-cheque-window">

        <!-- HEADER -->
        <div sclass="reject-header">

            <label
                value="Reject Cheque"
                sclass="reject-title"/>

            <label
                value="Please select the reason for rejecting this cheque."
                sclass="reject-description"/>

        </div>


        <!-- CONTENT -->
        <div sclass="reject-content">

            <!-- BATCH + CHEQUE NUMBER -->
            <div sclass="two-column">

                <div sclass="field-group">

                    <label
                        value="BATCH"
                        sclass="field-label"/>

                    <label
                        id="lblRejectBatch"
                        value="-"
                        sclass="readonly-field"/>

                </div>


                <div sclass="field-group">

                    <label
                        value="CHEQUE NUMBER"
                        sclass="field-label"/>

                    <label
                        id="lblRejectCheque"
                        value="-"
                        sclass="readonly-field"/>

                </div>

            </div>


            <!-- REJECTION REASON -->
            <div sclass="field-group">

                <label
                    value="REJECTION REASON *"
                    sclass="field-label"/>

                <combobox
                    id="cmbRejectReason"
                    width="100%"
                    placeholder="Select rejection reason"
                    readonly="true"
                    sclass="reason-combobox"/>

            </div>


            <!-- REMARKS -->
            <div sclass="field-group">

                <label
                    value="REMARKS *"
                    sclass="field-label"/>

                <textbox
                    id="txtRejectRemarks"
                    multiline="true"
                    rows="4"
                    width="100%"
                    maxlength="255"
                    placeholder="Enter remarks..."
                    sclass="remarks-field"/>

            </div>

        </div>


        <!-- FOOTER -->
        <div sclass="reject-footer">

            <button
                id="btnRejectCancel"
                label="CANCEL"
                sclass="cancel-button"/>

            <button
                id="btnRejectConfirm"
                label="REJECT"
                sclass="reject-confirm-button"/>

        </div>

    </window>

</zk>