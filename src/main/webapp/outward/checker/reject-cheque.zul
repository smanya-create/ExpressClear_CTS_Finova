<?xml version="1.0" encoding="UTF-8"?>

<?page
    title="Reject Cheque"
    contentType="text/html;charset=UTF-8"
?>

<?link
    rel="stylesheet"
    type="text/css"
    href="/css/outward/reject-cheque.css"
?>

<div
    id="rejectPopupOverlay"
    sclass="reject-popup-overlay"
    visible="false"
    width="100%"
    height="100%">

    <!-- =========================================================
         POPUP CONTAINER
         ========================================================= -->

    <div
        id="rejectPopup"
        sclass="reject-popup">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div
            sclass="reject-popup-header">

            <div
                sclass="reject-header-text">

                <label
                    value="Reject Cheque"
                    sclass="reject-popup-title"
                />

                <label
                    value="Reject the selected cheque"
                    sclass="reject-popup-subtitle"
                />

            </div>

            <button
                id="btnRejectClose"
                label="×"
                sclass="reject-close-button"
            />

        </div>


        <!-- =====================================================
             CHEQUE INFORMATION
             ===================================================== -->

        <div
            sclass="reject-info-card">

            <!-- BATCH -->

            <div
                sclass="reject-info-item">

                <label
                    value="BATCH"
                    sclass="reject-info-label"
                />

                <label
                    id="lblRejectBatch"
                    value="-"
                    sclass="reject-info-value"
                />

            </div>


            <!-- CHEQUE -->

            <div
                sclass="reject-info-item">

                <label
                    value="CHEQUE"
                    sclass="reject-info-label"
                />

                <label
                    id="lblRejectCheque"
                    value="-"
                    sclass="reject-info-value"
                />

            </div>

        </div>


        <!-- =====================================================
             REJECTION REASON
             ===================================================== -->

        <div
            sclass="reject-field">

            <label
                value="REJECTION REASON"
                sclass="reject-field-label"
            />

            <combobox
                id="cmbRejectReason"
                width="100%"
                placeholder="Select rejection reason"
                sclass="reject-combobox"
            />

        </div>


        <!-- =====================================================
             REMARKS
             ===================================================== -->

        <div
            sclass="reject-field">

            <label
                value="REMARKS"
                sclass="reject-field-label"
            />

            <textbox
                id="txtRejectRemarks"
                width="100%"
                rows="4"
                multiline="true"
                placeholder="Enter rejection remarks"
                sclass="reject-remarks"
            />

        </div>


        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <div
            sclass="reject-popup-footer">

            <button
                id="btnRejectCancel"
                label="CANCEL"
                sclass="reject-cancel-button"
            />

            <button
                id="btnRejectConfirm"
                label="REJECT CHEQUE"
                sclass="reject-confirm-button"
            />

        </div>

    </div>

</div>