<?xml version="1.0" encoding="UTF-8"?>

<?page
    title="Reject Cheque"
    contentType="text/html;charset=UTF-8"
?>

<zk>

    <!-- ========================================================= -->
    <!-- REJECT CHEQUE WINDOW -->
    <!-- ========================================================= -->

    <window
        id="rejectWindow"
        title=""
        border="none"
        width="540px"
        mode="modal"
        closable="true"
        sizable="false"
        visible="false"
        style="
            background:#ffffff;
            border:none;
            border-radius:10px;
            overflow:visible;
            box-shadow:0 6px 25px rgba(0,0,0,0.20);
        ">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <div
            style="
                height:52px;
                display:flex;
                align-items:center;
                justify-content:space-between;
                padding:0 16px;
                background:#173b63;
                color:#ffffff;
                box-sizing:border-box;
            ">

            <div
                style="
                    display:flex;
                    align-items:center;
                ">

                <label
                    value="✕"
                    style="
                        font-size:20px;
                        color:#ffffff;
                        margin-right:12px;
                    "/>

                <div
                    style="
                        width:1px;
                        height:24px;
                        background:rgba(255,255,255,0.35);
                        margin-right:14px;
                    "/>

                <label
                    value="Reject Cheque"
                    style="
                        font-size:18px;
                        font-weight:600;
                        color:#ffffff;
                    "/>

            </div>


            <!-- CLOSE BUTTON -->

            <label
                id="btnCloseReject"
                value="×"
                onClick="rejectWindow.setVisible(false);"
                style="
                    font-size:26px;
                    font-weight:400;
                    color:#ffffff;
                    cursor:pointer;
                    line-height:1;
                    user-select:none;
                "/>

        </div>


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <div
            style="
                padding:18px 22px 16px 22px;
                background:#ffffff;
                box-sizing:border-box;
            ">


            <!-- ================================================= -->
            <!-- INFORMATION MESSAGE -->
            <!-- ================================================= -->

            <div
                style="
                    display:flex;
                    align-items:center;
                    min-height:42px;
                    padding:0 12px;
                    margin-bottom:18px;
                    background:#eef5ff;
                    border-radius:6px;
                    box-sizing:border-box;
                ">

                <div
                    style="
                        width:26px;
                        height:26px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        margin-right:10px;
                        border-radius:50%;
                        background:#1769aa;
                    ">

                    <label
                        value="i"
                        style="
                            color:#ffffff;
                            font-size:15px;
                            font-weight:bold;
                        "/>

                </div>

                <label
                    value="Reject the selected cheque."
                    style="
                        font-size:13px;
                        color:#173b63;
                    "/>

            </div>


            <!-- ================================================= -->
            <!-- BATCH + CHEQUE NUMBER -->
            <!-- ================================================= -->

            <div
                style="
                    display:flex;
                    gap:16px;
                    width:100%;
                    margin-bottom:17px;
                ">


                <!-- BATCH -->

                <div style="flex:1;">

                    <label
                        value="BATCH"
                        style="
                            display:block;
                            margin-bottom:5px;
                            font-size:11px;
                            font-weight:700;
                            color:#526b8a;
                        "/>

                    <div
                        style="
                            height:42px;
                            display:flex;
                            align-items:center;
                            padding:0 10px;
                            background:#f7f9fc;
                            border:1px solid #d6e0ec;
                            border-radius:6px;
                            box-sizing:border-box;
                        ">

                        <label
                            value="▱"
                            style="
                                font-size:17px;
                                color:#526b8a;
                                margin-right:9px;
                            "/>

                        <label
                            id="lblRejectBatch"
                            value="-"
                            style="
                                font-size:14px;
                                font-weight:600;
                                color:#173b63;
                            "/>

                    </div>

                </div>


                <!-- CHEQUE NUMBER -->

                <div style="flex:1;">

                    <label
                        value="CHEQUE NUMBER"
                        style="
                            display:block;
                            margin-bottom:5px;
                            font-size:11px;
                            font-weight:700;
                            color:#526b8a;
                        "/>

                    <div
                        style="
                            height:42px;
                            display:flex;
                            align-items:center;
                            padding:0 10px;
                            background:#f7f9fc;
                            border:1px solid #d6e0ec;
                            border-radius:6px;
                            box-sizing:border-box;
                        ">

                        <label
                            value="▣"
                            style="
                                font-size:17px;
                                color:#526b8a;
                                margin-right:9px;
                            "/>

                        <label
                            id="lblRejectCheque"
                            value="-"
                            style="
                                font-size:14px;
                                font-weight:600;
                                color:#173b63;
                            "/>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- REJECTION REASON -->
            <!-- ================================================= -->

            <div
                style="
                    width:100%;
                    margin-bottom:16px;
                ">

                <label
                    value="REJECTION REASON"
                    style="
                        display:block;
                        margin-bottom:5px;
                        font-size:11px;
                        font-weight:700;
                        color:#526b8a;
                    "/>

                <combobox
                    id="cmbRejectReason"
                    width="100%"
                    height="42px"
                    placeholder="Select rejection reason"
                    readonly="true"
                    style="
                        width:100%;
                        height:42px;
                        margin:0;
                        padding:0;
                        border:none !important;
                        background:transparent !important;
                        box-shadow:none !important;
                        outline:none !important;
                    "/>

            </div>


            <!-- ================================================= -->
            <!-- REMARKS -->
            <!-- ================================================= -->

            <div>

                <label
                    value="REMARKS"
                    style="
                        display:block;
                        margin-bottom:5px;
                        font-size:11px;
                        font-weight:700;
                        color:#526b8a;
                    "/>

                <textbox
                    id="txtRejectRemarks"
                    multiline="true"
                    rows="3"
                    width="100%"
                    placeholder="Enter rejection remarks..."
                    style="
                        width:100%;
                        height:80px;
                        min-height:80px;
                        padding:10px;
                        box-sizing:border-box;
                        border:1px solid #c9d9eb !important;
                        border-radius:6px !important;
                        background:#ffffff !important;
                        font-size:13px;
                        color:#173b63;
                        outline:none;
                        box-shadow:none;
                    "/>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <div
            style="
                display:flex;
                justify-content:flex-end;
                align-items:center;
                gap:10px;
                width:100%;
                padding:13px 22px;
                border-top:1px solid #e4eaf1;
                background:#ffffff;
                box-sizing:border-box;
                white-space:nowrap;
            ">


            <!-- ================================================= -->
            <!-- CANCEL BUTTON -->
            <!-- ================================================= -->

            <button
                id="btnRejectCancel"
                label="CANCEL"
                style="
                    width:85px !important;
                    min-width:85px !important;
                    max-width:85px !important;
                    height:34px !important;
                    min-height:34px !important;
                    padding:0 !important;
                    margin:0;
                    box-sizing:border-box;

                    background:#ffffff !important;
                    background-color:#ffffff !important;

                    color:#173b63 !important;

                    border:1px solid #173b63 !important;
                    border-radius:5px !important;

                    font-size:12px !important;
                    font-weight:600 !important;

                    cursor:pointer;
                    text-align:center;
                    white-space:nowrap;
                    overflow:visible;
                "/>


            <!-- ================================================= -->
            <!-- REJECT CHEQUE BUTTON -->
            <!-- ================================================= -->

            <button
                id="btnRejectConfirm"
                label="REJECT CHEQUE"
                style="
                    width:125px !important;
                    min-width:125px !important;
                    max-width:125px !important;
                    height:34px !important;
                    min-height:34px !important;
                    padding:0 !important;
                    margin:0;
                    box-sizing:border-box;

                    background:#173b63 !important;
                    background-color:#173b63 !important;

                    color:#ffffff !important;

                    border:1px solid #173b63 !important;
                    border-radius:5px !important;

                    font-size:12px !important;
                    font-weight:600 !important;

                    cursor:pointer;
                    text-align:center;
                    white-space:nowrap;
                    overflow:visible;
                "/>

        </div>

    </window>

</zk>