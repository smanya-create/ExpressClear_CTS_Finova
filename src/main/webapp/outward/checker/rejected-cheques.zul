<?page title="ExpressClear CTS - Rejected Cheques" contentType="text/html;charset=UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/outward/rejected-cheques.css"?>

<zk>
    <borderlayout apply="com.iispl.cts.controller.outward.checker.OutwardCheckerRejectionController"
                  hflex="1" vflex="1" style="overflow: hidden !important;">

        <!-- ================= SIDEBAR ================= -->
        <west width="220px"
              border="none"
              collapsible="false"
              splittable="false">
            <include src="/components/sidebar.zul"
                     role="OUTWARD_CHECKER"
                     activeTab="outward-rejected-cheques"
                     hflex="1" vflex="1" />
        </west>

        <!-- ================= MAIN WORKSPACE (LOCKED ZERO SCROLL) ================= -->
        <center border="none" autoscroll="false" style=" overflow: hidden !important;">
            <vlayout spacing="0" hflex="1" vflex="1" style="overflow: hidden !important;">

                <!-- Shared Application Header -->
                <include id="incHeader" src="/components/header.zul"
                         pageTitle="Outward Checker"
                         pageSubtitle="Rejected Cheques" />

                <!-- Modal Window Host -->
                <vlayout id="windowHost" spacing="0"/>

                <!-- Content Area -->
                <vlayout spacing="12px" style="padding: 16px 24px; overflow: hidden !important;" hflex="1" vflex="1">

                    <!-- PAGE HEADING -->
                    <vlayout spacing="2px">
                        <label value="Rejected Cheques" sclass="section-title"/>
                        <label value="Only individual cheques rejected by the Checker are listed here."
                               sclass="section-description"/>
                    </vlayout>

                    <!-- ================= SUMMARY CARD ================= -->
                    <hlayout sclass="summary-card" hflex="1" valign="middle">
                        <vlayout sclass="summary-item" spacing="2px">
                            <label value="TOTAL REJECTED CHEQUES" sclass="summary-label"/>
                            <label id="lblTotalRejected" value="0" sclass="summary-number"/>
                        </vlayout>

                        
                    </hlayout>

                    <!-- ================= SEARCH BAR ================= -->
                    <hlayout sclass="search-card" hflex="1" valign="bottom">
                        <vlayout sclass="search-field" hflex="1" spacing="4px">
                            <label value="SEARCH" sclass="field-label"/>
                            <textbox id="txtSearch"
                                     placeholder="Search batch or cheque number..."
                                     hflex="1"
                                     sclass="search-input"/>
                        </vlayout>

                        <vlayout sclass="search-field date-field" width="200px" spacing="4px">
                            <label value="DATE" sclass="field-label"/>
                            <datebox id="dateRejected"
                                     format="dd-MM-yyyy"
                                     placeholder="Select rejected date"
                                     hflex="1"
                                     buttonVisible="true"
                                     sclass="search-datebox"/>
                        </vlayout>

                        <button id="btnSearch" label="SEARCH" sclass="search-button"/>
                        <button id="btnClear" label="CLEAR" sclass="clear-button"/>
                    </hlayout>

                    <!-- ================= TABLE SECTION ================= -->
                    <vlayout sclass="table-card" hflex="1" vflex="1" spacing="8px" style="min-height: 0; overflow: hidden !important;">
                        <vlayout sclass="list-title-section" spacing="1px">
                            <label value="Rejected Cheques List" sclass="list-title"/>
                            <label value="List of cheques rejected by the Checker" sclass="list-subtitle"/>
                        </vlayout>

                        <!-- Exclusively scrollable listbox -->
                        <listbox id="lstRejectedCheques"
                                 hflex="1"
                                 vflex="1"
                                 emptyMessage="No rejected cheques found."
                                 sclass="rejected-listbox">
                            <listhead sizable="false">
                                <listheader label="BATCH ID" width="16%" align="center"/>
                                <listheader label="CHEQUE NUMBER" width="16%" align="center"/>
                                <listheader label="AMOUNT" width="15%" align="center"/>
                                <listheader label="REJECTION REASON" width="25%" align="center"/>
                                <listheader label="REJECTED ON" width="16%" align="center"/>
                                <listheader label="ACTION" width="12%" align="center"/>
                            </listhead>
                        </listbox>

                        <!-- PAGINATION -->
                        <hlayout sclass="pagination-bar" hflex="1" valign="middle">
                            <button id="btnFirst" label="«" sclass="pagination-button"/>
                            <button id="btnPrevious" label="‹" sclass="pagination-button"/>
                            <intbox id="ibCurrentPage" value="1" sclass="pagination-input"/>
                            <label id="lblTotalPages" value="/ 1" sclass="pagination-total"/>
                            <button id="btnNext" label="›" sclass="pagination-button"/>
                            <button id="btnLast" label="»" sclass="pagination-button"/>
                        </hlayout>
                    </vlayout>

                </vlayout>
            </vlayout>
        </center>
    </borderlayout>
</zk>