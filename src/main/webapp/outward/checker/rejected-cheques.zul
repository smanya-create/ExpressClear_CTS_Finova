<?page title="Rejected Cheques" contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet"
        type="text/css"
        href="/css/outward/rejected-cheques.css"?>

<zk>
    <borderlayout apply="com.iispl.cts.controller.outward.checker.OutwardCheckerRejectionController"
                  hflex="1" vflex="1">

        <!-- ================= SIDEBAR ================= -->
        <west width="220px"
              border="none"
              collapsible="false"
              splittable="false">
            <include src="/components/sidebar.zul"
                     role="OUTWARD_CHECKER"
                     activeTab="outward-rejected-cheques"
                     hflex="1" vflex="1" />
        </west>

        <!-- ================= MAIN WORKSPACE ================= -->
        <center border="none" autoscroll="true" style="background-color: #f8fafc;">
            <vlayout spacing="0" hflex="1">

                <!-- Shared Application Header -->
                <include id="incHeader" src="/components/header.zul"
                         pageTitle="Outward Checker"
                         pageSubtitle="Rejected Cheques" />

                <!-- Modal Window Host -->
                <div id="windowHost"/>

                <!-- Content Area -->
                <vlayout spacing="20px" style="padding: 24px;" hflex="1">

                    <!-- PAGE HEADING -->
                    <vlayout spacing="4px">
                        <label value="Rejected Cheques" sclass="section-title"/>
                        <label value="Only individual cheques rejected by the Checker are listed here."
                               sclass="section-description"/>
                    </vlayout>

                    <!-- ================= SUMMARY CARD ================= -->
                    <div sclass="summary-card">
                        <div sclass="summary-item">
                            <label value="TOTAL REJECTED CHEQUES" sclass="summary-label"/>
                            <label id="lblTotalRejected" value="0" sclass="summary-number"/>
                        </div>

                        <div sclass="summary-divider"/>

                        <div sclass="summary-item source-item">
                            <label value="SOURCE" sclass="summary-label"/>
                            <label value="Checker Queue" sclass="summary-value"/>
                        </div>
                    </div>

                    <!-- ================= SEARCH BAR ================= -->
                    <div sclass="search-card">
                        <div sclass="search-field">
                            <label value="SEARCH" sclass="field-label"/>
                            <textbox id="txtSearch"
                                     placeholder="Batch or cheque number"
                                     width="100%"
                                     sclass="search-input"/>
                        </div>

                        <div sclass="search-field date-field">
                            <label value="DATE" sclass="field-label"/>
                            <datebox id="dateRejected"
                                     format="dd-MM-yyyy"
                                     placeholder="Select rejected date"
                                     width="180px"
                                     buttonVisible="true"/>
                        </div>

                        <button id="btnSearch" label="SEARCH" sclass="search-button"/>
                        <button id="btnClear" label="CLEAR" sclass="clear-button"/>
                    </div>

                    <!-- ================= TABLE SECTION ================= -->
                    <div sclass="table-card" width="100%">
                        <div sclass="list-title-section">
                            <label value="Rejected Cheques List" sclass="list-title"/>
                            <label value="List of cheques rejected by the Checker" sclass="list-subtitle"/>
                        </div>

                        <listbox id="lstRejectedCheques"
                                 width="100%"
                                 height="340px"
                                 emptyMessage="No rejected cheques found."
                                 sclass="rejected-listbox">
                            <listhead sizable="false">
                                <listheader label="BATCH ID" width="15%"/>
                                <listheader label="CHEQUE NUMBER" width="17%"/>
                                <listheader label="AMOUNT" width="15%"/>
                                <listheader label="REJECTION REASON" width="25%"/>
                                <listheader label="REJECTED ON" width="15%"/>
                                <listheader label="ACTION" width="13%"/>
                            </listhead>
                        </listbox>

                        <!-- PAGINATION -->
                        <div sclass="pagination-bar">
                            <button id="btnFirst" label="|&lt;" sclass="pagination-button"/>
                            <button id="btnPrevious" label="&lt;" sclass="pagination-button"/>
                            <label id="lblPageInfo" value="Page 1" sclass="page-info"/>
                            <button id="btnNext" label="&gt;" sclass="pagination-button"/>
                            <button id="btnLast" label="&gt;|" sclass="pagination-button"/>
                        </div>

                        <!-- IMPORTANT NOTE -->
                        <div sclass="important-box">
                            <label value="IMPORTANT" sclass="important-title"/>
                            <label value="Rejected Files contains only rejected individual cheques. The complete batch is not moved here."
                                   sclass="important-text"/>
                        </div>
                    </div>

                    <!-- ================= FOOTER ================= -->
                    <div sclass="hardcoded-footer" width="100%">
                        <label value="Express Clear CTS · Checker Portal" sclass="footer-left"/>
                        <label value="Rejected Cheques" sclass="footer-right"/>
                    </div>

                </vlayout>
            </vlayout>
        </center>
    </borderlayout>
</zk>