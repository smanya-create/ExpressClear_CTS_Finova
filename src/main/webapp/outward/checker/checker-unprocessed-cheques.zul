<?xml version="1.0" encoding="UTF-8"?>
<?style src="/css/cts-unprocessed.css"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <!-- Top-Level Layout: Full Height Sidebar on Left, Content on Right -->
    <borderlayout vflex="1" hflex="1">
        
        <!-- Full-Height Checker Sidebar -->
        <west width="240px" border="none" collapsible="false">
            <include src="/components/sidebar.zul" role="OUTWARD_CHECKER" activeTab="unprocessed" />
        </west>

        <!-- Right View Container -->
        <center border="none">
            <borderlayout vflex="1" hflex="1">
                
                <!-- Inner North: Header pinned on top -->
                <north size="65px" border="none">
                    <include id="incHeader" src="/components/header.zul" 
                             pageTitle="Outward Checker" 
                             pageSubtitle="Unprocessed Cheques" />
                </north>

                <!-- Inner Center: Checker Workspace -->
                <center border="none" autoscroll="true">
                    <window id="winCheckerUnprocessed" border="none" vflex="1" hflex="1"
                            apply="com.iispl.cts.controller.outward.checker.CheckerUnprocessedChequesController"
                            style="padding: 20px 24px; background: #f8fafc;">

                        <vlayout spacing="16px" vflex="1">
                            <!-- Page Title Banner -->
                            <vlayout spacing="4px">
                                <hlayout valign="middle" style="display: flex; justify-content: space-between; width: 100%;">
                                    <vlayout spacing="2px">
                                        <label value="Checker Forced EOD Rollover Cheques" sclass="page-heading"/>
                                        <label value="Rollover instruments requiring Checker verification before inclusion in the outward clearing session." sclass="page-subheading"/>
                                    </vlayout>
                                    <button id="btnRefresh" label="Refresh Verification Queue" iconSclass="z-icon-refresh"
                                            sclass="btn-refresh"
                                            onClick="$composer.loadCheckerUnprocessedCheques()"/>
                                </hlayout>
                            </vlayout>

                            <!-- Summary Metrics Cards -->
                            <hlayout spacing="16px" width="100%">
                                <hlayout sclass="stat-card" hflex="1" valign="middle" style="justify-content: space-between;">
                                    <vlayout spacing="2px">
                                        <label value="PENDING VERIFICATIONS" sclass="stat-card-title text-blue"/>
                                        <label id="lblTotalVerifyCount" value="0" sclass="stat-card-value text-blue"/>
                                    </vlayout>
                                    <label sclass="z-icon-check-square-o icon-blue"/>
                                </hlayout>

                                <hlayout sclass="stat-card" hflex="1" valign="middle" style="justify-content: space-between;">
                                    <vlayout spacing="2px">
                                        <label value="TOTAL AMOUNT TO VERIFY" sclass="stat-card-title text-dark"/>
                                        <label id="lblTotalVerifyAmount" value="₹ 0.00" sclass="stat-card-value text-dark"/>
                                    </vlayout>
                                    <label sclass="z-icon-inr icon-gray"/>
                                </hlayout>
                            </hlayout>

                            <!-- Search Bar -->
                            <hlayout spacing="12px" valign="middle" sclass="filter-bar">
                                <label value="Search Cheque / Batch:" sclass="filter-label"/>
                                <textbox id="txtSearchBatch" placeholder="Search Batch Reference / Cheque No..." width="280px"
                                         onOK="$composer.onFilterChanged()" instant="true"/>
                            </hlayout>

                            <!-- Checker Cheque Verification Grid -->
                            <listbox id="lstCheckerUnprocessed" vflex="1" mold="paging" pageSize="12"
                                     emptyMessage="No Forced EOD rollover cheques pending for Checker verification.">
                                <listhead sizable="true">
                                    <listheader label="Original Batch / Session" width="240px"/>
                                    <listheader label="Cheque No" width="120px"/>
                                    <listheader label="MICR Code" width="120px"/>
                                    <listheader label="Amount" width="140px" align="right"/>
                                    <listheader label="Required Task" width="180px"/>
                                    <listheader label="Reason / Remarks" hflex="1"/>
                                    <listheader label="Action" width="120px" align="center"/>
                                </listhead>
                            </listbox>
                        </vlayout>
                    </window>
                </center>
            </borderlayout>
        </center>
    </borderlayout>
</zk>