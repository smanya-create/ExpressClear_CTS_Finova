<?xml version="1.0" encoding="UTF-8"?>
<?page title="ExpressClear CTS - Checker Unprocessed Cheques"?>
<?link rel="stylesheet" type="text/css" href="/css/cts-unprocessed.css"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <!-- Top-Level Layout: Sidebar on Left, Work Area on Right -->
    <borderlayout vflex="1" hflex="1">
        
        <!-- Sidebar -->
        <west width="240px" border="none" collapsible="false">
            <include src="/components/sidebar.zul" role="OUTWARD_CHECKER" activeTab="unprocessed" />
        </west>

        <!-- Right Workspace -->
        <center border="none">
            <borderlayout vflex="1" hflex="1">
                
                <!-- Header Component -->
                <north size="80px" border="none">
                    <include id="incHeader" src="/components/header.zul" 
                             pageTitle="Outward Checker" 
                             pageSubtitle="Unprocessed Cheques" />
                </north>

                <!-- Checker Content Area -->
                <center border="none" autoscroll="true">
                    <window id="winCheckerUnprocessed" border="none" vflex="1" hflex="1"
                            apply="com.iispl.cts.controller.outward.checker.CheckerUnprocessedChequesController"
                            style="padding: 20px 24px; ">

                        <vlayout spacing="16px" vflex="1">
                            
                            <!-- Page Title Banner -->
                            <vlayout spacing="4px">
                                <hlayout valign="middle" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                    <vlayout spacing="2px">
                                        <label value="Checker Forced EOD Rollover Cheques" sclass="page-heading"/>
                                        <label value="Rollover instruments requiring Checker verification before inclusion in the outward clearing session." sclass="page-subheading"/>
                                    </vlayout>
                                    
                                    <button id="btnRefreshQueue" 
                                            iconSclass="z-icon-refresh" 
                                            tooltiptext="Refresh Verification Queue" 
                                            sclass="btn-icon-refresh"/>
                                </hlayout>
                            </vlayout>

                            <!-- Summary Metric Cards -->
                            <hlayout spacing="16px" width="100%">
                                <hlayout hflex="1" valign="middle" sclass="stat-card">
                                    <vlayout spacing="4px">
                                        <label value="PENDING VERIFICATIONS" sclass="stat-card-title"/>
                                        <label id="lblTotalVerifyCount" value="0" sclass="stat-card-value"/>
                                    </vlayout>
                                </hlayout>

                                <hlayout hflex="1" valign="middle" sclass="stat-card">
                                    <vlayout spacing="4px">
                                        <label value="TOTAL AMOUNT TO VERIFY" sclass="stat-card-title"/>
                                        <label id="lblTotalVerifyAmount" value="₹ 0.00" sclass="stat-card-value"/>
                                    </vlayout>
                                </hlayout>
                            </hlayout>

                            <!-- Search Filter Bar -->
                            <hlayout spacing="12px" valign="middle" sclass="filter-bar">
                                <label value="Search Cheque / Batch:" sclass="filter-label"/>
                                <textbox id="txtSearchBatch" 
                                         placeholder="Search Batch Reference / Cheque No..." 
                                         width="280px"
                                         sclass="search-input"/>
                                
                                <button id="btnSearch" 
                                        label="Search" 
                                        sclass="btn-primary-action"/>
                                        
                                <button id="btnReset" 
                                        label="Reset" 
                                        sclass="btn-secondary-action"/>
                            </hlayout>

                            <!-- Checker Verification Grid -->
                            <listbox id="lstCheckerUnprocessed" 
                                     sclass="unprocessed-box"
                                     vflex="1" 
                                     emptyMessage="No Forced EOD rollover cheques pending for Checker verification.">
                                <listhead sizable="false">
                                    <listheader label="BATCH ID" width="230px" align="center"/>
                                    <listheader label="CHEQUE NO" width="120px" align="center"/>
                                    <listheader label="MICR CODE" width="130px" align="center"/>
                                    <listheader label="AMOUNT (INR)" width="150px" align="center"/>
                                    <listheader label="STATUS" width="180px" align="center"/>
                                    <listheader label="REASON / REMARKS" hflex="1" align="center"/>
                                    <listheader label="ACTION" width="165px" align="center"/>
                                </listhead>
                            </listbox>

                            <!-- ZK-Native Pagination Toolbar -->
                            <div sclass="pagination-toolbar-wrapper">
                                <div sclass="pagination-controls-box">
                                    <button id="btnFirstPage" label="«" sclass="pagination-btn" tooltiptext="First Page" />
                                    <button id="btnPrevPage" label="‹" sclass="pagination-btn" tooltiptext="Previous Page" />
                                    <intbox id="ibCurrentPage" value="1" sclass="pagination-input" />
                                    <label id="lblTotalPages" value="/ 1" sclass="pagination-slash-label" />
                                    <button id="btnNextPage" label="›" sclass="pagination-btn" tooltiptext="Next Page" />
                                    <button id="btnLastPage" label="»" sclass="pagination-btn" tooltiptext="Last Page" />
                                </div>
                            </div>

                        </vlayout>
                    </window>
                </center>
            </borderlayout>
        </center>
    </borderlayout>
</zk>