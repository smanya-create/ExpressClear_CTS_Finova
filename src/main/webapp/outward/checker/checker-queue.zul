<?xml version="1.0" encoding="UTF-8"?>

<?page
    title="Express Clear CTS - Checker Queue"
    contentType="text/html;charset=UTF-8"
?>

<?link
    rel="stylesheet"
    type="text/css"
    href="/css/outward/checker-queue.css"
/?>

<zk>

    <borderlayout
        id="checkerQueueRoot"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.OutwardCheckerQueueController"
        sclass="checker-queue-root">

        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <west
            size="220px"
            border="none"
            splittable="false"
            collapsible="false">

            <include
                src="/components/sidebar.zul"
                role="OUTWARD_CHECKER"
                activeTab="checker-queue"/>

        </west>


        <!-- =====================================================
             MAIN AREA
             ===================================================== -->

        <center
            border="none"
            autoscroll="false">

            <borderlayout
                width="100%"
                height="100%">

                <!-- =================================================
                     COMMON HEADER
                     ================================================= -->

                <north
                    id="checkerQueueHeaderArea"
                    size="84px"
                    border="none"
                    style="margin:0 !important;
                           padding:0 !important;
                           overflow:hidden;">

                    <include
                        id="headerInclude"
                        src="/components/header.zul"
                        pageTitle="Outward Process"
                        hflex="1"
                        vflex="1"/>

                </north>


                <!-- =================================================
                     CONTENT
                     ================================================= -->

                <center
                    border="none"
                    autoscroll="false">

                    <div
                        width="100%"
                        height="100%"
                        sclass="content-wrapper">


                        <!-- =================================================
                             NO BATCH MESSAGE
                             ================================================= -->

                        <vlayout
                            id="noBatchMessage"
                            visible="false"
                            width="100%"
                            height="100%"
                            style="align-items:center;
                                   justify-content:center;">

                            <vlayout
                                spacing="15px"
                                style="text-align:center;">

                                <label
                                    value="No batch has been selected."
                                    style="font-size:24px;
                                           font-weight:bold;"/>

                                <label
                                    value="Please select a batch from the Checker Dashboard."
                                    style="font-size:15px;"/>

                                <button
                                    id="btnBackToDashboard"
                                    label="BACK TO DASHBOARD"
                                    sclass="back-dashboard-button"/>

                            </vlayout>

                        </vlayout>


                        <!-- =================================================
                             CHECKER QUEUE CONTENT
                             ================================================= -->

                        <div
                            id="checkerQueueContent"
                            sclass="main-page"
                            visible="false">

                            <div sclass="main-content">


                                <!-- =================================================
                                     VERIFICATION HEADER + PAGINATION
                                     ================================================= -->

                                <div sclass="queue-header-row">

                                    <div sclass="section-heading">

                                        <label
                                            value="VERIFICATION"
                                            sclass="main-title"/>

                                    </div>


                                    <!-- PAGINATION -->

                                    <div sclass="pagination-card">

                                        <div sclass="progress-section">

                                            <progressmeter
                                                id="progressBar"
                                                value="0"
                                                sclass="queue-progress-bar"/>

                                            <label
                                                id="lblProgress"
                                                value="0/0 (0%)"
                                                sclass="progress-text"/>

                                        </div>


                                        <div sclass="pagination-divider"/>


                                        <button
                                            id="btnPrevious"
                                            label="‹ Prev"
                                            disabled="true"
                                            sclass="pagination-button"/>


                                        <label
                                            id="lblCurrentChequeNavigation"
                                            value="0 of 0"
                                            sclass="pagination-count"/>


                                        <button
                                            id="btnNext"
                                            label="Next ›"
                                            sclass="pagination-button"/>

                                    </div>

                                </div>


                                <!-- =================================================
                                     SUMMARY
                                     ================================================= -->

                                <div sclass="summary-card">

                                    <!-- BATCH ID -->

                                    <div sclass="summary-item">

                                        <label
                                            value="BATCH ID"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblBatchNo"
                                            value="-"
                                            sclass="summary-value"/>

                                    </div>


                                    <!-- CHEQUE COUNT -->

                                    <div sclass="summary-item">

                                        <label
                                            value="CHEQUE COUNT"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblChequeCount"
                                            value="0"
                                            sclass="summary-value"/>

                                    </div>


                                    <!-- CHEQUE NUMBER -->

                                    <div sclass="summary-item">

                                        <label
                                            value="CHEQUE NUMBER"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblChequeNo"
                                            value="-"
                                            sclass="summary-value"/>

                                    </div>


                                    <!-- CHEQUE STATUS -->

                                    <div sclass="summary-item">

                                        <label
                                            value="CHEQUE STATUS"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblQueueStatus"
                                            value="-"
                                            sclass="status-pending"/>

                                    </div>


                                    <!-- CURRENT CHEQUE -->

                                    <div sclass="summary-item">

                                        <label
                                            value="CURRENT CHEQUE"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblCurrentCheque"
                                            value="-"
                                            sclass="summary-value"/>

                                    </div>


                                    <!-- REMAINING -->

                                    <div sclass="summary-item last">

                                        <label
                                            value="REMAINING"
                                            sclass="summary-label"/>

                                        <label
                                            id="lblRemaining"
                                            value="0"
                                            sclass="remaining-value"/>

                                    </div>

                                </div>


                                <!-- =================================================
                                     VERIFICATION ROW
                                     ================================================= -->

                                <div sclass="verification-row">


                                    <!-- =================================================
                                         CHEQUE IMAGE CARD
                                         ================================================= -->

                                    <div sclass="image-card">

                                        <!-- IMAGE HEADER -->

                                        <div sclass="image-card-header">

                                            <div sclass="image-title-area">

                                                <label
                                                    value="Cheque Image"
                                                    sclass="card-title"/>

                                                <label
                                                    value="Read-only image for visual verification"
                                                    sclass="card-description"/>

                                            </div>


                                            <button
                                                id="btnImageSide"
                                                label="BACK SIDE"
                                                sclass="image-side-button"/>

                                        </div>


                                        <!-- CHEQUE IMAGE -->

                                        <div sclass="cheque-image-container">

                                            <image
                                                id="imgCheque"
                                                sclass="cheque-image"/>

                                        </div>


                                        <!-- ZOOM CONTROLS -->

                                        <div sclass="zoom-controls">

                                            <button
                                                id="btnZoomOut"
                                                label="−"
                                                sclass="zoom-button"
                                                tooltiptext="Zoom Out"/>


                                            <label
                                                id="lblZoom"
                                                value="100%"
                                                sclass="zoom-level"/>


                                            <button
                                                id="btnZoomIn"
                                                label="+"
                                                sclass="zoom-button"
                                                tooltiptext="Zoom In"/>


                                            <button
                                                id="btnZoomReset"
                                                label="Reset"
                                                sclass="zoom-reset-button"
                                                tooltiptext="Reset Zoom"/>

                                        </div>

                                    </div>


                                    <!-- =================================================
                                         CHEQUE DETAILS CARD
                                         ================================================= -->

                                    <div sclass="details-card">


                                        <!-- =================================================
                                             DETAILS HEADER
                                             ================================================= -->

                                        <div sclass="details-card-header">

                                            <div sclass="details-card-title-area">

                                                <label
                                                    value="Cheque Details"
                                                    sclass="card-title"/>

                                                <label
                                                    value="Read-only · Submitted by Maker"
                                                    sclass="card-description"/>

                                            </div>


                                            <label
                                                id="lblAccountValidation"
                                                value="NOT VERIFIED"
                                                sclass="validation-pending-badge"/>

                                        </div>


                                        <!-- =================================================
                                             FIXED MAKER REJECTION / WARNING AREA

                                             IMPORTANT:
                                             Keep visible="true".
                                             This reserves fixed space so the
                                             action buttons do not move when
                                             clicking NEXT/PREV.
                                             ================================================= -->

                                        <vlayout
                                            id="makerRejectionRequestSection"
                                            visible="true"
                                            spacing="3px"
                                            style="width:100%;
                                                   height:85px;
                                                   min-height:85px;
                                                   max-height:85px;
                                                   margin:3px 0 7px 0;
                                                   padding:7px 9px;
                                                   background:#FFF7ED;
                                                   border-left:3px solid #F59E0B;
                                                   border-radius:3px;
                                                   box-sizing:border-box;
                                                   overflow:hidden;
                                                   flex-shrink:0;">

                                            <label
                                                id="lblMakerStatusHeading"
                                                value=""
                                                style="font-size:10px;
                                                       font-weight:700;
                                                       color:#B45309;"/>


                                            <label
                                                id="lblMakerRejectionReasonCode"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>


                                            <label
                                                id="lblMakerRejectionReasonName"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>


                                            <label
                                                id="lblMakerRejectionRemarks"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>

                                        </vlayout>


                                        <!-- =================================================
                                             CHEQUE NUMBER + MICR
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="CHEQUE NUMBER"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtChequeNo"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="MICR"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtMicr"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             PAYEE + ACCOUNT
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="PAYEE NAME"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtpayeeName"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="PAYEE ACCOUNT NUMBER"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtAccountNo"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             AMOUNT + DATE
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="AMOUNT"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtAmount"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="CHEQUE DATE"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtChequeDate"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             CHECKER ACTION AREA
                                             ================================================= -->

                                        <div sclass="details-action-area">

                                            <label
                                                value="CHECKER ACTION"
                                                sclass="details-action-title"/>


                                            <div sclass="details-action-buttons">

                                                <!-- VERIFY -->

                                                <button
                                                    id="btnVerified"
                                                    label="VERIFY"
                                                    sclass="verified-button"/>


                                                <!-- RETURN TO MAKER -->

                                                <button
                                                    id="btnReturn"
                                                    label="RETURN TO MAKER"
                                                    sclass="return-button"/>


                                                <!-- REJECT -->

                                                <button
                                                    id="btnReject"
                                                    label="REJECT"
                                                    sclass="reject-button"/>

                                            </div>


                                            <!-- APPROVE BATCH -->

                                            <button
                                                id="btnXmlGeneration"
                                                label="APPROVE BATCH"
                                                sclass="xml-generation-button"
                                                disabled="true"/>

                                        </div>

                                    </div>

                                </div>


                                <!-- =================================================
                                     FOOTER
                                     ================================================= -->

                                <div sclass="page-footer">

                                    <label
                                        value="Express Clear CTS · Checker Portal"
                                        sclass="footer-left"/>


                                    <label
                                        value="Cheque Verification"
                                        sclass="footer-right"/>

                                </div>

                            </div>

                        </div>

                    </div>

                </center>

            </borderlayout>

        </center>

    </borderlayout>

</zk>