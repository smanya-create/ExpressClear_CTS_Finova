<?xml version="1.0" encoding="UTF-8"?>

<?page title="Express Clear CTS - Checker Queue"
        contentType="text/html;charset=UTF-8"?>

<?link rel="stylesheet"
        type="text/css"
        href="/css/outward/checker-queue.css"?>

<zk>

    <!-- =========================================================
         ROOT BORDERLAYOUT
         ========================================================= -->

    <borderlayout
        id="checkerQueueRoot"
        width="100%"
        height="100%"
        apply="com.iispl.cts.controller.outward.checker.OutwardCheckerQueueController"
        sclass="checker-queue-root">

        <!-- =====================================================
             LEFT SIDEBAR
             ===================================================== -->

        <west
            size="220px"
            border="none"
            splittable="false"
            collapsible="false">

            <include
                src="/components/sidebar.zul"
                role="OUTWARD_CHECKER"
                activeTab="checker-queue"/>

        </west>


        <!-- =====================================================
             RIGHT SIDE
             ===================================================== -->

        <center
            border="none"
            autoscroll="false">

            <borderlayout
                width="100%"
                height="100%">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <north
                    height="60px"
                    border="none">

                    <div sclass="page-header">

                        <div sclass="header-left-content">

                            <label
                                value="Cheque Verification"
                                sclass="header-page-title"/>

                            <label
                                value="Review the cheque and verify the read-only details submitted by Maker."
                                sclass="header-page-description"/>

                        </div>


                        <div sclass="header-right-content">

                            <include
                                src="/components/header.zul"/>

                        </div>

                    </div>

                </north>


                <!-- =================================================
                     MAIN CONTENT
                     ================================================= -->

                <center
                    border="none"
                    autoscroll="false">

                    <div
                        width="100%"
                        height="100%"
                        sclass="content-wrapper">

                        <!-- =================================================
                             NO BATCH MESSAGE
                             ================================================= -->

                        <vlayout
                            id="noBatchMessage"
                            visible="false"
                            width="100%"
                            height="100%"
                            style="align-items:center;justify-content:center;">

                            <vlayout
                                spacing="15px"
                                style="text-align:center;">

                                <label
                                    value="No batch has been selected."
                                    style="font-size:24px;font-weight:bold;"/>

                                <label
                                    value="Please select a batch from the Checker Dashboard."
                                    style="font-size:15px;"/>

                                <button
                                    id="btnBackToDashboard"
                                    label="BACK TO DASHBOARD"
                                    sclass="back-dashboard-button"/>

                            </vlayout>

                        </vlayout>


                        <!-- =================================================
                             CHECKER QUEUE CONTENT
                             ================================================= -->

                        <div
                            id="checkerQueueContent"
                            sclass="main-page"
                            visible="false">

                            <div sclass="main-content">

                                <!-- =================================================
                                     QUEUE HEADER + PAGINATION
                                     ================================================= -->

                                <div sclass="queue-header-row">

                                    <!-- LEFT : HEADING -->

                                    <div sclass="section-heading">

                                        <label
                                            value="Cheque Queue"
                                            sclass="main-title"/>

                                    </div>


                                    <!-- RIGHT : PAGINATION -->

                                    <div sclass="pagination-card">

                                        <!-- PROGRESS -->

                                        <div sclass="progress-section">

                                            <progressmeter
                                                id="progressBar"
                                                value="0"
                                                sclass="queue-progress-bar"/>

                                            <label
                                                id="lblProgress"
                                                value="0/0 (0%)"
                                                sclass="progress-text"/>

                                        </div>


                                        <!-- DIVIDER -->

                                        <div sclass="pagination-divider"/>


                                        <!-- PREVIOUS -->

                                        <button
                                            id="btnPrevious"
                                            label="‹ Prev"
                                            disabled="true"
                                            sclass="pagination-button"/>


                                        <!-- CURRENT -->

                                        <label
                                            id="lblCurrentChequeNavigation"
                                            value="0 of 0"
                                            sclass="pagination-count"/>


                                        <!-- NEXT -->

                                        <button
                                            id="btnNext"
                                            label="Next ›"
                                            sclass="pagination-button"/>

                                    </div>

                                </div>


                               <!-- =================================================
     SUMMARY CARD
     ================================================= -->

<div sclass="summary-card">

    <!-- =================================================
         1. BATCH ID
         ================================================= -->

    <div sclass="summary-item">

        <label
            value="BATCH ID"
            sclass="summary-label"/>

        <label
            id="lblBatchNo"
            value="-"
            sclass="summary-value"/>

    </div>


    <!-- =================================================
         2. CHEQUE COUNT
         ================================================= -->

    <div sclass="summary-item">

        <label
            value="CHEQUE COUNT"
            sclass="summary-label"/>

        <label
            id="lblChequeCount"
            value="0"
            sclass="summary-value"/>

    </div>


    <!-- =================================================
         3. CHEQUE NUMBER
         ================================================= -->

    <div sclass="summary-item">

        <label
            value="CHEQUE NUMBER"
            sclass="summary-label"/>

        <label
            id="lblChequeNo"
            value="-"
            sclass="summary-value"/>

    </div>


    <!-- =================================================
         4. CHEQUE STATUS
         ================================================= -->

    <div sclass="summary-item">

        <label
            value="CHEQUE STATUS"
            sclass="summary-label"/>

        <label
            id="lblQueueStatus"
            value="-"
            sclass="status-pending"/>

    </div>


    <!-- =================================================
         5. CURRENT CHEQUE
         ================================================= -->

    <div sclass="summary-item">

        <label
            value="CURRENT CHEQUE"
            sclass="summary-label"/>

        <label
            id="lblCurrentCheque"
            value="-"
            sclass="summary-value"/>

    </div>


    <!-- =================================================
         6. REMAINING
         ================================================= -->

    <div
        sclass="summary-item last">

        <label
            value="REMAINING"
            sclass="summary-label"/>

        <label
            id="lblRemaining"
            value="0"
            sclass="remaining-value"/>

    </div>

</div>
                                <!-- =================================================
                                     IMAGE + DETAILS ROW
                                     ================================================= -->

                                <div sclass="verification-row">

                                    <!-- =================================================
                                         CHEQUE IMAGE CARD
                                         ================================================= -->

                                    <div sclass="image-card">

                                        <!-- IMAGE HEADER -->

                                        <div sclass="image-card-header">

                                            <div sclass="image-title-area">

                                                <label
                                                    value="Cheque Image"
                                                    sclass="card-title"/>

                                                <label
                                                    value="Read-only image for visual verification"
                                                    sclass="card-description"/>

                                            </div>


                                            <!-- FRONT / BACK -->

                                            <button
                                                id="btnImageSide"
                                                label="BACK SIDE"
                                                sclass="image-side-button"/>

                                        </div>


                                        <!-- =================================================
                                             CHEQUE IMAGE
                                             ================================================= -->

                                        <div
                                            sclass="cheque-image-container">

                                            <image
                                                id="imgCheque"
                                                sclass="cheque-image"/>

                                        </div>


                                        <!-- =================================================
                                             ZOOM CONTROLS
                                             ================================================= -->

                                        <div sclass="zoom-controls">

                                            <button
                                                id="btnZoomOut"
                                                label="−"
                                                sclass="zoom-button"
                                                tooltiptext="Zoom Out"/>

                                            <label
                                                id="lblZoom"
                                                value="100%"
                                                sclass="zoom-level"/>

                                            <button
                                                id="btnZoomIn"
                                                label="+"
                                                sclass="zoom-button"
                                                tooltiptext="Zoom In"/>

                                            <button
                                                id="btnZoomReset"
                                                label="Reset"
                                                sclass="zoom-reset-button"
                                                tooltiptext="Reset Zoom"/>

                                        </div>

                                    </div>


                                    <!-- =================================================
                                         CHEQUE DETAILS CARD
                                         ================================================= -->

                                    <div sclass="details-card">

                                        <!-- DETAILS HEADER -->

                                        <div sclass="details-card-header">

                                            <div sclass="details-card-title-area">

                                                <label
                                                    value="Cheque Details"
                                                    sclass="card-title"/>

                                                <label
                                                    value="Read-only · Submitted by Maker"
                                                    sclass="card-description"/>

                                            </div>


                                            <!-- ACCOUNT VALIDATION -->

                                            <label
                                                id="lblAccountValidation"
                                                value="NOT VERIFIED"
                                                sclass="validation-pending-badge"/>

                                        </div>


                                        <!-- =================================================
                                             MAKER STATUS MESSAGE
                                             ================================================= -->

                                        <vlayout
                                            id="makerRejectionRequestSection"
                                            visible="false"
                                            spacing="3px"
                                            style="margin:5px 0 7px 0;
                                                   padding:7px 9px;
                                                   background:#FFF7ED;
                                                   border-left:3px solid #F59E0B;
                                                   border-radius:3px;">

                                            <label
                                                id="lblMakerStatusHeading"
                                                value=""
                                                style="font-size:10px;
                                                       font-weight:700;
                                                       color:#B45309;"/>

                                            <label
                                                id="lblMakerRejectionReasonCode"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>

                                            <label
                                                id="lblMakerRejectionReasonName"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>

                                            <label
                                                id="lblMakerRejectionRemarks"
                                                value=""
                                                style="font-size:10px;
                                                       color:#475569;
                                                       white-space:normal;"/>

                                        </vlayout>


                                        <!-- =================================================
                                             ROW 1
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="CHEQUE NUMBER"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtChequeNo"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="MICR"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtMicr"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             ROW 2
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="PAYEE NAME"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtpayeeName"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="PAYEE ACCOUNT NUMBER"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtAccountNo"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             ROW 3
                                             ================================================= -->

                                        <div sclass="two-column-fields">

                                            <div sclass="field-group">

                                                <label
                                                    value="AMOUNT"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtAmount"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>


                                            <div sclass="field-group">

                                                <label
                                                    value="CHEQUE DATE"
                                                    sclass="field-label"/>

                                                <textbox
                                                    id="txtChequeDate"
                                                    readonly="true"
                                                    width="100%"
                                                    sclass="readonly-field"/>

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             CHECKER ACTION
                                             ================================================= -->

                                        <div sclass="details-action-area">

                                            <label
                                                value="CHECKER ACTION"
                                                sclass="details-action-title"/>


                                            <!-- VERIFY / RETURN / REJECT -->

                                            <div sclass="details-action-buttons">

                                                <button
                                                    id="btnVerified"
                                                    label="VERIFY"
                                                    sclass="verified-button"/>

                                                <button
                                                    id="btnReturn"
                                                    label="RETURN TO MAKER"
                                                    sclass="return-button"/>

                                                <button
                                                    id="btnReject"
                                                    label="REJECT"
                                                    sclass="reject-button"/>

                                            </div>


                                            <!-- APPROVE BATCH -->

                                            <button
                                                id="btnXmlGeneration"
                                                label="APPROVE BATCH"
                                                sclass="xml-generation-button"
                                                disabled="true"/>

                                        </div>

                                    </div>

                                </div>


                                <!-- =================================================
                                     FOOTER
                                     ================================================= -->

                                <div sclass="page-footer">

                                    <label
                                        value="Express Clear CTS · Checker Portal"
                                        sclass="footer-left"/>

                                    <label
                                        value="Cheque Verification"
                                        sclass="footer-right"/>

                                </div>

                            </div>

                        </div>

                    </div>

                </center>

            </borderlayout>

        </center>

    </borderlayout>

</zk>