<?xml version="1.0" encoding="UTF-8"?>
<?page title="Checker Queue" contentType="text/html;charset=UTF-8"?>
<?link rel="stylesheet" type="text/css" href="/css/outward/checker-queue.css"?>

<zk>

    <window
        id="checkerQueueWindow"
        border="none"
        width="100%"
        height="100%"
        sclass="checker-queue-window"
        apply="com.iispl.cts.controller.outward.checker.OutwardCheckerQueueController">

        <borderlayout
            width="100%"
            height="100%">

            <!-- =====================================================
                 LEFT SIDEBAR
                 ===================================================== -->

            <west
                size="220px"
                border="none"
                splittable="false"
                collapsible="false">

                <include src="/components/sidebar.zul">

                    <custom-attributes
                        role="OUTWARD_CHECKER"
                        activeTab="checker-queue" />

                </include>

            </west>


            <!-- =====================================================
                 RIGHT SIDE
                 ===================================================== -->

            <center border="none">

                <borderlayout
                    width="100%"
                    height="100%">

                    <!-- =================================================
                         HEADER
                         ================================================= -->

                    <north
                        height="90px"
                        border="none">

                        <div sclass="page-header">

                            <div sclass="header-left-content">

                                <label
                                    value="Cheque Verification"
                                    sclass="header-page-title" />

                                <label
                                    value="Review the cheque and verify the read-only details submitted by Maker."
                                    sclass="header-page-description" />

                            </div>


                            <div sclass="header-right-content">

                                <include
                                    src="/components/header.zul" />

                            </div>

                        </div>

                    </north>


                    <!-- =================================================
                         MAIN CONTENT
                         ================================================= -->

                    <center
                        border="none"
                        autoscroll="false">

                        <div
                            width="100%"
                            height="100%"
                            sclass="content-wrapper">


                            <!-- =================================================
                                 NO BATCH MESSAGE
                                 ================================================= -->

                            <vlayout
                                id="noBatchMessage"
                                visible="false"
                                width="100%"
                                height="100%"
                                style="align-items:center; justify-content:center;">

                                <vlayout
                                    spacing="15px"
                                    style="text-align:center;">

                                    <label
                                        value="No batch has been selected."
                                        style="font-size:24px; font-weight:bold;" />

                                    <label
                                        value="Please select a batch from the Checker Dashboard."
                                        style="font-size:15px;" />

                                    <button
                                        id="btnBackToDashboard"
                                        label="BACK TO DASHBOARD"
                                        sclass="back-dashboard-button" />

                                </vlayout>

                            </vlayout>


                            <!-- =================================================
                                 CHECKER QUEUE CONTENT
                                 ================================================= -->

                            <div
                                id="checkerQueueContent"
                                sclass="main-page"
                                visible="false">

                                <div sclass="main-content">


                                    <!-- =================================================
                                         HEADING
                                         ================================================= -->

                                    <div sclass="section-heading">

                                        <label
                                            value="Cheque Queue"
                                            sclass="main-title" />

                                    </div>


                                    <!-- =================================================
                                         SUMMARY CARD
                                         ================================================= -->

                                    <div sclass="summary-card">


                                        <!-- BATCH -->

                                        <div sclass="summary-item">

                                            <label
                                                value="BATCH"
                                                sclass="summary-label" />

                                            <label
                                                id="lblBatchNo"
                                                value="-"
                                                sclass="summary-value" />

                                        </div>


                                        <!-- CHEQUE -->

                                        <div sclass="summary-item">

                                            <label
                                                value="CHEQUE"
                                                sclass="summary-label" />

                                            <label
                                                id="lblChequeNo"
                                                value="-"
                                                sclass="summary-value" />

                                        </div>


                                        <!-- BATCH STATUS -->

                                        <div sclass="summary-item">

                                            <label
                                                value="BATCH STATUS"
                                                sclass="summary-label" />

                                            <label
                                                id="lblQueueStatus"
                                                value="-"
                                                sclass="status-pending" />

                                        </div>


                                        <!-- CURRENT CHEQUE -->

                                        <div sclass="summary-item">

                                            <label
                                                value="CURRENT CHEQUE"
                                                sclass="summary-label" />

                                            <label
                                                id="lblCurrentCheque"
                                                value="-"
                                                sclass="summary-value" />

                                        </div>


                                        <!-- REMAINING -->

                                        <div sclass="summary-item last">

                                            <label
                                                value="REMAINING"
                                                sclass="summary-label" />

                                            <label
                                                id="lblRemaining"
                                                value="-"
                                                sclass="remaining-value" />

                                        </div>

                                    </div>


                                    <!-- =================================================
                                         IMAGE + DETAILS ROW
                                         ================================================= -->

                                    <div sclass="verification-row">


                                        <!-- =================================================
                                             CHEQUE IMAGE CARD
                                             ================================================= -->

                                        <div sclass="image-card">

                                            <label
                                                value="Cheque Image"
                                                sclass="card-title" />

                                            <label
                                                value="Read-only image for visual verification"
                                                sclass="card-description" />


                                            <!-- ZOOM CONTROLS -->

                                            <div sclass="zoom-controls">

                                                <button
                                                    id="btnZoomOut"
                                                    label="−"
                                                    sclass="zoom-button"
                                                    tooltiptext="Zoom Out" />

                                                <label
                                                    id="lblZoom"
                                                    value="100%"
                                                    sclass="zoom-level" />

                                                <button
                                                    id="btnZoomIn"
                                                    label="+"
                                                    sclass="zoom-button"
                                                    tooltiptext="Zoom In" />

                                                <button
                                                    id="btnZoomReset"
                                                    label="Reset"
                                                    sclass="zoom-reset-button"
                                                    tooltiptext="Reset Zoom" />

                                                <button
                                                    id="btnImageSide"
                                                    label="BACK SIDE"
                                                    sclass="image-side-button" />

                                            </div>


                                            <!-- CHEQUE IMAGE -->

                                            <div sclass="cheque-image-container">

                                                <image
                                                    id="imgCheque"
                                                    sclass="cheque-image" />

                                            </div>

                                        </div>


                                        <!-- =================================================
                                             CHEQUE DETAILS CARD
                                             ================================================= -->

                                        <div sclass="details-card">


                                            <!-- DETAILS HEADER -->

                                            <div sclass="details-card-header">

                                                <div sclass="details-card-title-area">

                                                    <label
                                                        value="Cheque Details"
                                                        sclass="card-title" />

                                                    <label
                                                        value="Read-only · Submitted by Maker"
                                                        sclass="card-description" />

                                                </div>


                                                <!-- ACCOUNT VALIDATION -->

                                                <label
                                                    id="lblAccountValidation"
                                                    value="NOT VERIFIED"
                                                    sclass="validation-pending-badge" />

                                            </div>


                                            <!-- =================================================
                                                 ROW 1
                                                 ================================================= -->

                                            <div sclass="two-column-fields">

                                                <div sclass="field-group">

                                                    <label
                                                        value="CHEQUE NUMBER"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtChequeNo"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>


                                                <div sclass="field-group">

                                                    <label
                                                        value="MICR"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtMicr"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>

                                            </div>


                                            <!-- =================================================
                                                 ROW 2
                                                 ================================================= -->

                                            <div sclass="two-column-fields">

                                                <div sclass="field-group">

                                                    <label
                                                        value="PAYEE NAME"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtpayeeName"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>


                                                <div sclass="field-group">

                                                    <label
                                                        value="PAYEE ACCOUNT NUMBER"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtAccountNo"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>

                                            </div>


                                            <!-- =================================================
                                                 ROW 3
                                                 ================================================= -->

                                            <div sclass="two-column-fields">

                                                <div sclass="field-group">

                                                    <label
                                                        value="AMOUNT"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtAmount"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>


                                                <div sclass="field-group">

                                                    <label
                                                        value="CHEQUE DATE"
                                                        sclass="field-label" />

                                                    <textbox
                                                        id="txtChequeDate"
                                                        readonly="true"
                                                        width="100%"
                                                        sclass="readonly-field" />

                                                </div>

                                            </div>


                                            <!-- =================================================
                                                 MAKER REJECTION REQUEST
                                                 INSIDE CHEQUE DETAILS
                                                 ================================================= -->

                                            <vlayout
                                                id="makerRejectionRequestSection"
                                                visible="false"
                                                spacing="3px"
                                                style="margin:6px 0 6px 0;
                                                       padding:7px 9px;
                                                       background:#FFF7ED;
                                                       border-left:3px solid #F59E0B;
                                                       border-radius:3px;">

                                                <label
                                                    value="MAKER REJECTION REQUEST"
                                                    style="font-size:10px;
                                                           font-weight:700;
                                                           color:#B45309;" />

                                                <label
                                                    id="lblMakerRejectionReasonCode"
                                                    value=""
                                                    style="font-size:11px;
                                                           color:#475569;
                                                           white-space:normal;" />

                                                <label
                                                    id="lblMakerRejectionReasonName"
                                                    value=""
                                                    style="font-size:11px;
                                                           color:#475569;
                                                           white-space:normal;" />

                                                <label
                                                    id="lblMakerRejectionRemarks"
                                                    value=""
                                                    style="font-size:11px;
                                                           color:#475569;
                                                           white-space:normal;" />

                                            </vlayout>
                                            
                                            <vlayout
    id="rejectionDetailsSection"
    visible="false"
    spacing="3px"
    style="margin:6px 0 6px 0;
           padding:7px 9px;
           background:#FFF1F2;
           border-left:3px solid #DC2626;
           border-radius:3px;">

    <label
        value="REJECTION DETAILS"
        style="font-size:10px;
               font-weight:700;
               color:#B91C1C;" />

    <label
        id="lblRejectedReasonCode"
        value=""
        style="font-size:11px;
               color:#475569;
               white-space:normal;" />

    <label
        id="lblRejectedReasonName"
        value=""
        style="font-size:11px;
               color:#475569;
               white-space:normal;" />

    <label
        id="lblRejectedReasonRemarks"
        value=""
        style="font-size:11px;
               color:#475569;
               white-space:normal;" />

</vlayout>


                                          
                                        </div>

                                    </div>


                                    <!-- =================================================
                                         NAVIGATION
                                         BELOW BOTH CARDS
                                         ================================================= -->

                                    <div sclass="navigation-row">

                                        <button
                                            id="btnPrevious"
                                            label="‹  PREVIOUS"
                                            disabled="true"
                                            sclass="navigation-button" />

                                        <label
                                            id="lblCurrentChequeNavigation"
                                            value="Cheque 1 of 1 · 0 remaining"
                                            sclass="navigation-label" />

                                        <button
                                            id="btnNext"
                                            label="NEXT  ›"
                                            sclass="navigation-button" />

                                    </div>


                                    <!-- =================================================
                                         CHECKER ACTION
                                         ================================================= -->

                                    <div sclass="action-card">

                                        <label
                                            value="CHECKER ACTION"
                                            sclass="action-title" />

                                        <div sclass="action-buttons">

                                            <button
                                                id="btnVerified"
                                                label="VERIFY"
                                                sclass="verified-button" />

                                            <button
                                                id="btnXmlGeneration"
                                                label="XML GENERATION"
                                                visible="true"
                                                disabled="true"
                                                sclass="xml-generation-button" />

                                            <button
                                                id="btnReturn"
                                                label="RETURN TO MAKER"
                                                sclass="return-button" />

                                            <button
                                                id="btnReject"
                                                label="REJECT"
                                                sclass="reject-button" />

                                        </div>

                                    </div>


                                    <!-- =================================================
                                         FOOTER
                                         ================================================= -->

                                    <div sclass="page-footer">

                                        <label
                                            value="Express Clear CTS · Checker Portal"
                                            sclass="footer-left" />

                                        <label
                                            value="Cheque Verification"
                                            sclass="footer-right" />

                                    </div>

                                </div>

                            </div>

                        </div>

                    </center>

                </borderlayout>

            </center>

        </borderlayout>

    </window>

</zk>