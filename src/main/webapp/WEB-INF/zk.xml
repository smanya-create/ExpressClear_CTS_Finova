<zk>

    <device-config>
        <device-type>ajax</device-type>
        <timeout-uri>/common/login.zul</timeout-uri>
        <!-- Disables artificial keep-alive pings so unload triggers immediately -->
        <automatic-timeout>false</automatic-timeout>

        <server-push-class>
            org.zkoss.zk.ui.impl.PollingServerPush
        </server-push-class>
    </device-config>

    <listener>
        <listener-class>
            com.iispl.cts.listener.UserSession
        </listener-class>
    </listener>
    <listener>
        <listener-class>
            com.iispl.cts.listener.GlobalSessionLockInterceptor
        </listener-class>
    </listener>

    <client-config>
        <keep-alive>false</keep-alive>
        <!-- Tells the browser to send an immediate drop-desktop beacon on tab close -->
        <desktop-timeout>-1</desktop-timeout>
    </client-config>

    <system-config>
        <upload-config>
            <max-size>20480</max-size>
        </upload-config>
    </system-config>

</zk>