<zk>

    <device-config>
        <device-type>ajax</device-type>

        <timeout-uri>/common/login.zul</timeout-uri>

        <server-push-class>
            org.zkoss.zk.ui.impl.PollingServerPush
        </server-push-class>
    </device-config>

    <listener>
        <listener-class>
            com.iispl.cts.listener.UserSession
        </listener-class>
    </listener>

    <client-config>
        <keep-alive>false</keep-alive>
    </client-config>

    <system-config>
        <upload-config>
            <max-size>20480</max-size>
        </upload-config>
    </system-config>

</zk>