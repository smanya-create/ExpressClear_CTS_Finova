<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="xhtml">
<style src="/css/common/sidebar.css"/>
<div width="220px" height="100%" sclass="sidebar" apply="com.iispl.cts.controller.common.SidebarController"
     style="background-color: #0b1d3a; min-height: 100%; margin: 0; padding: 0;">
    
    <!-- Brand Title Header -->
    <div style="padding: 20px;">
        <label value="CTS" style="font-size: 20px; font-weight: bold; color: #ffffff; display: block;"/>
        <label value="Express Clear" style="font-size: 16px; color: #63b3ed; display: block;"/>
        <label id="lblPortalTitle" value="BANKING PORTAL" style="font-size: 9px; color: #a0aec0; letter-spacing: 1px; display: block; margin-top: 4px;"/>
    </div>
    
    <separator bar="true" style="background: #1a365d; margin: 0 0 10px 0;"/>
    
    <!-- Dynamic Role-Based Navigation Menu -->
    <vlayout style="padding-top: 0px;" hflex="1" spacing="0">
        <label value="NAVIGATION" style="font-size: 10px; color: #718096; padding: 10px 20px; display: block;"/>
        
        <!-- Common Dashboard Link -->
        <a id="navDashboard" label="Dashboard" sclass="${arg.activeTab eq 'dashboard' || arg.activeTab eq 'inward-dashboard' || arg.activeTab eq 'outward-dashboard' || arg.activeTab eq 'admin-dashboard' || arg.activeTab eq 'checker-dashboard' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToDashboard()"/>
        
        <!-- ADMIN MODULES -->
        <div id="divAdminMenu" visible="${arg.role eq 'ADMIN'}">
            <vlayout spacing="0">
                <a id="navAdminUsers" label="User Management" sclass="${arg.activeTab eq 'users' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToUserManagement()"/>
                <a id="navAdminRoles" label="Role Management" sclass="${arg.activeTab eq 'roles' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToRoleManagement()"/>
                <a id="navAudit" label="Audit Logs" sclass="${arg.activeTab eq 'audit' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToAuditLogs()"/>
                <a id="navAdminReports" label="Reports" sclass="${arg.activeTab eq 'admin-reports' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToAdminReports()"/>
            </vlayout>
        </div>

        <!-- OUTWARD MAKER MODULES -->
        <div id="divMakerMenu" visible="${arg.role eq 'OUTWARD_MAKER'}">
            <vlayout spacing="0">
                <a id="navUpload" label="Upload Batch" sclass="${arg.activeTab eq 'upload' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToUploadBatch()"/>
                <a id="navOutwardMicr" label="MICR Repair" sclass="${arg.activeTab eq 'outward-micr' || arg.activeTab eq 'micr' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardMicrRepair()"/>
                <a id="navOutwardDataEntry" label="Data Entry" sclass="${arg.activeTab eq 'outward-data-entry' || arg.activeTab eq 'data-entry' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardDataEntry()"/>
                <a id="navQueue" label="Unprocessed Cheques" sclass="${arg.activeTab eq 'unprocessed' || arg.activeTab eq 'queue' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToQueue()"/>
                <a id="navOutwardMakerReports" label="Reports" sclass="${arg.activeTab eq 'outward-maker-reports' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardMakerReports()"/>
            </vlayout>
        </div>

        <!-- OUTWARD CHECKER MODULES -->
        <div id="divCheckerMenu" visible="${arg.role eq 'OUTWARD_CHECKER'}">
            <vlayout spacing="0">
                <a id="navCheckerQueue" label="Checker Queue" sclass="${arg.activeTab eq 'checker-queue' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardCheckerQueue()"/>
                <a id="navXmlGen" label="XML Generation" sclass="${arg.activeTab eq 'xml-gen' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardXmlGeneration()"/>
                <a id="navOutwardRejected" label="Outward Rejected Cheques" sclass="${arg.activeTab eq 'outward-rejected-cheques' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardRejectedCheques()"/>
                <a id="navOutwardCheckerReports" label="Reports" sclass="${arg.activeTab eq 'outward-checker-reports' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToOutwardCheckerReports()"/>
            </vlayout>
        </div>
        
        <!-- INWARD MAKER MODULES -->
        <div id="divInwardMakerMenu" visible="${arg.role eq 'INWARD_MAKER'}">
            <vlayout spacing="0">
                <a id="navBatchIntake" label="Batch Intake" sclass="${arg.activeTab eq 'batch-intake' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToBatchIntake()"/>
                <a id="navInwardMicr" label="MICR Repair" sclass="${arg.activeTab eq 'inward-micr' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToInwardMicrRepair()"/>
                <a id="navInwardDataEntry" label="Data Entry" sclass="${arg.activeTab eq 'inward-data-entry' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToInwardDataEntry()"/>
                <a id="navMakerCompletion" label="Maker Completion" sclass="${arg.activeTab eq 'maker-completion' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToMakerCompletion()"/>
                <a id="navInwardUnprocessed" label="Unprocessed Cheques" sclass="${arg.activeTab eq 'inward-unprocessed' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToInwardUnprocessedQueue()"/>
                <a id="navInwardMakerReports" label="Reports" sclass="${arg.activeTab eq 'inward-maker-reports' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToInwardMakerReports()"/>
            </vlayout>
        </div>

        <!-- INWARD CHECKER MODULES -->
        <div id="divInwardCheckerMenu" visible="${arg.role eq 'INWARD_CHECKER'}">
            <vlayout spacing="0">
                <a id="navVerification" label="Verification" sclass="${arg.activeTab eq 'verification' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToVerification()"/>
                <a id="navRrf" label="RRF" sclass="${arg.activeTab eq 'rrf' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToRRF()"/>
                <a id="navInwardCheckerReports" label="Reports" sclass="${arg.activeTab eq 'inward-checker-reports' ? 'nav-item active' : 'nav-item'}" onClick="$composer.navToInwardCheckerReports()"/>
            </vlayout>
        </div>
    </vlayout>

    <!-- Logout Action -->
    <div style="padding-top: 30px; padding-bottom: 20px;">
        <a label="Log Out" sclass="nav-item-logout" onClick="$composer.onClickLogout()"/>
    </div>
</div>
</zk>