<?xml version="1.0" encoding="UTF-8"?>
<?page title="Express Clear - Login"?>
<?link rel="stylesheet" type="text/css" href="/css/common/login.css"?>
<zk>
<vlayout apply="com.iispl.cts.controller.common.LoginController"
         hflex="1" vflex="1" spacing="0">
    
    <!-- Top Header Ribbon -->
    <hlayout sclass="top-header" valign="middle" hflex="1" style="justify-content: space-between;">
        <hlayout valign="middle" spacing="12px">
            <div sclass="logo-box">CTS</div>
            <vlayout spacing="2px">
                <label value="Express Clear" style="font-size: 18px; font-weight: bold; color: white; display: block;"/>
                <label value="CHEQUE TRUNCATION SYSTEM" style="font-size: 8px; color: #a0aec0; letter-spacing: 1px;"/>
            </vlayout>
        </hlayout>
        <label value="SECURE BANKING OPERATIONS" style="font-size: 11px; color: #a0aec0; letter-spacing: 1px;"/>
    </hlayout>

    <!-- Login Card Container -->
    <vlayout vflex="1" hflex="1" style="align-items: center; justify-content: center;padding: 40px 0;">
        <vlayout sclass="login-card" spacing="0" style="margin-top: 20px;">
            
            <vlayout spacing="6px" style="text-align: center; margin-bottom: 30px;">
                <label value="Welcome back" style="font-size: 26px; font-weight: bold; color: #1a202c; display: block;"/>
                <label value="Sign in to access Express Clear CTS." style="color: #718096; font-size: 13px;"/>
            </vlayout>

            <vlayout spacing="18px">
                <!-- Username Field -->
                <vlayout spacing="4px">
                    <label value="USERNAME" sclass="field-label"/>
                    <textbox id="txtUsername" placeholder="Enter your username" 
                             constraint="no empty: Username is required."
                             sclass="input-field" hflex="1" height="42px" />
                </vlayout>

                <!-- Password Field -->
                <vlayout spacing="4px">
                    <label value="PASSWORD" sclass="field-label"/>
                    <hlayout style="position: relative; width: 100%;" valign="middle">
                        <textbox id="txtPassword" type="password" placeholder="Enter your password" 
                                 constraint="no empty: Password is required."
                                 sclass="input-field" hflex="1" height="42px"
                                 style="padding-right: 42px; box-sizing: border-box;" />
                        <button id="btnTogglePassword" 
                                iconSclass="z-icon-eye"
                                onClick="$composer.onTogglePasswordVisibility()"
                                style="position: absolute; right: 10px; background: transparent; border: none; cursor: pointer; color: #718096; font-size: 15px; box-shadow: none; padding: 0; min-height: unset;" />
                    </hlayout>
                </vlayout>

                <!-- Role Selection Dropdown -->
                <vlayout spacing="4px">
                    <label value="ROLE" sclass="field-label"/>
                    <combobox id="cmbRole" placeholder="Select your role" readonly="true"
                              hflex="1" height="42px" style="font-size: 13px;" />
                </vlayout>

                <separator height="10px"/>

                <!-- Sign In Button -->
                <button id="btnSignIn" label="Sign In" hflex="1" height="42px" sclass="btn-primary" />

                <separator height="10px"/>

                <!-- Authorization Notice -->
                <vlayout spacing="2px" style="text-align: center;">
                    <label value="Authorized users only" style="font-size: 11px; color: #a0aec0; display: block;"/>
                    <label value="Your access is controlled by your assigned role." style="font-size: 11px; color: #a0aec0; display: block;"/>
                </vlayout>
            </vlayout>

        </vlayout>
    </vlayout>

    <!-- Footer Ribbon -->
    <div sclass="footer-text" hflex="1">
        <label value="© Express Clear CTS · Secure Banking Application"/>
    </div>

</vlayout>
</zk>