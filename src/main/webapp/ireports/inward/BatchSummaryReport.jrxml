                                    <font size="6"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$F{payeeAccountNumber}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="50">
                        <jr:columnHeader height="30">
                            <staticText>
                                <reportElement x="0" y="0" width="50" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement textAlignment="Center" verticalAlignment="Middle">
                                    <font size="7" isBold="true"/>
                                </textElement>
                                <text><![CDATA[Amount]]></text>
