<?xml version="1.0" encoding="UTF-8"?>

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd
              http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/jasperreports/components.xsd"
              name="BatchSummaryReport"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="25"
              bottomMargin="25"
              whenNoDataType="AllSectionsNoDetail">

    <subDataset name="ApprovedChequesDataset">
        <field name="chequeNumber" class="java.lang.String"/>
        <field name="draweeBank" class="java.lang.String"/>
        <field name="presentingBank" class="java.lang.String"/>
        <field name="draweeAccountNumber" class="java.lang.String"/>
        <field name="payeeAccountNumber" class="java.lang.String"/>
        <field name="chequeAmount" class="java.math.BigDecimal"/>
        <field name="chequeDate" class="java.time.LocalDateTime"/>
        <field name="chequeStatus" class="java.lang.String"/>
    </subDataset>

    <subDataset name="RejectedChequesDataset">
        <field name="chequeNumber" class="java.lang.String"/>
        <field name="draweeBank" class="java.lang.String"/>
        <field name="presentingBank" class="java.lang.String"/>
        <field name="draweeAccountNumber" class="java.lang.String"/>
        <field name="payeeAccountNumber" class="java.lang.String"/>
        <field name="chequeAmount" class="java.math.BigDecimal"/>
        <field name="chequeDate" class="java.time.LocalDateTime"/>
        <field name="rejectedReasonCode" class="java.lang.String"/>
        <field name="rejectedReasonName" class="java.lang.String"/>
        <field name="chequeStatus" class="java.lang.String"/>
    </subDataset>

    <parameter name="BATCH_ID" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.util.Date"/>
    <parameter name="GENERATED_BY" class="java.lang.String"/>
    <parameter name="TOTAL_CHEQUES" class="java.lang.Integer"/>
    <parameter name="APPROVED_CHEQUES" class="java.lang.Integer"/>
    <parameter name="REJECTED_CHEQUES" class="java.lang.Integer"/>
    <parameter name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="APPROVED_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="REJECTED_AMOUNT" class="java.math.BigDecimal"/>
    <parameter name="APPROVED_DATA_SOURCE" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="REJECTED_DATA_SOURCE" class="net.sf.jasperreports.engine.JRDataSource"/>

    <title>
        <band height="100">

            <staticText>
                <reportElement x="0" y="0" width="535" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[CTS INWARD CHEQUE BATCH SUMMARY REPORT]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="28" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Approved and Rejected Cheques Details]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="52" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="62" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Batch ID :]]></text>
            </staticText>

            <textField>
                <reportElement x="80" y="62" width="180" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{BATCH_ID}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="330" y="62" width="85" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Generated By :]]></text>
            </staticText>

            <textField>
                <reportElement x="415" y="62" width="120" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATED_BY}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="82" width="145" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Report Generated :]]></text>
            </staticText>

            <textField pattern="dd-MM-yyyy HH:mm:ss">
                <reportElement x="145" y="82" width="250" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{GENERATED_AT}]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <detail>
        <band height="115">

            <staticText>
                <reportElement x="0" y="0" width="535" height="25"/>
                <box>
                    <pen lineWidth="0.5"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[BATCH SUMMARY]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="25" width="70" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Batch ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="70" y="25" width="70" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Total]]></text>
            </staticText>

            <staticText>
                <reportElement x="140" y="25" width="65" height="30" backcolor="#D9EAF7" mode="Opaque"/>
