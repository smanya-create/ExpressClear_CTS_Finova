                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Approved]]></text>
            </staticText>

            <staticText>
                <reportElement x="205" y="25" width="65" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Rejected]]></text>
            </staticText>

            <staticText>
                <reportElement x="270" y="25" width="88" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Amount]]></text>
            </staticText>

            <staticText>
                <reportElement x="358" y="25" width="88" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Approved Amount]]></text>
            </staticText>

            <staticText>
                <reportElement x="446" y="25" width="89" height="30" backcolor="#D9EAF7" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[Rejected Amount]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="55" width="70" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{BATCH_ID}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="55" width="70" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_CHEQUES}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="140" y="55" width="65" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{APPROVED_CHEQUES}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="205" y="55" width="65" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REJECTED_CHEQUES}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="270" y="55" width="88" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="358" y="55" width="88" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{APPROVED_AMOUNT}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="446" y="55" width="89" height="30"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REJECTED_AMOUNT}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

