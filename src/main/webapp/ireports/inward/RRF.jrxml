<?xml version="1.0" encoding="UTF-8"?>

<jasperReport

    xmlns="http://jasperreports.sourceforge.net/jasperreports"

    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

    xsi:schemaLocation="

        http://jasperreports.sourceforge.net/jasperreports

        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"

    name="RRF"

    pageWidth="842"

    pageHeight="595"

    orientation="Landscape"

    columnWidth="782"

    leftMargin="30"

    rightMargin="30"

    topMargin="25"

    bottomMargin="25">

    <parameter name="RRF_REFERENCE_NO" class="java.lang.String"/>

    <parameter name="BATCH_ID" class="java.lang.String"/>

    <parameter name="SESSION_DATE" class="java.lang.String"/>

    <parameter name="GENERATION_DATE" class="java.util.Date"/>

    <parameter name="GENERATED_BY" class="java.lang.String"/>

    <parameter name="TOTAL_REJECTED_CHEQUES" class="java.lang.Integer"/>

    <parameter name="TOTAL_REJECTED_AMOUNT" class="java.lang.Double"/>

    <field name="chequeNumber" class="java.lang.String"/>

    <field name="micrCode" class="java.lang.String"/>

    <field name="draweeBank" class="java.lang.String"/>

    <field name="presentingBank" class="java.lang.String"/>

    <field name="chequeAmount" class="java.lang.Object"/>

    <field name="rejectedReasonId" class="java.lang.Object"/>

    <field name="rejectedReasonCode" class="java.lang.String"/>

    <field name="remarks" class="java.lang.String"/>

    <title>

        <band height="55" splitType="Stretch">

            <staticText>

                <reportElement x="0" y="0" width="782" height="24"/>

                <textElement textAlignment="Center">

                    <font fontName="SansSerif" size="16" isBold="true"/>

                </textElement>

                <text><![CDATA[RETURN REASON FILE (RRF)]]></text>

            </staticText>

            <staticText>

                <reportElement x="0" y="24" width="782" height="18"/>

                <textElement textAlignment="Center">

                    <font fontName="SansSerif" size="10" isBold="true"/>

                </textElement>

                <text><![CDATA[For CTS - Cheque Truncation System]]></text>

            </staticText>

            <line>

                <reportElement x="0" y="48" width="782" height="1"/>

                <graphicElement>

                    <pen lineWidth="1.0" lineColor="#000000"/>

                </graphicElement>

            </line>

        </band>

    </title>

    <pageHeader>

        <band height="120">

            <staticText>

                <reportElement x="0" y="5" width="130" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[RRF Reference No]]></text>

            </staticText>

            <staticText>

                <reportElement x="130" y="5" width="10" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField>

                <reportElement x="145" y="5" width="400" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$P{RRF_REFERENCE_NO}]]></textFieldExpression>

            </textField>

            <staticText>

                <reportElement x="0" y="23" width="130" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Batch ID]]></text>

            </staticText>

            <staticText>

                <reportElement x="130" y="23" width="10" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField>

                <reportElement x="145" y="23" width="400" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$P{BATCH_ID}]]></textFieldExpression>

            </textField>

            <staticText>

                <reportElement x="0" y="41" width="130" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Clearing/CTS Centre]]></text>

            </staticText>

            <staticText>

                <reportElement x="130" y="41" width="10" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <staticText>

                <reportElement x="145" y="41" width="400" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <text><![CDATA[CHENNAI]]></text>

            </staticText>

            <staticText>

                <reportElement x="0" y="59" width="130" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Session Date]]></text>

            </staticText>

            <staticText>

                <reportElement x="130" y="59" width="10" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField>

                <reportElement x="145" y="59" width="400" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$P{SESSION_DATE}]]></textFieldExpression>

            </textField>

            <staticText>

                <reportElement x="0" y="77" width="130" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Generation Date]]></text>

            </staticText>

            <staticText>

                <reportElement x="130" y="77" width="10" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField pattern="dd-MM-yyyy HH:mm:ss">

                <reportElement x="145" y="77" width="400" height="18"/>

                <textElement>

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$P{GENERATION_DATE}]]></textFieldExpression>

            </textField>

        </band>

    </pageHeader>

    <columnHeader>

        <band height="40">

            <staticText>

                <reportElement mode="Opaque" x="0" y="0" width="35" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Sl. No.]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="35" y="0" width="70" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Cheque No.]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="105" y="0" width="85" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[MICR Code]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="190" y="0" width="115" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Presenting Bank]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="305" y="0" width="115" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Drawee Bank]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="420" y="0" width="85" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Amount (Rs.)]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="505" y="0" width="75" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Return Reason Code]]></text>

            </staticText>

            <staticText>

                <reportElement mode="Opaque" x="580" y="0" width="202" height="40" backcolor="#DDEBF7"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Return Reason Description]]></text>

            </staticText>

        </band>

    </columnHeader>

    <detail>

        <band height="25" splitType="Stretch">

            <textField>

                <reportElement x="0" y="0" width="35" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="35" y="0" width="70" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$F{chequeNumber}]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="105" y="0" width="85" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[$F{micrCode}]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="190" y="0" width="115" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Left" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    $F{presentingBank} == null || $F{presentingBank}.trim().isEmpty()

                    ? "-"

                    : $F{presentingBank}

                ]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="305" y="0" width="115" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Left" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    $F{draweeBank} == null || $F{draweeBank}.trim().isEmpty()

                    ? "-"

                    : $F{draweeBank}

                ]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="420" y="0" width="85" height="25"/>

                <box rightPadding="5">

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Right" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    $F{chequeAmount} == null

                    ? "0.00"

                    : String.format("%,.2f", Double.parseDouble($F{chequeAmount}.toString()))

                ]]></textFieldExpression>

            </textField>

            <textField>

                <reportElement x="505" y="0" width="75" height="25"/>

                <box>

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Center" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    $F{rejectedReasonCode} != null

                    ? $F{rejectedReasonCode}

                    : ($F{rejectedReasonId} == null ? "" : $F{rejectedReasonId}.toString())

                ]]></textFieldExpression>

            </textField>

            <textField textAdjust="StretchHeight">

                <reportElement x="580" y="0" width="202" height="25"/>

                <box leftPadding="5">

                    <pen lineWidth="0.5" lineColor="#A6A6A6"/>

                </box>

                <textElement textAlignment="Left" verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    ($F{remarks} == null || $F{remarks}.trim().isEmpty())

                    ? "Cheque returned unpaid"

                    : $F{remarks}

                ]]></textFieldExpression>

            </textField>

        </band>

    </detail>

    <summary>

        <band height="70" splitType="Stretch">

            <staticText>

                <reportElement x="0" y="15" width="150" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Total Number of Cheques]]></text>

            </staticText>

            <staticText>

                <reportElement x="150" y="15" width="10" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField>

                <reportElement x="165" y="15" width="200" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[$P{TOTAL_REJECTED_CHEQUES}]]></textFieldExpression>

            </textField>

            <staticText>

                <reportElement x="0" y="35" width="150" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[Total Rejected Amount]]></text>

            </staticText>

            <staticText>

                <reportElement x="150" y="35" width="10" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <text><![CDATA[:]]></text>

            </staticText>

            <textField>

                <reportElement x="165" y="35" width="200" height="20"/>

                <textElement verticalAlignment="Middle">

                    <font fontName="SansSerif" size="9" isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[

                    "Rs. " + String.format("%,.2f", $P{TOTAL_REJECTED_AMOUNT})

                ]]></textFieldExpression>

            </textField>

        </band>

    </summary>

</jasperReport>