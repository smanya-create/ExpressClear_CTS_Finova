                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{actual_cheque_count}
                    ]]></textFieldExpression>

                </textField>


                <!-- REJECTED -->

                <textField>

                    <reportElement
                        x="355"
                        y="0"
                        width="100"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{rejected_cheque_count}
                    ]]></textFieldExpression>

                </textField>


                <!-- TOTAL AMOUNT -->

                <textField pattern="#,##0.00">

                    <reportElement
                        x="455"
                        y="0"
                        width="140"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{actual_total_amount}
                    ]]></textFieldExpression>

                </textField>


                <!-- DATE -->

                <textField pattern="dd-MM-yyyy HH\:mm\:ss">

                    <reportElement
                        x="595"
                        y="0"
                        width="187"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{uploaded_at}
                    ]]></textFieldExpression>

                </textField>

            </frame>


            <!-- =================================================
                 NORMAL ROW
                 ================================================= -->

            <frame>

                <reportElement
                    x="0"
                    y="0"
                    width="782"
                    height="30">

                    <printWhenExpression><![CDATA[
                        "NORMAL".equals($F{report_section})
                    ]]></printWhenExpression>

                </reportElement>


                <!-- BATCH ID -->

                <textField>

                    <reportElement
                        x="0"
                        y="0"
                        width="95"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{outward_batch_id}
                    ]]></textFieldExpression>

                </textField>


                <!-- BATCH REFERENCE -->

                <textField>

                    <reportElement
                        x="95"
                        y="0"
                        width="125"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{batch_reference_id}
                    ]]></textFieldExpression>

                </textField>


                <!-- TOTAL CHEQUES -->

                <textField>

                    <reportElement
                        x="220"
                        y="0"
                        width="85"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{actual_cheque_count}
                    ]]></textFieldExpression>

                </textField>


                <!-- TOTAL AMOUNT -->

                <textField pattern="#,##0.00">

                    <reportElement
                        x="305"
                        y="0"
                        width="115"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{actual_total_amount}
                    ]]></textFieldExpression>

                </textField>


                <!-- STATUS -->

                <textField>

                    <reportElement
                        x="420"
                        y="0"
                        width="115"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{batch_status}
                    ]]></textFieldExpression>

                </textField>


                <!-- UNPROCESSED -->

                <textField>

                    <reportElement
                        x="535"
                        y="0"
                        width="90"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{unprocessed_cheque_count}
                    ]]></textFieldExpression>

                </textField>


                <!-- DATE -->

                <textField pattern="dd-MM-yyyy HH\:mm\:ss">

                    <reportElement
                        x="625"
                        y="0"
                        width="157"
                        height="30"/>

                    <box>
                        <pen lineWidth="0.5"/>
                    </box>

                    <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">

                        <font
                            fontName="SansSerif"
                            size="7"/>

                    </textElement>

                    <textFieldExpression><![CDATA[
                        $F{uploaded_at}
                    ]]></textFieldExpression>

                </textField>

            </frame>

        </band>

    </detail>


    <!-- =========================================================
         PAGE FOOTER
         ========================================================= -->

    <pageFooter>

        <band height="25">

            <textField>

                <reportElement
                    x="0"
                    y="5"
                    width="300"
                    height="15"/>

                <textElement
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "CTS - Checker Report"
                ]]></textFieldExpression>

            </textField>


            <textField>

                <reportElement
                    x="650"
                    y="5"
                    width="132"
                    height="15"/>

                <textElement
                    textAlignment="Right"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="8"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "Page " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>

            </textField>

        </band>

    </pageFooter>


    <!-- =========================================================
         NO DATA
         ========================================================= -->

    <noData>

        <band height="60">

            <textField>

                <reportElement
                    x="0"
                    y="15"
                    width="782"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        fontName="SansSerif"
                        size="12"
                        isBold="true"/>

                </textElement>

                <textFieldExpression><![CDATA[
                    "No batches found for the selected date range."
                ]]></textFieldExpression>

            </textField>

        </band>

    </noData>

</jasperReport>