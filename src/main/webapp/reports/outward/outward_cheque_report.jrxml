<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    name="outward_cheque_report"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25"
    whenNoDataType="NoDataSection">

    <!-- =========================================================
         PARAMETERS
         ========================================================= -->

    <parameter name="FROM_DATE"
               class="java.sql.Date"/>

    <parameter name="TO_DATE"
               class="java.sql.Date"/>

    <parameter name="GENERATED_BY"
               class="java.lang.String"/>

    <parameter name="GENERATION_DATE"
               class="java.util.Date"/>


    <!-- =========================================================
         QUERY
         ========================================================= -->

    <queryString language="SQL">
        <![CDATA[

        SELECT
            1 AS section_order,
            'REJECTED' AS report_section,
            b.outward_batch_id,
            b.batch_reference_id,
            b.actual_cheque_count,
            b.actual_total_amount,
            b.batch_status,
            b.uploaded_at,

            COUNT(r.outward_rejected_cheque_id)::INTEGER
                AS rejected_cheque_count,

            0::INTEGER AS unprocessed_cheque_count

        FROM public.outward_batch b

        INNER JOIN public.outward_rejected_cheques r
            ON r.outward_batch_id = b.outward_batch_id

        WHERE
            b.uploaded_at >= CAST($P{FROM_DATE} AS DATE)

            AND

            b.uploaded_at <
                CAST($P{TO_DATE} AS DATE) + 1

        GROUP BY
            b.outward_batch_id,
            b.batch_reference_id,
            b.actual_cheque_count,
            b.actual_total_amount,
            b.batch_status,
            b.uploaded_at


        UNION ALL


        SELECT
            2 AS section_order,
            'NORMAL' AS report_section,
            b.outward_batch_id,
            b.batch_reference_id,
            b.actual_cheque_count,
            b.actual_total_amount,
            b.batch_status,
            b.uploaded_at,

            0::INTEGER AS rejected_cheque_count,

            (
                SELECT COUNT(*)::INTEGER

                FROM public.outward_cheque c

                WHERE
                    c.outward_batch_id = b.outward_batch_id

                    AND
                    (
                        c.cheque_status IS NULL

                        OR LOWER(TRIM(c.cheque_status))
                           IN ('pending', 'unprocessed')
                    )

            ) AS unprocessed_cheque_count

        FROM public.outward_batch b

        WHERE
            b.uploaded_at >= CAST($P{FROM_DATE} AS DATE)

            AND

            b.uploaded_at <
                CAST($P{TO_DATE} AS DATE) + 1

            AND NOT EXISTS
            (
                SELECT 1

                FROM public.outward_rejected_cheques r

                WHERE
                    r.outward_batch_id =
                        b.outward_batch_id
            )

        ORDER BY
            section_order,
            uploaded_at,
            outward_batch_id

        ]]>
    </queryString>


    <!-- =========================================================
         FIELDS
         ========================================================= -->

    <field name="section_order"
           class="java.lang.Integer"/>

    <field name="report_section"
           class="java.lang.String"/>

    <field name="outward_batch_id"
           class="java.lang.String"/>

    <field name="batch_reference_id"
           class="java.lang.String"/>

    <field name="actual_cheque_count"
           class="java.lang.Integer"/>

    <field name="actual_total_amount"
           class="java.math.BigDecimal"/>

    <field name="batch_status"
           class="java.lang.String"/>

    <field name="uploaded_at"
           class="java.sql.Timestamp"/>

    <field name="rejected_cheque_count"
           class="java.lang.Integer"/>

    <field name="unprocessed_cheque_count"
           class="java.lang.Integer"/>


    <!-- =========================================================
         SUMMARY VARIABLES
         ========================================================= -->

    <variable name="V_TOTAL_BATCHES"
              class="java.lang.Integer"
              calculation="Count">

        <variableExpression><![CDATA[
            Boolean.TRUE
        ]]></variableExpression>

    </variable>


    <variable name="V_TOTAL_CHEQUES"
              class="java.lang.Integer"
              calculation="Sum">

        <variableExpression><![CDATA[
            $F{actual_cheque_count}
        ]]></variableExpression>

    </variable>


    <variable name="V_TOTAL_AMOUNT"
              class="java.math.BigDecimal"
              calculation="Sum">

        <variableExpression><![CDATA[
            $F{actual_total_amount}
        ]]></variableExpression>

    </variable>


    <variable name="V_REJECTED_BATCHES"
              class="java.lang.Integer"
              calculation="Sum">

        <variableExpression><![CDATA[
            $F{section_order} == 1 ? 1 : 0
        ]]></variableExpression>

    </variable>


    <variable name="V_REJECTED_CHEQUES"
              class="java.lang.Integer"
              calculation="Sum">

        <variableExpression><![CDATA[
            $F{rejected_cheque_count}
        ]]></variableExpression>

    </variable>


    <variable name="V_UNPROCESSED_CHEQUES"
              class="java.lang.Integer"
              calculation="Sum">

        <variableExpression><![CDATA[
            $F{unprocessed_cheque_count}
        ]]></variableExpression>

    </variable>


