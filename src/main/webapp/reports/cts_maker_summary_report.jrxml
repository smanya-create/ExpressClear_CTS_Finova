<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cts_maker_summary_report"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="b62c451a-7b3e-4d51-bf5c-191a82f3ef71">

    <!-- =========================================================================
         DATASETS
         ========================================================================= -->

    <!-- 1. Batches with MICR Repairs (Cheque Item Level) -->
    <subDataset name="DatasetMicrRepairs" uuid="d1e57c6b-5861-4603-b09b-43956461c312">
        <parameter name="DS_MAKER_ID" class="java.lang.String"/>
        <parameter name="DS_FROM_DATE" class="java.sql.Date"/>
        <parameter name="DS_TO_DATE" class="java.sql.Date"/>
        <queryString>
            <![CDATA[
            SELECT sb.scanned_batch_id, 
                   sb.batch_reference_id,
                   sc.scanned_cheque_id,
                   sc.cheque_number,
                   sc.micr_code,
                   sc.drawee_name,
                   sc.payee_name,
                   sc.cheque_amount,
                   sc.cheque_status,
                   sc.created_at
            FROM scan_batch sb
            JOIN scan_cheque sc ON sb.scanned_batch_id = sc.scanned_batch_id
            WHERE (UPPER(sc.cheque_status) LIKE '%MICR%' 
                OR UPPER(sc.cheque_status) IN ('PENDING_MICR_REPAIR', 'MICR_REPAIRED', 'MICR_REJECTION_PENDING', 'DATA_ENTRY', 'PENDING_DATA_ENTRY', 'REJECTED_MICR'))
              AND CAST(GREATEST(sb.uploaded_at, sc.created_at) AS DATE) BETWEEN $P{DS_FROM_DATE} AND $P{DS_TO_DATE}
            ORDER BY sb.scanned_batch_id ASC, sc.created_at DESC
            ]]>
        </queryString>
        <field name="scanned_batch_id" class="java.lang.String"/>
        <field name="batch_reference_id" class="java.lang.String"/>
        <field name="scanned_cheque_id" class="java.lang.String"/>
        <field name="cheque_number" class="java.lang.String"/>
        <field name="micr_code" class="java.lang.String"/>
        <field name="drawee_name" class="java.lang.String"/>
        <field name="payee_name" class="java.lang.String"/>
        <field name="cheque_amount" class="java.math.BigDecimal"/>
        <field name="cheque_status" class="java.lang.String"/>
        <field name="created_at" class="java.sql.Timestamp"/>
    </subDataset>

    <!-- 2. Cheques Gone for Data Entry -->
    <subDataset name="DatasetDataEntry" uuid="a7f47e7a-9b16-419b-a3d8-4f169213bc54">
        <parameter name="DS_MAKER_ID" class="java.lang.String"/>
        <parameter name="DS_FROM_DATE" class="java.sql.Date"/>
        <parameter name="DS_TO_DATE" class="java.sql.Date"/>
        <queryString>
            <![CDATA[
            SELECT sc.scanned_cheque_id,
                   sc.scanned_batch_id, 
                   COALESCE(sb.batch_reference_id, sc.scanned_batch_id) AS batch_reference_id,
                   sc.cheque_number,
                   sc.micr_code,
                   sc.drawee_name,
                   sc.payee_name,
                   sc.cheque_amount,
                   sc.cheque_status, 
                   sc.created_at
            FROM scan_cheque sc
            JOIN scan_batch sb ON sc.scanned_batch_id = sb.scanned_batch_id
            WHERE (UPPER(sc.cheque_status) LIKE '%DATA_ENTRY%'
                OR UPPER(sc.cheque_status) IN ('DATA_ENTRY', 'PENDING_DATA_ENTRY', 'PENDING_MICR_REPAIR'))
              AND CAST(GREATEST(sc.created_at, sb.uploaded_at) AS DATE) BETWEEN $P{DS_FROM_DATE} AND $P{DS_TO_DATE}
            ORDER BY sc.created_at DESC
            ]]>
        </queryString>
        <field name="scanned_cheque_id" class="java.lang.String"/>
        <field name="scanned_batch_id" class="java.lang.String"/>
        <field name="batch_reference_id" class="java.lang.String"/>
        <field name="cheque_number" class="java.lang.String"/>
        <field name="micr_code" class="java.lang.String"/>
        <field name="drawee_name" class="java.lang.String"/>
        <field name="payee_name" class="java.lang.String"/>
        <field name="cheque_amount" class="java.math.BigDecimal"/>
        <field name="cheque_status" class="java.lang.String"/>
        <field name="created_at" class="java.sql.Timestamp"/>
    </subDataset>

    <!-- 3. Request Rejected Cheques -->
    <subDataset name="DatasetRejectedCheques" uuid="c8d56b7a-9b16-419b-a3d8-4f169213bc55">
        <parameter name="DS_MAKER_ID" class="java.lang.String"/>
        <parameter name="DS_FROM_DATE" class="java.sql.Date"/>
        <parameter name="DS_TO_DATE" class="java.sql.Date"/>
        <queryString>
            <![CDATA[
            SELECT rc.outward_rejected_cheque_id,
                   rc.outward_cheque_id,
                   oc.outward_batch_id,
                   oc.cheque_number,
                   oc.cheque_amount,
                   rc.rejected_by,
                   rc.rejected_date,
                   rc.remarks
            FROM outward_rejected_cheques rc
            JOIN outward_cheque oc ON rc.outward_cheque_id = oc.outward_cheque_id
            WHERE CAST(rc.rejected_date AS DATE) BETWEEN $P{DS_FROM_DATE} AND $P{DS_TO_DATE}
            ORDER BY rc.rejected_date DESC
            ]]>
        </queryString>
        <field name="outward_rejected_cheque_id" class="java.lang.String"/>
        <field name="outward_cheque_id" class="java.lang.String"/>
        <field name="outward_batch_id" class="java.lang.String"/>
        <field name="cheque_number" class="java.lang.String"/>
        <field name="cheque_amount" class="java.math.BigDecimal"/>
        <field name="rejected_by" class="java.lang.String"/>
        <field name="rejected_date" class="java.sql.Timestamp"/>
        <field name="remarks" class="java.lang.String"/>
    </subDataset>

    <!-- 4. Batches Submitted to Checker (scan_batch) -->
    <subDataset name="DatasetSubmittedChecker" uuid="e6181fcd-f446-4cb4-96d5-a337198a964f">
        <parameter name="DS_MAKER_ID" class="java.lang.String"/>
        <parameter name="DS_FROM_DATE" class="java.sql.Date"/>
        <parameter name="DS_TO_DATE" class="java.sql.Date"/>
        <queryString>
            <![CDATA[
            SELECT sb.scanned_batch_id, 
                   sb.batch_reference_id, 
                   sb.actual_cheque_count,
                   sb.actual_total_amount, 
                   sb.uploaded_at, 
                   sb.batch_status
            FROM scan_batch sb
            LEFT JOIN scan_cheque sc ON sb.scanned_batch_id = sc.scanned_batch_id
            WHERE (UPPER(sb.batch_status) LIKE '%CHECKER%' 
                OR UPPER(sb.batch_status) LIKE '%SUBMIT%')
              AND CAST(GREATEST(sb.uploaded_at, COALESCE(sc.created_at, sb.uploaded_at)) AS DATE) BETWEEN $P{DS_FROM_DATE} AND $P{DS_TO_DATE}
            GROUP BY sb.scanned_batch_id, sb.batch_reference_id, sb.actual_cheque_count, 
                     sb.actual_total_amount, sb.uploaded_at, sb.batch_status
            ORDER BY sb.uploaded_at DESC
            ]]>
        </queryString>
        <field name="scanned_batch_id" class="java.lang.String"/>
        <field name="batch_reference_id" class="java.lang.String"/>
        <field name="actual_cheque_count" class="java.lang.Integer"/>
        <field name="actual_total_amount" class="java.math.BigDecimal"/>
        <field name="uploaded_at" class="java.sql.Timestamp"/>
        <field name="batch_status" class="java.lang.String"/>
    </subDataset>

    <!-- =========================================================================
         PARAMETERS
         ========================================================================= -->
    <parameter name="FROM_DATE" class="java.sql.Date"/>
    <parameter name="TO_DATE" class="java.sql.Date"/>
    <parameter name="MAKER_ID" class="java.lang.String"/>
    <parameter name="REPORT_TYPE" class="java.lang.String"/>

    <queryString>
        <![CDATA[SELECT 1 AS dummy_row]]>
    </queryString>
    <field name="dummy_row" class="java.lang.Integer"/>

