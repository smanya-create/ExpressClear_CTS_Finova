                <textFieldExpression><![CDATA[$F{cheque_count}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="442" y="1" width="130" height="16" uuid="8f9a0b1c-2d3e-4f5a-6b7c-8d9e0f1a2b3c"/>
