    <!-- Table Rows (X and Widths exactly match ColumnHeader) -->
    <detail>
        <band height="20">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="18" backcolor="#F8FAFC" uuid="3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d">
