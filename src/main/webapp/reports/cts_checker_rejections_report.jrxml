        <band height="28">
            <rectangle>
                <reportElement x="0" y="4" width="802" height="24" backcolor="#F1F5F9" uuid="f6a7b89c-0d1e-2f3a-4b5c-6d7e8f9a0b1c"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="8" y="8" width="80" height="16" uuid="a7b89c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[REJECT ID]]></text></staticText>
            <staticText><reportElement x="92" y="8" width="80" height="16" uuid="b89c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[BATCH ID]]></text></staticText>
            <staticText><reportElement x="176" y="8" width="80" height="16" uuid="c90d1e2f-3a4b-5c6d-7e8f-9a0b1c2d3e4f"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CHEQUE NO]]></text></staticText>
            <staticText><reportElement x="260" y="8" width="115" height="16" uuid="d01e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[DRAWEE ACC NO]]></text></staticText>
            <staticText><reportElement x="380" y="8" width="85" height="16" uuid="e12f3a4b-5c6d-7e8f-9a0b-1c2d3e4f5a6b"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[AMOUNT (INR)]]></text></staticText>
            <staticText><reportElement x="475" y="8" width="170" height="16" uuid="f23a4b5c-6d7e-8f9a-0b1c-2d3e4f5a6b7c"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[REMARKS]]></text></staticText>
            <staticText><reportElement x="650" y="8" width="65" height="16" uuid="a34b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[REJECTED BY]]></text></staticText>
            <staticText><reportElement x="720" y="8" width="75" height="16" uuid="b45c6d7e-8f9a-0b1c-2d3e-4f5a6b7c8d9e"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[REJECTED AT]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="18" backcolor="#FEF2F2" uuid="c56d7e8f-9a0b-1c2d-3e4f-5a6b7c8d9e0f">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
