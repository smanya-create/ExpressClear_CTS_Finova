            <textField><reportElement x="8" y="1" width="80" height="16" uuid="d67e8f9a-0b1c-2d3e-4f5a-6b7c8d9e0f1a"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{outward_rejected_cheque_id}]]></textFieldExpression></textField>
            <textField><reportElement x="92" y="1" width="80" height="16" uuid="e78f9a0b-1c2d-3e4f-5a6b-7c8d9e0f1a2b"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{outward_batch_id}]]></textFieldExpression></textField>
            <textField><reportElement x="176" y="1" width="80" height="16" uuid="f89a0b1c-2d3e-4f5a-6b7c-8d9e0f1a2b3c"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cheque_number}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="1" width="115" height="16" uuid="a90b1c2d-3e4f-5a6b-7c8d-9e0f1a2b3c4d"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{drawee_account_number}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="380" y="1" width="85" height="16" uuid="b01c2d3e-4f5a-6b7c-8d9e-0f1a2b3c4d5e"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{cheque_amount}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight"><reportElement x="475" y="1" width="170" height="16" forecolor="#991B1B" uuid="c12d3e4f-5a6b-7c8d-9e0f-1a2b3c4d5e6f"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{remarks}]]></textFieldExpression></textField>
            <textField><reportElement x="650" y="1" width="65" height="16" uuid="d23e4f5a-6b7c-8d9e-0f1a-2b3c4d5e6f7a"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{rejected_by_user}]]></textFieldExpression></textField>
            <textField pattern="yyyy-MM-dd HH:mm"><reportElement x="720" y="1" width="75" height="16" uuid="e34f5a6b-7c8d-9e0f-1a2b-3c4d5e6f7a8b"/><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{rejected_date}]]></textFieldExpression></textField>
