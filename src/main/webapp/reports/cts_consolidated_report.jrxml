<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cts_consolidated_report"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="81d22756-3bfa-4c4f-9e79-56385a4be460">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="CTS_Postgres"/>

    <!-- Report Parameters -->
    <parameter name="FROM_DATE" class="java.sql.Date"/>
    <parameter name="TO_DATE" class="java.sql.Date"/>
    <parameter name="GENERATED_BY" class="java.lang.String">
        <defaultValueExpression><![CDATA["ADMIN"]]></defaultValueExpression>
    </parameter>

    <!-- Query Aligned Directly to outward_batch Schema -->
    <queryString language="SQL">
        <![CDATA[
            SELECT 
                ob.outward_batch_id,
                ob.batch_reference_id,
                CAST(ob.uploaded_at AS DATE) AS batch_date,
                ob.actual_cheque_count,
                ob.actual_total_amount,
                ob.uploaded_by,
                ob.uploaded_at,
                ob.batch_status
            FROM outward_batch ob
            WHERE CAST(ob.uploaded_at AS DATE) >= CAST($P{FROM_DATE} AS DATE)
              AND CAST(ob.uploaded_at AS DATE) <= CAST($P{TO_DATE} AS DATE)
            ORDER BY ob.uploaded_at DESC, ob.outward_batch_id DESC
        ]]>
    </queryString>

    <!-- Field Bindings -->
    <field name="outward_batch_id" class="java.lang.String"/>
    <field name="batch_reference_id" class="java.lang.String"/>
    <field name="batch_date" class="java.sql.Date"/>
    <field name="actual_cheque_count" class="java.lang.Integer"/>
    <field name="actual_total_amount" class="java.math.BigDecimal"/>
    <field name="uploaded_by" class="java.lang.String"/>
    <field name="uploaded_at" class="java.sql.Timestamp"/>
    <field name="batch_status" class="java.lang.String"/>

    <!-- Variables for Totals -->
    <variable name="TOTAL_BATCH_COUNT" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{outward_batch_id}]]></variableExpression>
    </variable>
    <variable name="GRAND_TOTAL_ITEMS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{actual_cheque_count}]]></variableExpression>
    </variable>
    <variable name="GRAND_TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{actual_total_amount}]]></variableExpression>
    </variable>

    <!-- Title / Header -->
    <title>
        <band height="75" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="65" backcolor="#1B4372" uuid="939fa421-df54-4530-84cf-81b241320db9"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="10" width="380" height="24" forecolor="#FFFFFF" uuid="6246419a-9e19-4cb3-a5ff-e3801f948f9d"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[EXPRESS CLEAR - CTS ADMIN PORTAL]]></text>
            </staticText>
            <staticText>
                <reportElement x="16" y="36" width="380" height="16" forecolor="#E2E8F0" uuid="7cf7ad78-9e58-47bc-ba92-f04bf025537d"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[Consolidated Outward Clearing Operations Report]]></text>
            </staticText>
            <textField>
                <reportElement x="480" y="12" width="306" height="16" forecolor="#FFFFFF" uuid="eef6412f-916c-4ec8-b391-9957790b1c03"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Clearing Period: " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{FROM_DATE}) + " to " + new java.text.SimpleDateFormat("yyyy-MM-dd").format($P{TO_DATE})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="32" width="306" height="16" forecolor="#CBD5E1" uuid="bb3b7194-911e-450a-9d2a-4318357f8674"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated By: " + $P{GENERATED_BY} + " | Time: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

