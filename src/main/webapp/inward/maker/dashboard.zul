<?xml version="1.0" encoding="UTF-8"?>
<zk>

	<style src="/css/inward/maker-dashboard.css" />

	<div id="inwardMakerDivDashboard" width="100%" height="100%"
		apply="com.iispl.cts.controller.inward.maker.InwardMakerDashboardController"
		sclass="inward-maker-dashboard">

		<div sclass="inward-maker-dashboard-scroll" width="100%"
			height="100%">

			<!-- Welcome Banner -->
			<div sclass="inward-maker-welcome-section">
				<label value="Welcome, Maker"
					sclass="inward-maker-welcome-title" />
				<label
					value="Manage and process inward cheque batches."
					sclass="inward-maker-welcome-subtitle" />
			</div>

			<!-- Section 1: Return From Checker -->
			<div sclass="inward-maker-return-section">
				<div sclass="inward-maker-section-header">
					<div>
						<label value="Return From Checker"
							sclass="inward-maker-section-title" />
						<label
							value="Cheques returned by Checker that require Maker action."
							sclass="inward-maker-section-subtitle" />
					</div>
				</div>

				<div sclass="inward-maker-table-card">
					<grid id="inwardMakerGridReturnedBatches"
						width="100%" sclass="inward-maker-batch-grid">
						<columns sizable="true">
							<column label="Batch ID" width="20%" />
							<column label="Cheque Number" width="20%" />
							<column label="Status" width="25%" />
							<column label="Reason / Remarks" width="20%" />
							<column label="Action" width="15%" />
						</columns>
						<rows id="inwardMakerRowsReturnedBatches" />
					</grid>

					<vlayout id="inwardMakerVlayoutReturnedEmptyState"
						visible="false" sclass="inward-maker-empty-state">
						<label value="No returned cheques found"
							sclass="inward-maker-empty-title" />
						<label
							value="There are currently no cheques returned by Checker."
							sclass="inward-maker-empty-subtitle" />
					</vlayout>
				</div>
			</div>

			<space height="38px" />

			<!-- Section 2: Batches Processing -->
			<div sclass="inward-maker-processing-section">
				<div sclass="inward-maker-section-header">
					<div>
						<label value="Batches Processing"
							sclass="inward-maker-section-title" />
						<label
							value="Batches available for inward processing."
							sclass="inward-maker-section-subtitle" />
					</div>
				</div>

				<div sclass="inward-maker-table-card">
					<grid id="inwardMakerGridBatchDetails" width="100%"
						sclass="inward-maker-batch-grid">
						<columns sizable="true">
							<column label="Batch ID" width="20%" />
							<column label="No. of Cheques" width="20%" />
							<column label="Total Amount" width="20%" />
							<column label="Status" width="20%" />
							<column label="Action" width="20%" />
						</columns>
						<rows id="inwardMakerRowsBatchDetails" />
					</grid>

					<vlayout id="inwardMakerVlayoutEmptyState"
						visible="false" sclass="inward-maker-empty-state">
						<label value="No new processing batches found"
							sclass="inward-maker-empty-title" />
						<label
							value="There are currently no batches available for inward processing."
							sclass="inward-maker-empty-subtitle" />
					</vlayout>
				</div>

				<!-- Centered Pagination Bar -->
				<div sclass="inward-maker-pagination">
					<button id="inwardMakerBtnFirst" label="&lt;&lt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnPrevious" label="&lt;"
						sclass="inward-maker-pagination-button" />
					<label id="inwardMakerLblCurrentPage" value="1 / 1"
						sclass="inward-maker-pagination-label" />
					<button id="inwardMakerBtnNext" label="&gt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnLast" label="&gt;&gt;"
						sclass="inward-maker-pagination-button" />
				</div>
			</div>

		</div>
	</div>
</zk>