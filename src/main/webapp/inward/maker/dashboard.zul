<?xml version="1.0" encoding="UTF-8"?>
<zk>

	<style src="/css/inward/maker-dashboard.css" />

	<div id="inwardMakerDivDashboard" width="100%" height="100%"
		apply="com.iispl.cts.controller.inward.maker.InwardMakerDashboardController"
		sclass="inward-maker-dashboard">

		<div sclass="inward-maker-dashboard-scroll" width="100%"
			height="100%">

			<!-- Filter Card: Title on top line, Controls on next line -->
			<div sclass="inward-maker-filter-card">
				
				<!-- Line 1: Header Label -->
				<div sclass="inward-maker-filter-title-box">
					<label value="Search &amp; Filter" sclass="inward-maker-filter-heading" />
				</div>

				<!-- Line 2: Search Box, Comboboxes, and Buttons -->
				<hlayout spacing="12px" sclass="inward-maker-filter-controls z-valign-middle">
					
					<!-- Search by Batch ID only -->
					<textbox id="inwardMakerTxtSearch" 
						placeholder="Search by Batch ID..." 
						width="240px" 
						sclass="inward-maker-input" />

					<!-- Module Dropdown -->
					<combobox id="inwardMakerCmbModule" 
						placeholder="All Modules" 
						readonly="true" 
						width="190px" 
						sclass="inward-maker-combobox">
						<comboitem label="All Modules" value="ALL" />
						<comboitem label="Return from Checker" value="RETURN_FROM_CHECKER" />
						<comboitem label="Batches Processing" value="BATCH_PROCESSING" />
					</combobox>

					<!-- Status Dropdown -->
					<combobox id="inwardMakerCmbStatus" 
						placeholder="All Statuses" 
						readonly="true" 
						width="180px" 
						sclass="inward-maker-combobox">
						<comboitem label="All Statuses" value="ALL" />
						<comboitem label="Pending Data Entry" value="PENDING_DATA_ENTRY" />
						<comboitem label="Pending MICR Repair" value="PENDING_MICR_REPAIR" />
						<comboitem label="Fix Data Entry" value="FIX DATA ENTRY" />
						<comboitem label="Needs Rework" value="NEEDS REWORK" />
					</combobox>

					<!-- Action Buttons -->
					<button id="inwardMakerBtnSearch" 
						label="SEARCH" 
						iconSclass="z-icon-search"
						sclass="inward-maker-btn-action-search" />
					<button id="inwardMakerBtnClear" 
						label="CLEAR" 
						iconSclass="z-icon-undo"
						sclass="inward-maker-btn-action-clear" />

				</hlayout>
			</div>

			<!-- Section 1: Return From Checker -->
			<div id="inwardMakerReturnSection" sclass="inward-maker-return-section">
				<div sclass="inward-maker-section-header">
					<div>
						<label value="Return From Checker"
							sclass="inward-maker-section-title" />
						<label
							value="Cheques returned by Checker that require Maker action."
							sclass="inward-maker-section-subtitle" />
					</div>
				</div>

				<div sclass="inward-maker-table-card">
					<grid id="inwardMakerGridReturnedBatches"
						width="100%" sclass="inward-maker-batch-grid">
						<columns sizable="true">
							<column label="Batch ID" width="20%" />
							<column label="Cheque Number" width="20%" />
							<column label="Status" width="25%" />
							<column label="Reason / Remarks" width="20%" />
							<column label="Action" width="15%" />
						</columns>
						<rows id="inwardMakerRowsReturnedBatches" />
					</grid>

					<vlayout id="inwardMakerVlayoutReturnedEmptyState"
						visible="false" sclass="inward-maker-empty-state">
						<label value="No returned cheques found"
							sclass="inward-maker-empty-title" />
						<label
							value="There are currently no cheques returned by Checker."
							sclass="inward-maker-empty-subtitle" />
					</vlayout>
				</div>

				<!-- Section 1 Pagination Bar -->
				<div id="inwardMakerReturnPaginationBar" sclass="inward-maker-pagination">
					<button id="inwardMakerBtnReturnFirst" label="&lt;&lt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnReturnPrevious" label="&lt;"
						sclass="inward-maker-pagination-button" />
					<label id="inwardMakerLblReturnCurrentPage" value="1 / 1"
						sclass="inward-maker-pagination-label" />
					<button id="inwardMakerBtnReturnNext" label="&gt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnReturnLast" label="&gt;&gt;"
						sclass="inward-maker-pagination-button" />
				</div>
			</div>

			<space id="inwardMakerSectionSpacer" height="34px" />

			<!-- Section 2: Batches Processing -->
			<div id="inwardMakerProcessingSection" sclass="inward-maker-processing-section">
				<div sclass="inward-maker-section-header">
					<div>
						<label value="Batches Processing"
							sclass="inward-maker-section-title" />
						<label
							value="Batches available for inward processing."
							sclass="inward-maker-section-subtitle" />
					</div>
				</div>

				<div sclass="inward-maker-table-card">
					<grid id="inwardMakerGridBatchDetails" width="100%"
						sclass="inward-maker-batch-grid">
						<columns sizable="true">
							<column label="Batch ID" width="20%" />
							<column label="No. of Cheques" width="20%" />
							<column label="Total Amount" width="20%" />
							<column label="Status" width="20%" />
							<column label="Action" width="20%" />
						</columns>
						<rows id="inwardMakerRowsBatchDetails" />
					</grid>

					<vlayout id="inwardMakerVlayoutEmptyState"
						visible="false" sclass="inward-maker-empty-state">
						<label value="No new processing batches found"
							sclass="inward-maker-empty-title" />
						<label
							value="There are currently no batches available for inward processing."
							sclass="inward-maker-empty-subtitle" />
					</vlayout>
				</div>

				<!-- Section 2 Pagination Bar -->
				<div id="inwardMakerPaginationBar" sclass="inward-maker-pagination">
					<button id="inwardMakerBtnFirst" label="&lt;&lt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnPrevious" label="&lt;"
						sclass="inward-maker-pagination-button" />
					<label id="inwardMakerLblCurrentPage" value="1 / 1"
						sclass="inward-maker-pagination-label" />
					<button id="inwardMakerBtnNext" label="&gt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnLast" label="&gt;&gt;"
						sclass="inward-maker-pagination-button" />
				</div>
			</div>

		</div>
	</div>
</zk>