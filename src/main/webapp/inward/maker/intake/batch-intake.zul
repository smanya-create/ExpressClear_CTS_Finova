<?xml version="1.0" encoding="UTF-8"?>

<zk>

	<window id="inwardBatchQueueWindow" title="Inward Batch Queue"
		border="normal" width="95%"
		apply="com.iispl.cts.controller.inward.maker.InwardBatchController">

		<style>

			.search-section { background: #ffffff; border: 1px solid
			#d9e2ec; border-radius: 8px; padding: 22px; margin-bottom:
			28px; }

			.section-title { font-size: 20px; font-weight: bold; color:
			#164e87; margin-bottom: 18px; }

			.field-label { font-size: 14px; font-weight: bold; color:
			#164e87; margin-bottom: 7px; }

			.input-field { height: 38px; border: 1px solid #cbd5e1;
			border-radius: 5px; padding-left: 10px; }

			.search-button { background: #1769d1; color: white; border:
			none; border-radius: 5px; height: 38px; padding-left: 25px;
			padding-right: 25px; font-weight: bold; }

			.batch-section { background: #ffffff; border: 1px solid
			#d9e2ec; border-radius: 8px; padding: 22px; }

			.batch-title { font-size: 20px; font-weight: bold; color:
			#164e87; }

			.batch-subtitle { font-size: 14px; color: #718096;
			margin-top: 5px; margin-bottom: 18px; }

			.batch-listbox { width: 100%; border: 1px solid #d9e2ec; }

			.batch-listbox .z-listheader { background: #1769d1; color:
			white; font-size: 15px; font-weight: bold; text-align:
			center; }

			.batch-listbox .z-listcell { text-align: center;
			vertical-align: middle; padding: 14px 8px; font-size: 14px;
			}

			.validate-button { background: #1597e5; color: white;
			border: none; border-radius: 5px; padding: 9px 22px;
			font-weight: bold; }

			.micr-repair-button { background: #059669; color: white;
			border: none; border-radius: 5px; padding: 9px 18px;
			font-weight: bold; }

			.status-pending { background: #fff1cc; color: #c47b00;
			border-radius: 15px; padding: 6px 14px; font-weight: bold; }

			.status-validated { background: #d1fae5; color: #047857;
			border-radius: 15px; padding: 6px 14px; font-weight: bold; }

			.status-failed { background: #fee2e2; color: #dc2626;
			border-radius: 15px; padding: 6px 14px; font-weight: bold; }

		</style>

		<vlayout width="100%" style="padding:25px;">

			<div sclass="search-section">

				<label value="SEARCH BATCH" sclass="section-title" />

				<hlayout width="100%" spacing="20px">

					<vlayout hflex="1">

						<label value="Batch No." sclass="field-label" />

						<textbox id="batchSearchTextbox"
							placeholder="Batch No." width="100%" sclass="input-field" />

					</vlayout>

					<vlayout width="220px">

						<label value="Status" sclass="field-label" />

						<combobox id="statusCombobox" width="100%"
							value="All">

							<comboitem label="All" />
							<comboitem label="Pending Validation" />
							<comboitem label="Validated" />
							<comboitem label="Validation Failed" />

						</combobox>

					</vlayout>

					<vlayout width="250px">

						<label value="Received Date"
							sclass="field-label" />

						<datebox id="receivedDatebox" width="100%"
							placeholder="Select Date" />

					</vlayout>

					<vlayout width="120px">

						<space height="27px" />

						<button id="searchButton" label="Search"
							width="100%" sclass="search-button" />

					</vlayout>

				</hlayout>

			</div>

			<div sclass="batch-section">

				<vlayout width="100%">

					<label value="Received Inward Batches"
						sclass="batch-title" />

					<label
						value="Validate each batch before it enters MICR Repair."
						sclass="batch-subtitle" />

				</vlayout>

				<listbox id="batchListbox" width="100%"
					sclass="batch-listbox">

					<listhead>

						<listheader label="Batch No." width="20%" />

						<listheader label="Received On" width="20%" />

						<listheader label="Amount" width="20%" />

						<listheader label="Status" width="20%" />

						<listheader label="Action" width="20%" />

					</listhead>

				</listbox>

			</div>

		</vlayout>

	</window>

</zk>