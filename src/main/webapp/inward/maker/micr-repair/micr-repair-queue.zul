<?xml version="1.0" encoding="UTF-8"?>

<?page title="MICR Repair Queue" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/inward/micr-repair-queue.css" />

	<vlayout id="micrRepairQueueRoot"
		apply="com.iispl.cts.controller.inward.maker.InwardMicrRepairQueueController"
		sclass="micr-repair-queue-page" width="100%" spacing="0">

		<!-- Page Heading -->
		<hlayout sclass="page-heading-row" width="100%"
			valign="middle">

			<vlayout spacing="2px" hflex="1">
				<label value="MICR Repair Queue" sclass="page-title" />

				<label
					value="Inward — Select a batch containing cheques that require MICR repair."
					sclass="page-subtitle" />
			</vlayout>

		</hlayout>


		<div sclass="queue-card">

			<hlayout sclass="queue-card-header" width="100%"
				valign="middle">

				<vlayout spacing="2px" hflex="1">
					<label value="Batches Requiring MICR Repair"
						sclass="card-title" />

					<label
						value="Open a batch to view and repair its flagged cheques."
						sclass="card-subtitle" />
				</vlayout>

			</hlayout>



			<listbox id="batchQueueList" sclass="batch-queue-list"
				width="100%" mold="paging" pageSize="10"
				emptyMessage="No batches are currently pending MICR repair.">

				<listhead sizable="true">

					<listheader label="Batch ID" width="18%" />

					<listheader label="Received" width="18%" />

					<listheader label="Total Cheques" width="14%"
						align="center" />

					<listheader label="MICR Repair Pending" width="18%"
						align="center" />

					<listheader label="Status" width="16%"
						align="center" />

					<listheader label="Action" width="16%"
						align="center" />

				</listhead>


				<template name="model">

					<listitem value="${each.inwardBatchId}">

						<listcell>
							<label value="${each.inwardBatchId}"
								sclass="batch-id" />
						</listcell>

						<listcell>
							<label value="${each.uploadedAt}"
								sclass="table-text" />
						</listcell>

						<listcell>
							<label value="${each.actualChequeCount}"
								sclass="count-text" />
						</listcell>

						<listcell>
							<label
								value="${each.micrRepairPendingCount}"
								sclass="status-badge pending-status" />
						</listcell>

						<listcell>
							<label value="${each.batchStatus}"
								sclass="status-badge pending-status" />
						</listcell>

						<listcell>
							<button label="Open" sclass="open-button"
								onClick="$composer.openBatch(self.getParent().getParent().getValue())" />
						</listcell>

					</listitem>

				</template>


			</listbox>

		</div>

	</vlayout>

</zk>