<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Inward MICR Repair" contentType="text/html;charset=UTF-8"?>

<zk>
	<style src="/css/inward/micr-repair-queue.css" />

	<div id="micrRepairQueueRoot"
		width="100%"
		height="100%"
		apply="com.iispl.cts.controller.inward.maker.InwardMicrRepairQueueController"
		sclass="micr-repair-view-page"
		style="overflow-y: auto; overflow-x: hidden;">

		<vlayout width="100%" spacing="16px">

			<!-- ================================================= -->
			<!-- PAGE TITLE (Outward Header Style) -->
			<!-- ================================================= -->
			<vlayout spacing="4px" sclass="micr-repair-view-title-section">
				<label value="MICR REPAIR" sclass="micr-repair-view-title" />
			</vlayout>

			<!-- ================================================= -->
			<!-- SINGLE TABLE CARD -->
			<!-- ================================================= -->
			<div sclass="micr-repair-section-card" width="100%">

				<vlayout width="100%" spacing="12px">

					<!-- Section Header & Result Count -->
					<hlayout width="100%" valign="middle" style="display: flex; justify-content: space-between; align-items: center;">
						<vlayout spacing="3px">
							<label value="Batches Requiring MICR Repair" sclass="micr-repair-section-title" />
						</vlayout>
						<label id="batchResultCount" value="0 Batches" sclass="batch-result-count" />
					</hlayout>

					<!-- Filter Toolbar -->
					<div sclass="micr-repair-filter-bar">
						<hlayout valign="middle" spacing="12px">
							<label value="Search Batch ID" sclass="filter-label" />
							<textbox id="batchIdFilter"
								placeholder="Enter full or partial Batch ID"
								width="360px"
								sclass="batch-filter-input"
								onChanging="$composer.onChanging$batchIdFilter(event)" />
							<button id="btnClearFilter"
								label="Clear"
								sclass="clear-filter-button"
								onClick="$composer.clearBatchFilter()" />
						</hlayout>
					</div>

					<!-- Single Outward-style Grid -->
					<grid id="grdMicrRepairBatches" width="100%" sclass="micr-repair-grid">
						<columns sizable="false">
							<column label="BATCH" width="18%" align="center" />
							<column label="RECEIVED DATE" width="18%" align="center" />
							<column label="TOTAL CHEQUES" width="16%" align="center" />
							<column label="MICR ERRORS" width="16%" align="center" />
							<column label="STATUS" width="16%" align="center" />
							<column label="ACTION" width="16%" align="center" />
						</columns>
						<rows id="rowsMicrRepairBatches" />
					</grid>

					<!-- Outward-style Pagination -->
					<paging id="pagingMicrRepair"
						pageSize="10"
						detailed="true"
						sclass="micr-repair-paging" />

					<!-- Empty Message Card -->
					<div id="divMicrRepairEmpty" width="100%" visible="false" sclass="micr-repair-empty-card">
						<vlayout width="100%" spacing="6px">
							<label value="No MICR repair required" sclass="micr-repair-empty-title" />
							<label value="There are currently no inward batches requiring MICR repair." sclass="micr-repair-empty-message" />
						</vlayout>
					</div>

				</vlayout>

			</div>

		</vlayout>

	</div>
</zk>