<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - MICR Repair" contentType="text/html;charset=UTF-8"?>


<zk>

  <style src="/css/inward/micr-repair.css"/>
  
    <vlayout id="inwardMicrRepairRoot" width="100%"
             apply="com.iispl.cts.controller.inward.maker.InwardMicrRepairControllerr"
             spacing="14px" sclass="micr-repair-page">

        <hlayout width="100%" valign="middle" sclass="page-heading-row">
            <vlayout spacing="2px">
                <label value="MICR Repair" sclass="page-title" />
                <label value="Inward — Fix OCR errors for flagged cheques." sclass="page-subtitle" />
            </vlayout>
            <separator hflex="1" />
            <button id="btnBackToList" label="← Back to List" sclass="secondary-button" />
        </hlayout>

        <hlayout width="100%" valign="middle" sclass="batch-navigation-row">
            <label id="lblBatchId" value="BATCH: —" sclass="batch-pill" />
            <separator hflex="1" />
            <button id="btnPrevious" label="← Prev" sclass="small-button" />
            <label id="lblRecordPosition" value="No records" sclass="record-position" />
            <button id="btnNext" label="Next →" sclass="small-button" />
        </hlayout>

        <hlayout width="100%" spacing="16px" valign="top" sclass="repair-workspace">

            <panel hflex="5" sclass="workspace-card">
                <caption label="Cheque Image" />
                <panelchildren>
                    <vlayout width="100%" spacing="12px" sclass="image-panel-content">
                        <image id="chequeImage" visible="false" width="100%" sclass="cheque-image" />

                        <groupbox id="emptyImageState" sclass="empty-image-state">
                            <caption label="Cheque image unavailable" />
                            <label value="The cheque image will be loaded from the database when a repair record is available." />
                        </groupbox>

                        <separator />
                        <label value="OCR-filled MICR values are shown in blue. Verify them against the cheque image." sclass="image-help-text" />
                    </vlayout>
                </panelchildren>
            </panel>

            <panel hflex="5" sclass="workspace-card">
                <caption>
                    <hlayout width="100%" valign="middle">
                        <label value="MICR Data Entry" sclass="card-title" />
                        <separator hflex="1" />
                        <label id="lblRepairStatus" value="MICR ERROR" sclass="error-status" />
                    </hlayout>
                </caption>

                <panelchildren>
                    <vlayout width="100%" spacing="12px" sclass="form-panel-content">
                        <grid sclass="micr-form-grid">
                            <columns>
                                <column hflex="1" />
                                <column hflex="1" />
                            </columns>
                            <rows>
                                <row>
                                    <vlayout spacing="4px">
                                        <label value="CHEQUE NUMBER *" sclass="field-label" />
                                        <textbox id="txtChequeNumber" readonly="true" sclass="readonly-field" />
                                    </vlayout>
                                    <vlayout spacing="4px">
                                        <label value="CITY CODE *" sclass="field-label" />
                                        <textbox id="txtCityCode" readonly="true" sclass="ocr-field" />
                                    </vlayout>
                                </row>
                                <row>
                                    <vlayout spacing="4px">
                                        <label value="BANK CODE *" sclass="field-label" />
                                        <textbox id="txtBankCode" readonly="true" sclass="ocr-field" />
                                    </vlayout>
                                    <vlayout spacing="4px">
                                        <label value="BRANCH CODE *" sclass="field-label" />
                                        <textbox id="txtBranchCode" readonly="true" sclass="ocr-field" />
                                    </vlayout>
                                </row>
                                <row>
                                    <vlayout spacing="4px">
                                        <label value="CURRENT MICR CODE *" sclass="field-label" />
                                        <textbox id="txtCurrentMicr" readonly="true" sclass="error-field" />
                                    </vlayout>
                                    <vlayout spacing="4px">
                                        <label value="TRANSACTION CODE *" sclass="field-label" />
                                        <textbox id="txtTransactionCode" readonly="true" sclass="ocr-field" />
                                    </vlayout>
                                </row>
                              <row>
    <cell colspan="2">
        <vlayout spacing="4px" width="100%">
            <label value="CORRECTED MICR CODE *" sclass="field-label"/>
            <textbox id="txtCorrectedMicr"
                     placeholder="Enter corrected MICR code"
                     width="100%"
                     sclass="correction-field"/>
        </vlayout>
    </cell>
</row>
                               <row>
    <cell colspan="2">
        <vlayout spacing="4px" width="100%">
            <label value="REMARKS" sclass="field-label"/>
            <textbox id="txtRemarks"
                     placeholder="Optional remarks"
                     rows="2"
                     width="100%"
                     sclass="remarks-field"/>
        </vlayout>
    </cell>
</row>
                            </rows>
                        </grid>

                        <vlayout spacing="4px">
                            <progressmeter id="progressMeter" value="0" sclass="repair-progress" />
                            <hlayout width="100%">
                                <label value="Progress" sclass="progress-label" />
                                <separator hflex="1" />
                                <label id="lblProgress" value="0 / 0" sclass="progress-label" />
                            </hlayout>
                        </vlayout>

                        <button id="btnSaveAndNext" label="Save &amp; Next" width="100%" sclass="primary-button" />
                        <button id="btnRejectRequest" label="Reject Request" width="100%" sclass="reject-button" />
                    </vlayout>
                </panelchildren>
            </panel>
        </hlayout>

        <hlayout width="100%" sclass="page-footer">
            <label value="ClearPay CTS • Inward Operations" sclass="footer-text" />
            <separator hflex="1" />
            <label value="MICR Repair" sclass="footer-text" />
        </hlayout>
    </vlayout>
</zk>
