<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - MICR Repair" contentType="text/html;charset=UTF-8"?>

<zk>

	<style src="/css/inward/micr-repair.css" />

	<vlayout id="inwardMicrRepairRoot" width="100%" spacing="6px"
		sclass="micr-repair-page">


		<hlayout width="100%" valign="middle"
			sclass="page-heading-row">
			<vlayout spacing="1px">
				<label value="MICR Repair" sclass="page-title" />
				<label
					value="Inward — Fix OCR errors for flagged cheques."
					sclass="page-subtitle" />
			</vlayout>

			<separator hflex="1" />

			<button id="btnBackToList" label="← Back to List"
				sclass="secondary-button" />
		</hlayout>


		<hlayout width="100%" valign="middle"
			sclass="batch-navigation-row">
			<grid sclass="batch-summary-grid">
				<columns>
					<column width="14%" />
					<column width="14%" />
					<column width="15%" />
					<column width="15%" />
					<column width="22%" />
					<column width="20%" />
				</columns>
				<rows>
					<row>
						<vlayout spacing="1px">
							<label value="BATCH ID"
								sclass="batch-label-cell" />
							<label id="lblBatchId"
								sclass="batch-val-cell" />
						</vlayout>
						<vlayout spacing="1px">
							<label value="SOURCE"
								sclass="batch-label-cell" />
							<label id="lblBatchSource"
								sclass="batch-val-cell" />
						</vlayout>
						<vlayout spacing="1px">
							<label value="TOTAL CHEQUES"
								sclass="batch-label-cell" />
							<label id="lblTotalCheques"
								sclass="batch-val-cell" />
						</vlayout>
						<vlayout spacing="1px">
							<label value="CHEQUE NO."
								sclass="batch-label-cell" />
							<label id="lblHeaderChequeNo"
								sclass="batch-val-cell" />
						</vlayout>
						<vlayout spacing="1px">
							<label value="ITEM STATUS"
								sclass="batch-label-cell" />
							<label id="lblHeaderItemStatus"
								sclass="batch-pill" />
						</vlayout>
						<vlayout spacing="1px">
							<label value="RECEIVED DATE"
								sclass="batch-label-cell" />
							<label id="lblReceivedDate"
								sclass="batch-val-cell" />
						</vlayout>
					</row>
				</rows>
			</grid>
		</hlayout>


		<hlayout width="100%" spacing="12px" valign="stretch"
			sclass="repair-workspace">


			<panel hflex="5" sclass="workspace-card">
				<caption label="Cheque Image" />
				<panelchildren>
					<vlayout width="100%" spacing="8px"
						sclass="image-panel-content">

						<hlayout width="100%" valign="middle"
							spacing="8px" sclass="cheque-navigation-row">
							<separator hflex="1" />
							<label id="lblRecordPosition"
								sclass="record-position" />
							<button id="btnPrevious" label="← Prev"
								sclass="small-button" />
							<button id="btnNext" label="Next →"
								sclass="small-button" />
						</hlayout>

						<image id="chequeImage" visible="false"
							width="100%" sclass="cheque-image" />

						<groupbox id="emptyImageState"
							sclass="empty-image-state">
							<caption label="Cheque image unavailable" />
							<label
								value="The cheque image will be loaded from the database when a repair record is available." />
						</groupbox>

						<label
							value="OCR-filled MICR values are shown in blue. Verify them against the cheque image."
							sclass="image-help-text" />
					</vlayout>
				</panelchildren>
			</panel>


			<panel hflex="5" sclass="workspace-card">
				<caption>
					<hlayout width="100%" valign="middle">
						<label value="MICR Data Entry"
							sclass="card-title" />
						<separator hflex="1" />
						<label id="lblRepairStatus" value="MICR ERROR"
							sclass="error-status" />
					</hlayout>
				</caption>

				<panelchildren>
					<vlayout width="100%" spacing="8px"
						sclass="form-panel-content">


						<grid sclass="micr-form-grid">
							<columns>
								<column hflex="1" />
								<column hflex="1" />
							</columns>
							<rows>
								<row>
									<vlayout spacing="2px">
										<label value="CHEQUE NUMBER *"
											sclass="field-label" />
										<textbox id="txtChequeNumber"
											readonly="true" sclass="readonly-field" />
									</vlayout>
									<vlayout spacing="2px">
										<label value="CITY CODE *"
											sclass="field-label" />
										<textbox id="txtCityCode"
											readonly="true" sclass="ocr-field" />
									</vlayout>
								</row>

								<row>
									<vlayout spacing="2px">
										<label value="BANK CODE *"
											sclass="field-label" />
										<textbox id="txtBankCode"
											readonly="true" sclass="ocr-field" />
									</vlayout>
									<vlayout spacing="2px">
										<label value="BRANCH CODE *"
											sclass="field-label" />
										<textbox id="txtBranchCode"
											readonly="true" sclass="ocr-field" />
									</vlayout>
								</row>

								<row>
									<vlayout spacing="2px">
										<label
											value="CURRENT MICR CODE *" sclass="field-label" />
										<textbox id="txtCurrentMicr"
											readonly="true" sclass="error-field" />
									</vlayout>
									<vlayout spacing="2px">
										<label
											value="TRANSACTION CODE *" sclass="field-label" />
										<textbox id="txtTransactionCode"
											readonly="true" sclass="ocr-field" />
									</vlayout>
								</row>

								<row>
									<cell colspan="2">
										<vlayout width="100%"
											spacing="2px">
											<label
												value="CORRECTED MICR CODE *" sclass="field-label" />
											<textbox
												id="txtCorrectedMicr" width="100%"
												placeholder="Enter corrected MICR code"
												sclass="correction-field" />
										</vlayout>
									</cell>
								</row>

								<row>
									<cell colspan="2">
										<vlayout width="100%"
											spacing="2px">
											<label value="REMARKS"
												sclass="field-label" />
											<textbox id="txtRemarks"
												width="100%" rows="2" placeholder="Optional remarks"
												sclass="remarks-field" />
										</vlayout>
									</cell>
								</row>
							</rows>
						</grid>


						<vlayout spacing="2px">
							<progressmeter id="progressMeter" value="0"
								sclass="repair-progress" />
							<hlayout width="100%">
								<label value="Progress"
									sclass="progress-label" />
								<separator hflex="1" />
								<label id="lblProgress"
									sclass="progress-label" />
							</hlayout>
						</vlayout>


						<hlayout width="100%" spacing="8px">
							<separator hflex="1" />
							<button id="btnSaveAndNext"
								label="Save &amp; Next" sclass="primary-button" />
							<button id="btnRejectRequest"
								label="Reject Request" sclass="reject-button" />
						</hlayout>

					</vlayout>
				</panelchildren>
			</panel>

		</hlayout>


		<hlayout width="100%" sclass="page-footer">
			<label value="ClearPay CTS • Inward Operations"
				sclass="footer-text" />
			<separator hflex="1" />
			<label value="MICR Repair" sclass="footer-text" />
		</hlayout>


		<window id="rejectRequestWindow"
			title="Reject MICR Repair Request" mode="modal" visible="false"
			closable="true" width="430px" sclass="reject-modal">
			<vlayout width="100%" spacing="12px">
				<label
					value="Select the reason for sending this cheque to the checker."
					sclass="modal-description" />
				<vlayout width="100%" spacing="4px">
					<label value="Rejection Reason *"
						sclass="field-label" />
					<combobox id="cmbRejectReason" width="100%"
						placeholder="Select rejection reason" readonly="true" />
				</vlayout>
				<hlayout width="100%" spacing="8px">
					<separator hflex="1" />
					<button id="btnCancelReject" label="Cancel"
						sclass="secondary-button" />
					<button id="btnConfirmReject" label="Reject Request"
						sclass="reject-button" />
				</hlayout>
			</vlayout>
		</window>

	</vlayout>

</zk>