<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="xhtml">
	<style src="/css/inward/data-entry.css" />
	<style>
		.cts-compact-progress .z-progressmeter-img { 
			background-image: none !important; 
			background-color: #2563eb !important;
			transition: width 0.3s ease-in-out !important; 
		}
		.cts-badge-data-entry { 
			display: inline-block; 
			padding: 1px 8px; 
			border-radius: 10px; 
			font-size: 10px; 
			font-weight: 700;
			white-space: nowrap; 
			background-color: #fef3c7; 
			color: #d97706;
			border: 1px solid #fde68a; 
		} 
		.cts-modal-backdrop { 
			position: fixed; 
			top: 0; 
			left: 0; 
			width: 100vw; 
			height: 100vh; 
			background: rgba(15, 23, 42, 0.65); 
			z-index: 10000; 
			display: flex;
			align-items: center; 
			justify-content: center; 
		} 
		.cts-modal-box {
			background: #ffffff; 
			width: 460px; 
			border-radius: 8px; 
			padding: 18px; 
			box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); 
		}
		.cts-btn-submit-batch {
			background-color: #059669 !important;
			border: 1px solid #059669 !important;
			color: #ffffff !important;
			font-weight: 700 !important;
			font-size: 13px !important;
			height: 36px !important;
			border-radius: 6px !important;
			cursor: pointer !important;
			box-shadow: 0 2px 4px rgba(5, 150, 105, 0.2) !important;
			transition: all 0.2s ease !important;
		}
		.cts-btn-submit-batch[disabled] {
			background-color: #e2e8f0 !important;
			border-color: #cbd5e1 !important;
			color: #94a3b8 !important;
			cursor: not-allowed !important;
			box-shadow: none !important;
		}
		.cts-work-card {
			padding: 12px 16px !important;
		}
		.cts-form-row {
			margin-bottom: 6px !important;
			display: flex;
			gap: 10px;
		}
		.cts-form-field {
			flex: 1;
		}
		.cts-field-lbl {
			font-size: 11px !important;
			font-weight: 600;
			color: #334155;
			margin-bottom: 2px;
			display: block;
		}
		.cts-input-text {
			height: 28px !important;
			font-size: 12px !important;
			padding: 3px 8px !important;
		}
	</style>

	<div id="dataEntryRootDiv" class="cts-data-entry-wrapper" style="padding: 10px 16px;"
		apply="com.iispl.cts.controller.inward.maker.InwardDataEntryController">

		<!-- Top Header Bar -->
		<div class="cts-title-group"
			style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
			<div>
				<label value="Inward Data Entry" class="cts-main-title" style="font-size: 17px; font-weight: 700; color: #0f172a;" />
				<label value="Review, edit, and decision individual cheques for inward clearing."
					class="cts-main-subtitle" style="font-size: 11px; color: #64748b; margin-left: 8px;" />
			</div>

			<hlayout spacing="10px" valign="middle"
				style="background: #ffffff; padding: 4px 12px; border: 1px solid #e2e8f0; border-radius: 6px;">
				<hlayout spacing="6px" valign="middle">
					<progressmeter id="pmBatchProgress" value="0"
						width="100px" class="cts-compact-progress"
						style="height: 6px; border-radius: 3px; background: #e2e8f0;" />
					<label id="lblProgressText" value="0/0 (0%)"
						style="font-size: 11px; font-weight: 700; color: #475569;" />
				</hlayout>
				<separator orient="vertical" bar="true" style="height: 16px;" />
				<hlayout spacing="6px" valign="middle">
					<button id="btnPrevCheque" label="Prev"
						iconSclass="z-icon-chevron-left" class="cts-btn-secondary"
						style="height: 26px; padding: 0 8px; font-size: 11px;" />
					<label id="lblChequePosition" value="1 of 1"
						style="font-size: 11px; font-weight: 800; color: #1e293b; min-width: 40px; text-align: center;" />
					<button id="btnNextCheque" label="Next"
						iconSclass="z-icon-chevron-right" class="cts-btn-secondary"
						style="height: 26px; padding: 0 8px; font-size: 11px;" />
				</hlayout>
			</hlayout>
		</div>

		<!-- 6-Column Metadata Card -->
		<div id="metadataCardDiv" class="cts-metadata-card"
			style="display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 6px 14px; margin-bottom: 10px;">
			<div class="cts-meta-col" style="flex: 1;">
				<label value="BATCH ID" class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<label id="lblBatchId" value="-" class="cts-meta-val" style="font-size: 12px; font-weight: 700; color: #0f172a; display: block;" />
			</div>
			<div class="cts-meta-col" style="flex: 0.8;">
				<label value="SOURCE" class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<label id="lblSource" value="CHI" class="cts-meta-val" style="font-size: 12px; font-weight: 700; color: #0f172a; display: block;" />
			</div>
			<div class="cts-meta-col" style="flex: 0.8;">
				<label value="TOTAL CHEQUES" class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<label id="lblTotalCheques" value="0" class="cts-meta-val" style="font-size: 12px; font-weight: 700; color: #0f172a; display: block;" />
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="CHEQUE NO." class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<label id="lblChequeNo" value="-" class="cts-meta-val" style="font-size: 12px; font-weight: 700; color: #0f172a; display: block;" />
			</div>
			<div class="cts-meta-col" style="flex: 1.2;">
				<label value="ITEM STATUS" class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<div>
					<label id="lblDataStatus" value="PENDING" class="cts-badge-data-entry" />
				</div>
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="RECEIVED DATE" class="cts-meta-header" style="font-size: 10px; color: #64748b; font-weight: 600;" />
				<label id="lblReceivedDate" value="-" class="cts-meta-val" style="font-size: 12px; font-weight: 700; color: #0f172a; display: block;" />
			</div>
		</div>

		<!-- 2-Column Main Workspace -->
		<div id="workspaceGridDiv" class="cts-data-entry-grid" style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 14px;">

			<!-- Left Card: Cheque Viewer -->
			<div class="cts-work-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
				<hlayout style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
					<div>
						<label value="CHEQUE IMAGE" class="cts-card-title" style="font-size: 13px; font-weight: 700; color: #0f172a;" />
						<label value="Front and back scans captured by clearing house." class="cts-card-tagline" style="font-size: 10px; color: #64748b; margin-left: 4px;" />
					</div>
					<hlayout spacing="4px">
						<button id="btnViewFront" label="Front" class="cts-btn-secondary" style="font-weight: 700; height: 26px; padding: 0 8px; font-size: 11px;" />
						<button id="btnViewBack" label="Back" class="cts-btn-secondary" style="height: 26px; padding: 0 8px; font-size: 11px;" />
					</hlayout>
				</hlayout>

				<div id="imageContainer"
					style="width: 100%; height: 260px; display: flex; align-items: center; justify-content: center; background: #0f172a; border-radius: 6px; overflow: auto; margin-bottom: 8px;">
					<image id="imgCheque"
						style="transition: transform 0.2s ease, width 0.2s ease; max-height: 100%; object-fit: contain;" />
				</div>

				<hlayout spacing="6px" width="100%" valign="middle">
					<button id="btnZoomOut" iconSclass="z-icon-minus" class="cts-btn-secondary" style="height: 28px; width: 32px;" tooltiptext="Zoom Out" />
					<button id="btnZoomIn" iconSclass="z-icon-plus" class="cts-btn-secondary" style="height: 28px; width: 32px;" tooltiptext="Zoom In" />
					<button id="btnZoomFit" label="Reset View" iconSclass="z-icon-arrows-alt" class="cts-btn-secondary" style="height: 28px; font-size: 11px; padding: 0 8px;" />
					<button id="btnRotate" label="Rotate" iconSclass="z-icon-repeat" class="cts-btn-secondary" style="height: 28px; font-size: 11px; padding: 0 8px;" />
				</hlayout>
			</div>

			<!-- Right Card: Form Fields -->
			<div class="cts-work-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;">
				<div style="margin-bottom: 8px;">
					<label value="TRANSACTION DATA" class="cts-card-title" style="font-size: 13px; font-weight: 700; color: #0f172a;" />
					<label value="Edits are preserved automatically during navigation." class="cts-card-tagline" style="font-size: 10px; color: #64748b; margin-left: 4px;" />
				</div>

				<!-- Row 1: Cheque Number & Cheque Date -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Cheque Number" class="cts-field-lbl" />
						<textbox id="txtChequeNumber" class="cts-input-text" width="100%" />
					</div>
					<div class="cts-form-field">
						<label value="Cheque Date (YYYY-MM-DD)" class="cts-field-lbl" />
						<textbox id="txtChequeDate" class="cts-input-text" width="100%" />
					</div>
				</div>

				<!-- Row 2: Amount & Amount in Words -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Amount" class="cts-field-lbl" />
						<textbox id="txtAmount" class="cts-input-text cts-input-highlight" instant="true" width="100%" />
					</div>
					<div class="cts-form-field">
						<label value="Amount in Words" class="cts-field-lbl" />
						<textbox id="txtAmountInWords" class="cts-input-text" readonly="true"
							placeholder="Amount in words..." width="100%"
							style="background-color: #f8fafc; color: #475569; font-style: italic; border-color: #cbd5e1;" />
					</div>
				</div>

				<!-- Row 3: Drawee Account Number & Drawee Customer Name -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Drawee Account Number" class="cts-field-lbl" />
						<textbox id="txtDraweeAccount" class="cts-input-text" width="100%" />
					</div>
					<div class="cts-form-field">
						<label value="Drawee Customer Name" class="cts-field-lbl" />
						<textbox id="txtDraweeBankName" class="cts-input-text" width="100%" />
					</div>
				</div>

				<!-- Row 4: Payee Name & Maker Remarks -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Payee Name" class="cts-field-lbl" />
						<textbox id="txtPayeeName" class="cts-input-text" width="100%" />
					</div>
					<div class="cts-form-field">
						<label value="Maker Remarks" class="cts-field-lbl" />
						<textbox id="txtEntryRemark" class="cts-input-text"
							placeholder="Reason for correction..." width="100%" />
					</div>
				</div>

				<!-- Row 5: Action Buttons Layout -->
				<vlayout width="100%" spacing="8px"
					style="border-top: 1px solid #f1f5f9; padding-top: 10px; margin-top: 10px;">

					<!-- Row 5a: Item Actions -->
					<hlayout width="100%" spacing="8px" valign="middle"
						style="justify-content: space-between;">
						<div>
							<button id="btnCancel" label="Reset Item" iconSclass="z-icon-undo"
								class="cts-btn-secondary" style="height: 32px; font-size: 11px; padding: 0 10px;" />
						</div>

						<hlayout spacing="8px" valign="middle">
							<button id="btnRequestRejection" label="Request Rejection" iconSclass="z-icon-times-circle"
								class="cts-btn-outline-danger" style="height: 32px; font-size: 11px; padding: 0 12px;" />
							<button id="btnApproveCheque" label="Approve Cheque" iconSclass="z-icon-check"
								class="cts-btn-solid-primary" style="height: 32px; font-size: 11px; padding: 0 14px;" />
						</hlayout>
					</hlayout>

					<!-- Row 5b: Submit to Checker (Disabled initially, full width below) -->
					<button id="btnSubmitToChecker"
						label="Submit Batch to Checker"
						iconSclass="z-icon-paper-plane"
						class="cts-btn-submit-batch"
						width="100%"
						visible="true"
						disabled="true" />

				</vlayout>
			</div>

		</div>

		<!-- Rejection Reason Modal Window -->
		<div id="winRejectionModal" class="cts-modal-backdrop" visible="false">
			<div class="cts-modal-box">
				<vlayout spacing="12px">
					<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
						<label value="Request Instrument Rejection" style="font-size: 15px; font-weight: 700; color: #0f172a;" />
					</div>

					<label value="Please specify the CTS return reason and any remarks for the checker:"
						style="font-size: 12px; color: #475569;" />

					<vlayout spacing="4px">
						<label value="Rejection Reason / Return Code *" style="font-size: 11px; font-weight: 700; color: #1e293b;" />
						<combobox id="cmbModalRejectionReason" readonly="true" placeholder="Select return reason..." width="100%" />
					</vlayout>

					<vlayout spacing="4px">
						<label value="Rejection Remark" style="font-size: 11px; font-weight: 700; color: #1e293b;" />
						<textbox id="txtModalRejectionRemark" rows="2" placeholder="Enter reason details..." width="100%" />
					</vlayout>

					<div style="border-top: 1px solid #e2e8f0; padding-top: 10px; display: flex; justify-content: flex-end; gap: 8px;">
						<button id="btnCancelModalReject" label="Cancel" class="cts-btn-secondary" style="height: 30px; font-size: 12px;" />
						<button id="btnConfirmModalReject" label="Confirm Rejection" class="cts-btn-solid-primary"
							style="background: #dc2626 !important; border-color: #dc2626 !important; height: 30px; font-size: 12px;" />
					</div>
				</vlayout>
			</div>
		</div>

		<!-- Move to Maker Completion Modal Window -->
		<div id="winCompletionConfirmModal" visible="false"
			style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(15, 23, 42, 0.7) !important; z-index: 999999 !important;">

			<div style="position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; background: #ffffff !important; border-radius: 12px !important; padding: 24px 28px !important; width: 420px !important; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4) !important; text-align: center !important; z-index: 1000000 !important; box-sizing: border-box !important;">

				<div style="width: 46px; height: 46px; border-radius: 50%; background-color: #dcfce7; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
					<span class="z-icon-check" style="font-size: 22px; color: #16a34a; font-weight: 900;" />
				</div>

				<label value="Submit Batch to Checker" style="font-size: 17px; font-weight: 700; color: #0f172a; margin-bottom: 4px; display: block;" />
				<label value="All cheques in this batch are resolved. Moving this batch will forward it to the Checker verification queue."
					style="font-size: 12px; color: #64748b; line-height: 1.4; margin-bottom: 16px; display: block;" />

				<hlayout spacing="10px" style="display: flex; justify-content: center; margin-bottom: 20px; width: 100%;">
					<div style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 0;">
						<label value="TOTAL" style="font-size: 10px; font-weight: 700; color: #64748b; display: block;" />
						<label id="lblModalTotal" value="0" style="font-size: 18px; font-weight: 800; color: #0f172a; display: block;" />
					</div>
					<div style="flex: 1; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 8px 0;">
						<label value="ACCEPTED" style="font-size: 10px; font-weight: 700; color: #16a34a; display: block;" />
						<label id="lblModalAccepted" value="0" style="font-size: 18px; font-weight: 800; color: #16a34a; display: block;" />
					</div>
					<div style="flex: 1; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 8px 0;">
						<label value="REJECTED" style="font-size: 10px; font-weight: 700; color: #dc2626; display: block;" />
						<label id="lblModalRejected" value="0" style="font-size: 18px; font-weight: 800; color: #dc2626; display: block;" />
					</div>
				</hlayout>

				<hlayout spacing="10px" style="display: flex; justify-content: center; width: 100%;">
					<button id="btnCancelCompletionModal" label="Stay in Data Entry"
						style="background: #ffffff !important; border: 1px solid #cbd5e1 !important; color: #475569 !important; font-weight: 600; font-size: 12px; border-radius: 6px; height: 34px; padding: 0 14px; cursor: pointer;" />
					<button id="btnConfirmCompletionModal" label="Submit to Checker" iconSclass="z-icon-paper-plane"
						style="background: #059669 !important; border: none !important; color: #ffffff !important; font-weight: 600; font-size: 12px; border-radius: 6px; height: 34px; padding: 0 16px; cursor: pointer;" />
				</hlayout>

			</div>
		</div>
	</div>
</zk>