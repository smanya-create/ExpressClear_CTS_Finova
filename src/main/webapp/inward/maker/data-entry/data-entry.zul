<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="xhtml">
	<style src="/css/inward/data-entry.css" />
	<style>
		.cts-compact-progress .z-progressmeter-img { 
			background-image: none !important; 
			background-color: #2563eb !important;
			transition: width 0.3s ease-in-out !important; 
		}
		.cts-badge-data-entry { 
			display: inline-block; 
			padding: 2px 10px; 
			border-radius: 12px; 
			font-size: 11px; 
			font-weight: 700;
			white-space: nowrap; 
			background-color: #fef3c7; 
			color: #d97706;
			border: 1px solid #fde68a; 
		} 
		.cts-modal-backdrop { 
			position: fixed; 
			top: 0; 
			left: 0; 
			width: 100vw; 
			height: 100vh; 
			background: rgba(15, 23, 42, 0.65); 
			z-index: 10000; 
			display: flex;
			align-items: center; 
			justify-content: center; 
		} 
		.cts-modal-box {
			background: #ffffff; 
			width: 480px; 
			border-radius: 10px; 
			padding: 20px; 
			box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2); 
		}
	</style>

	<div id="dataEntryRootDiv" class="cts-data-entry-wrapper"
		apply="com.iispl.cts.controller.inward.maker.InwardDataEntryController">

		<!-- Header Bar -->
		<div class="cts-title-group"
			style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
			<div>
				<label value="Inward Data Entry" class="cts-main-title" />
				<label
					value="Review, edit, and decision individual cheques for inward clearing."
					class="cts-main-subtitle" />
			</div>

			<hlayout spacing="12px" valign="middle"
				style="background: #ffffff; padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 8px;">
				<hlayout spacing="6px" valign="middle">
					<progressmeter id="pmBatchProgress" value="0"
						width="120px" class="cts-compact-progress"
						style="height: 8px; border-radius: 4px; background: #e2e8f0;" />
					<label id="lblProgressText" value="0/0 (0%)"
						style="font-size: 11px; font-weight: 700; color: #475569;" />
				</hlayout>
				<separator orient="vertical" bar="true"
					style="height: 18px;" />
				<hlayout spacing="8px" valign="middle">
					<button id="btnPrevCheque" label="Prev"
						iconSclass="z-icon-chevron-left" class="cts-btn-secondary"
						style="height: 30px; padding: 0 10px; font-size: 12px;" />
					<label id="lblChequePosition" value="1 of 1"
						style="font-size: 12px; font-weight: 800; color: #1e293b; min-width: 45px; text-align: center;" />
					<button id="btnNextCheque" label="Next"
						iconSclass="z-icon-chevron-right" class="cts-btn-secondary"
						style="height: 30px; padding: 0 10px; font-size: 12px;" />

					<!-- Dynamic Proceed Button -->
					<button id="btnSubmitToChecker"
						label="Submit to Checker" iconSclass="z-icon-send"
						class="cts-btn-primary" visible="false" />
				</hlayout>
			</hlayout>
		</div>

		<!-- 6-Column Metadata Card -->
		<div id="metadataCardDiv" class="cts-metadata-card"
			style="display: flex; justify-content: space-between; align-items: center; gap: 16px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; margin-bottom: 14px;">
			<div class="cts-meta-col" style="flex: 1;">
				<label value="BATCH ID" class="cts-meta-header" />
				<label id="lblBatchId" value="-" class="cts-meta-val" />
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="SOURCE" class="cts-meta-header" />
				<label id="lblSource" value="CHI" class="cts-meta-val" />
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="TOTAL CHEQUES" class="cts-meta-header" />
				<label id="lblTotalCheques" value="0"
					class="cts-meta-val" />
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="CHEQUE NO." class="cts-meta-header" />
				<label id="lblChequeNo" value="-" class="cts-meta-val" />
			</div>
			<div class="cts-meta-col"
				style="flex: 1.5; min-width: 140px;">
				<label value="ITEM STATUS" class="cts-meta-header" />
				<div>
					<label id="lblDataStatus" value="PENDING"
						class="cts-badge-data-entry" />
				</div>
			</div>
			<div class="cts-meta-col" style="flex: 1;">
				<label value="RECEIVED DATE" class="cts-meta-header" />
				<label id="lblReceivedDate" value="-"
					class="cts-meta-val" />
			</div>
		</div>

		<!-- 2-Column Main Workspace -->
		<div id="workspaceGridDiv" class="cts-data-entry-grid">

			<!-- Left Card: Cheque Viewer -->
			<div class="cts-work-card">
				<hlayout
					style="display: flex; justify-content: space-between; align-items: center;">
					<div>
						<label value="CHEQUE IMAGE"
							class="cts-card-title" />
						<label
							value="Front and back scans captured by clearing house."
							class="cts-card-tagline" />
					</div>
					<hlayout spacing="4px">
						<button id="btnViewFront" label="Front"
							class="cts-btn-secondary" style="font-weight: 700;" />
						<button id="btnViewBack" label="Back"
							class="cts-btn-secondary" />
					</hlayout>
				</hlayout>

				<div id="imageContainer"
					style="width: 100%; height: 320px; display: flex; align-items: center; justify-content: center; background: #0f172a; border-radius: 6px; overflow: auto; margin: 12px 0;">
					<image id="imgCheque"
						style="transition: transform 0.2s ease, width 0.2s ease; max-height: 100%; object-fit: contain;" />
				</div>

				<hlayout spacing="8px" width="100%" valign="middle">
					<button id="btnZoomOut" iconSclass="z-icon-minus"
						class="cts-btn-secondary cts-btn-icon-sq" tooltiptext="Zoom Out" />
					<button id="btnZoomIn" iconSclass="z-icon-plus"
						class="cts-btn-secondary cts-btn-icon-sq" tooltiptext="Zoom In" />
					<button id="btnZoomFit" label="Reset View"
						iconSclass="z-icon-arrows-alt" class="cts-btn-secondary" />
					<button id="btnRotate" label="Rotate"
						iconSclass="z-icon-repeat" class="cts-btn-secondary" />
				</hlayout>
			</div>

			<!-- Right Card: Form Fields -->
			<div class="cts-work-card">
				<label value="TRANSACTION DATA" class="cts-card-title" />
				<label
					value="Edits are preserved automatically during navigation."
					class="cts-card-tagline" />

				<!-- Row 1: Cheque Number & Cheque Date -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Cheque Number"
							class="cts-field-lbl" />
						<textbox id="txtChequeNumber"
							class="cts-input-text" />
					</div>
					<div class="cts-form-field">
						<label value="Cheque Date (YYYY-MM-DD)"
							class="cts-field-lbl" />
						<textbox id="txtChequeDate"
							class="cts-input-text" />
					</div>
				</div>

				<!-- Row 2: Amount (Figures) & Amount in Words -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Amount" class="cts-field-lbl" />
						<textbox id="txtAmount"
							class="cts-input-text cts-input-highlight" instant="true" />
					</div>
					<div class="cts-form-field">
						<label value="Amount in Words"
							class="cts-field-lbl" />
						<textbox id="txtAmountInWords"
							class="cts-input-text" readonly="true"
							placeholder="Amount in words..."
							style="background-color: #f8fafc; color: #475569; font-style: italic; border-color: #cbd5e1;" />
					</div>
				</div>

				<!-- Row 3: Drawee Account Number & Customer Name -->
				<div class="cts-form-row">
					<div class="cts-form-field">
						<label value="Drawee Account Number"
							class="cts-field-lbl" />
						<textbox id="txtDraweeAccount"
							class="cts-input-text" />
					</div>
					<div class="cts-form-field">
						<label value="Drawee Customer Name"
							class="cts-field-lbl" />
						<textbox id="txtDraweeBankName"
							class="cts-input-text" />
					</div>
				</div>

				<!-- Row 4: Payee Name -->
				<div class="cts-form-row">
					<div class="cts-form-field" style="flex: 1;">
						<label value="Payee Name" class="cts-field-lbl" />
						<textbox id="txtPayeeName"
							class="cts-input-text" />
					</div>
				</div>

				<!-- Row 5: Maker Remarks -->
				<div style="margin-bottom: 20px;">
					<label value="Maker Remarks" class="cts-field-lbl" />
					<label
						value="Mandatory when correcting captured values"
						style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 4px;" />
					<textbox id="txtEntryRemark" rows="2"
						placeholder="Enter reason for correction (if any)..."
						class="cts-textarea" />
				</div>

				<!-- Row 6: Action Buttons -->
				<hlayout width="100%" spacing="8px" valign="middle"
					style="justify-content: flex-end;">
					<button id="btnCancel" label="Reset Item"
						iconSclass="z-icon-undo" class="cts-btn-secondary" />
					<button id="btnRequestRejection"
						label="Request Rejection" iconSclass="z-icon-times-circle"
						class="cts-btn-outline-danger" />
					<button id="btnApproveCheque" label="Approve Cheque"
						iconSclass="z-icon-check" class="cts-btn-solid-primary" />
				</hlayout>
			</div>

		</div>

		<!-- Rejection Reason Modal Window -->
		<div id="winRejectionModal" class="cts-modal-backdrop"
			visible="false">
			<div class="cts-modal-box">
				<vlayout spacing="14px">
					<div
						style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
						<label value="Request Instrument Rejection"
							style="font-size: 16px; font-weight: 700; color: #0f172a;" />
					</div>

					<label
						value="Please specify the CTS return reason and any remarks for the checker:"
						style="font-size: 12px; color: #475569;" />

					<vlayout spacing="4px">
						<label value="Rejection Reason / Return Code *"
							style="font-size: 12px; font-weight: 700; color: #1e293b;" />
						<combobox id="cmbModalRejectionReason"
							readonly="true" placeholder="Select return reason..."
							width="100%" />
					</vlayout>

					<vlayout spacing="4px">
						<label value="Rejection Remark"
							style="font-size: 12px; font-weight: 700; color: #1e293b;" />
						<textbox id="txtModalRejectionRemark" rows="3"
							placeholder="Enter reason details..." width="100%" />
					</vlayout>

					<div
						style="border-top: 1px solid #e2e8f0; padding-top: 12px; display: flex; justify-content: flex-end; gap: 8px;">
						<button id="btnCancelModalReject" label="Cancel"
							class="cts-btn-secondary" />
						<button id="btnConfirmModalReject"
							label="Confirm Rejection" class="cts-btn-solid-primary"
							style="background: #dc2626 !important; border-color: #dc2626 !important;" />
					</div>
				</vlayout>
			</div>
		</div>

		<!-- Move to Maker Completion Modal Window (Pure CSS Absolute Viewport Centering) -->
		<div id="winCompletionConfirmModal" visible="false"
			style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100vw !important; height: 100vh !important; background: rgba(15, 23, 42, 0.7) !important; z-index: 999999 !important;">

			<div
				style="position: absolute !important; top: 50% !important; left: 50% !important; transform: translate(-50%, -50%) !important; background: #ffffff !important; border-radius: 12px !important; padding: 28px 32px !important; width: 440px !important; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4) !important; text-align: center !important; z-index: 1000000 !important; box-sizing: border-box !important;">

				<!-- Green Check Icon Circle -->
				<div
					style="width: 52px; height: 52px; border-radius: 50%; background-color: #dcfce7; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
					<span class="z-icon-check"
						style="font-size: 24px; color: #16a34a; font-weight: 900;" />
				</div>

				<!-- Title & Description -->
				<label value="Submit Batch to Checker"
					style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 6px; display: block;" />
				<label
					value="All cheques in this batch are resolved. Moving this batch will forward it to the Checker verification queue."
					style="font-size: 13px; color: #64748b; line-height: 1.4; margin-bottom: 20px; display: block;" />

				<!-- Summary KPI Boxes -->
				<hlayout spacing="12px"
					style="display: flex; justify-content: center; margin-bottom: 24px; width: 100%;">
					<div
						style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 0;">
						<label value="TOTAL"
							style="font-size: 10px; font-weight: 700; color: #64748b; display: block; text-transform: uppercase;" />
						<label id="lblModalTotal" value="0"
							style="font-size: 20px; font-weight: 800; color: #0f172a; display: block; margin-top: 2px;" />
					</div>
					<div
						style="flex: 1; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 0;">
						<label value="ACCEPTED"
							style="font-size: 10px; font-weight: 700; color: #16a34a; display: block; text-transform: uppercase;" />
						<label id="lblModalAccepted" value="0"
							style="font-size: 20px; font-weight: 800; color: #16a34a; display: block; margin-top: 2px;" />
					</div>
					<div
						style="flex: 1; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 0;">
						<label value="REJECTED"
							style="font-size: 10px; font-weight: 700; color: #dc2626; display: block; text-transform: uppercase;" />
						<label id="lblModalRejected" value="0"
							style="font-size: 20px; font-weight: 800; color: #dc2626; display: block; margin-top: 2px;" />
					</div>
				</hlayout>

				<!-- Action Buttons -->
				<hlayout spacing="12px"
					style="display: flex; justify-content: center; width: 100%;">
					<button id="btnCancelCompletionModal"
						label="Stay in Data Entry"
						style="background: #ffffff !important; border: 1px solid #cbd5e1 !important; color: #475569 !important; font-weight: 600; font-size: 12px; border-radius: 6px; height: 36px; padding: 0 16px; cursor: pointer;" />
					<button id="btnConfirmCompletionModal"
						label="Submit to Checker" iconSclass="z-icon-paper-plane"
						style="background: #059669 !important; border: none !important; color: #ffffff !important; font-weight: 600; font-size: 12px; border-radius: 6px; height: 36px; padding: 0 18px; cursor: pointer; box-shadow: 0 2px 4px rgba(5, 150, 105, 0.2);" />
				</hlayout>

			</div>
		</div>
	</div>
</zk>