<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns:h="xhtml">
    <style src="/css/inward/data-entry.css" />

    <div id="dataEntryRootDiv" class="cts-data-entry-wrapper"
         apply="com.iispl.cts.controller.inward.maker.InwardDataEntryController">

        <!-- Top Breadcrumb, Title & Back Action -->
        <div class="cts-title-group">
            <div>
                
                <label value="Data Entry" class="cts-main-title" />
                <label value="Enter or correct cheque-level transaction details captured from the selected cheque." class="cts-main-subtitle" />
            </div>
            <button id="btnBackToReview" label="Back to Review" iconSclass="z-icon-arrow-left" class="cts-btn-secondary" />
        </div>

        <!-- 7-Column Metadata KPI Card -->
        <div class="cts-metadata-card">
            <div class="cts-meta-col">
                <label value="BATCH ID" class="cts-meta-header" />
                <label id="lblBatchId" value="IN-B004" class="cts-meta-val" />
            </div>
            <div class="cts-meta-col">
                <label value="SOURCE" class="cts-meta-header" />
                <label id="lblSource" value="CHI" class="cts-meta-val" />
            </div>
            <div class="cts-meta-col">
                <label value="TOTAL CHEQUES" class="cts-meta-header" />
                <label id="lblTotalCheques" value="99" class="cts-meta-val" />
            </div>
            <div class="cts-meta-col">
                <label value="CHEQUE NO." class="cts-meta-header" />
                <label id="lblChequeNo" value="100044" class="cts-meta-val" />
            </div>
            <div class="cts-meta-col">
                <label value="DATA STATUS" class="cts-meta-header" />
                <div>
                    <label id="lblDataStatus" value="DATA ENTRY" class="cts-badge-data-entry" />
                </div>
            </div>
            <div class="cts-meta-col">
                <label value="RECEIVED DATE" class="cts-meta-header" />
                <label id="lblReceivedDate" value="21-08-2026" class="cts-meta-val" />
            </div>
            <div class="cts-meta-col">
                <label value="RECEIVED SESSION" class="cts-meta-header" />
                <label id="lblReceivedSession" value="Morning" class="cts-meta-val" />
            </div>
        </div>

        <!-- Two-Column Workspace -->
        <div class="cts-data-entry-grid">
            
            <!-- Left Card: Cheque Viewer -->
            <div class="cts-work-card">
                <label value="CHEQUE IMAGE" class="cts-card-title" />
                <label value="Use the cheque image to enter and confirm the cheque-level transaction data." class="cts-card-tagline" />

                <!-- Cheque Image Area -->
                <div id="imageContainer" class="cts-cheque-box-placeholder">
                    <span class="z-icon-file-image-o" style="font-size: 38px; color: #475569; margin-bottom: 8px;" />
                    <label value="Cheque image preview container" style="font-size: 12px; color: #94a3b8;" />
                </div>

                <!-- Image Controls Toolbar -->
                <hlayout spacing="8px" width="100%" valign="middle">
                    <button id="btnZoomOut" iconSclass="z-icon-minus" class="cts-btn-secondary cts-btn-icon-sq" />
                    <button id="btnZoomIn" iconSclass="z-icon-plus" class="cts-btn-secondary cts-btn-icon-sq" />
                    <button id="btnZoomFit" label="Zoom Fit" iconSclass="z-icon-arrows-alt" class="cts-btn-secondary" />
                    <button id="btnRotate" label="Rotate" iconSclass="z-icon-repeat" class="cts-btn-secondary" />
                    <separator hflex="1" />
                    <button id="btnExpand" iconSclass="z-icon-expand" class="cts-btn-secondary cts-btn-icon-sq" />
                </hlayout>
            </div>

            <!-- Right Card: Form Fields -->
            <div class="cts-work-card">
                <label value="CHEQUE DATA ENTRY" class="cts-card-title" />
                <label value="Enter only cheque-level transaction details. MICR correction is handled separately." class="cts-card-tagline" />

                <!-- Row 1: Cheque Number & Cheque Date -->
                <div class="cts-form-row">
                    <div class="cts-form-field">
                        <label value="Cheque Number" class="cts-field-lbl" />
                        <textbox id="txtChequeNumber" value="100044" class="cts-input-text" />
                    </div>
                    <div class="cts-form-field">
                        <label value="Cheque Date" class="cts-field-lbl" />
                        <textbox id="txtChequeDate" value="18-08-2026" class="cts-input-text" />
                    </div>
                </div>

                <!-- Row 2: Amount & Drawee Account Number -->
                <div class="cts-form-row">
                    <div class="cts-form-field">
                        <label value="Amount" class="cts-field-lbl" />
                        <textbox id="txtAmount" value="₹ 8,500.00" class="cts-input-text cts-input-highlight" />
                    </div>
                    <div class="cts-form-field">
                        <label value="Drawee Account Number" class="cts-field-lbl" />
                        <textbox id="txtDraweeAccount" value="9876543212" class="cts-input-text" />
                    </div>
                </div>

                <!-- Row 3: Drawee Bank Name & Payee Name -->
                <div class="cts-form-row">
                    <div class="cts-form-field">
                        <label value="Drawee Bank Name" class="cts-field-lbl" />
                        <textbox id="txtDraweeBankName" value="CSS Bank Limited" class="cts-input-text" />
                    </div>
                    <div class="cts-form-field">
                        <label value="Payee Name" class="cts-field-lbl" />
                        <textbox id="txtPayeeName" value="XYZ" class="cts-input-text" />
                    </div>
                </div>

                <!-- Row 4: Entry Remark -->
                <div style="margin-bottom: 16px;">
                    <label value="Entry Remark" class="cts-field-lbl" />
                    <label value="Mandatory when correcting captured data" style="font-size: 11px; color: #94a3b8; display: block; margin-bottom: 4px;" />
                    <textbox id="txtEntryRemark" rows="3" placeholder="Enter reason for data correction..." class="cts-textarea" />
                </div>

                <!-- Row 5: Action Buttons -->
                <hlayout width="100%" spacing="5px" valign="middle">
                    <button id="btnCancel" label="Cancel" class="cts-btn-secondary" />
                    <button id="btnValidateData" label="Validate Data" class="cts-btn-outline-primary" />
                    <button id="btnRequestRejection" label="Request Rejection" class="cts-btn-outline-danger" />
                    <button id="btnSaveDataEntry" label="Save" class="cts-btn-solid-primary" />
                </hlayout>
            </div>

        </div>

        <!-- Footer -->
        <div class="cts-portal-footer">
            <label value="Express Clear CTS · Inward Processing" class="cts-footer-left" />
            <label value="v1.0" class="cts-footer-right" />
        </div>

    </div>
</zk>