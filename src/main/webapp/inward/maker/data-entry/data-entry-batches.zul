<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Inward Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>
    <!-- Use the exact same stylesheet as MICR Repair -->
    <style src="/css/inward/micr-repair-queue.css" />

    <div id="dataEntryBatchesRoot"
         width="100%"
         height="100%"
         apply="com.iispl.cts.controller.inward.maker.InwardDataEntryBatchesController"
         sclass="micr-repair-view-page"
         style="overflow-y: auto; overflow-x: hidden;">

        <vlayout width="100%" spacing="16px">

            <!-- ================================================= -->
            <!-- 1. PAGE TITLE (Identical to MICR Repair)          -->
            <!-- ================================================= -->
            <vlayout spacing="4px" sclass="micr-repair-view-title-section">
                <label value="DATA ENTRY" sclass="micr-repair-view-title" />
            </vlayout>

            <!-- ================================================= -->
            <!-- 2. MAIN SECTION CARD                             -->
            <!-- ================================================= -->
            <div sclass="micr-repair-section-card" width="100%">

                <vlayout width="100%" spacing="12px">

                    <!-- Section Header & Count -->
                    <hlayout width="100%" valign="middle" style="display: flex; justify-content: space-between; align-items: center;">
                        <vlayout spacing="3px">
                            <label value="Batches Ready for Data Entry" sclass="micr-repair-section-title" />
                        </vlayout>
                        <label id="lblBatchResultCount" value="0 Batches" sclass="batch-result-count" />
                    </hlayout>

                    <!-- Filter Toolbar (Matches MICR Repair filter layout) -->
                    <div sclass="micr-repair-filter-bar">
                        <hlayout valign="middle" spacing="12px">
                            <label value="Search Batch ID" sclass="filter-label" />
                            <textbox id="txtSearchBatch"
                                     placeholder="Enter full or partial Batch ID"
                                     width="360px"
                                     sclass="batch-filter-input"
                                     onChanging="$composer.onChanging$txtSearchBatch(event)" />
                            <button id="btnClearSearch"
                                    label="Clear"
                                    sclass="clear-filter-button"
                                    onClick="$composer.onClick$btnClearSearch()" />
                        </hlayout>
                    </div>

                    <!-- Single Grid identical to MICR Repair -->
                    <grid id="grdDataEntryBatches" width="100%" sclass="micr-repair-grid">
                        <columns sizable="false">
                            <column label="BATCH" width="18%" align="center" />
                            <column label="TOTAL ITEMS" width="15%" align="center" />
                            <column label="PENDING ITEMS" width="15%" align="center" />
                            <column label="TOTAL AMOUNT (INR)" width="20%" align="center" />
                            <column label="STATUS" width="16%" align="center" />
                            <column label="ACTION" width="16%" align="center" />
                        </columns>
                        <rows id="rowsDataEntryBatches" />
                    </grid>

                    <!-- Outward / MICR Repair Pagination -->
                    <paging id="pagingDataEntry"
                            pageSize="10"
                            detailed="true"
                            sclass="micr-repair-paging" />

                    <!-- Empty Message Card -->
                    <div id="divDataEntryEmpty" width="100%" visible="false" sclass="micr-repair-empty-card">
                        <vlayout width="100%" spacing="6px">
                            <label value="No Data Entry Required" sclass="micr-repair-empty-title" />
                            <label value="There are currently no batches requiring data entry." sclass="micr-repair-empty-message" />
                        </vlayout>
                    </div>

                </vlayout>

            </div>

        </vlayout>

    </div>
</zk>