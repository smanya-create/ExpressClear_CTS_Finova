<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Inward Data Entry" contentType="text/html;charset=UTF-8"?>

<zk>
    <style src="/css/inward/data-entry-batches.css" />

    <div id="dataEntryBatchesRoot"
         width="100%"
         height="100%"
         apply="com.iispl.cts.controller.inward.maker.InwardDataEntryBatchesController"
         sclass="data-entry-view-page"
         style="overflow-y: auto; overflow-x: hidden;">

        <vlayout width="100%" spacing="16px">

            <!-- PAGE TITLE -->
            <vlayout spacing="4px" sclass="data-entry-view-title-section">
                <label value="DATA ENTRY" sclass="data-entry-view-title" />
            </vlayout>

            <!-- MAIN SECTION CARD -->
            <div sclass="data-entry-section-card" width="100%">

                <vlayout width="100%" spacing="12px">

                    <!-- Section Header & Result Count -->
                    <hlayout width="100%" valign="middle" style="display: flex; justify-content: space-between; align-items: center;">
                        <vlayout spacing="3px">
                            <label value="Batches Ready for Data Entry" sclass="data-entry-section-title" />
                        </vlayout>
                        <label id="lblBatchResultCount" value="0 Batches" sclass="data-entry-result-count" />
                    </hlayout>

                    <!-- Filter Toolbar -->
                    <div sclass="data-entry-filter-bar">
                        <hlayout valign="middle" spacing="12px">
                            <label value="Search Batch ID" sclass="data-entry-filter-label" />
                            <textbox id="txtSearchBatch"
                                     placeholder="Enter full or partial Batch ID"
                                     width="360px"
                                     sclass="data-entry-filter-input"
                                     onChanging="$composer.onChanging$txtSearchBatch(event)" />
                            <button id="btnClearSearch"
                                    label="Clear"
                                    sclass="data-entry-clear-button"
                                    onClick="$composer.onClick$btnClearSearch()" />
                        </hlayout>
                    </div>

                    <!-- Data Entry Grid -->
                    <grid id="grdDataEntryBatches" width="100%" sclass="data-entry-grid">
                        <columns sizable="false">
                            <column label="BATCH" width="18%" align="center" />
                            <column label="TOTAL ITEMS" width="15%" align="center" />
                            <column label="PENDING ITEMS" width="15%" align="center" />
                            <column label="TOTAL AMOUNT (INR)" width="20%" align="center" />
                            <column label="STATUS" width="16%" align="center" />
                            <column label="ACTION" width="16%" align="center" />
                        </columns>
                        <rows id="rowsDataEntryBatches" />
                    </grid>

                    <!-- Pagination -->
                    <paging id="pagingDataEntry"
                            pageSize="10"
                            detailed="true"
                            sclass="data-entry-paging" />

                    <!-- Empty State Card -->
                    <div id="divDataEntryEmpty" width="100%" visible="false" sclass="data-entry-empty-card">
                        <vlayout width="100%" spacing="6px">
                            <label value="No Data Entry Required" sclass="data-entry-empty-title" />
                            <label value="There are currently no batches requiring data entry." sclass="data-entry-empty-message" />
                        </vlayout>
                    </div>

                </vlayout>

            </div>

        </vlayout>

    </div>
</zk>