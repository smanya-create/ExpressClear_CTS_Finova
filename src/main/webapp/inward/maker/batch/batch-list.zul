<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Batch Intake" contentType="text/html;charset=UTF-8"?>

<zk>
	<style src="/css/inward/batch.css" />

	<!-- Use window as root so InwardBatchController can cast it without ClassCastException -->
	<window id="inwardBatchQueueWindow" border="none" width="100%"
		style="margin: 0 !important; padding: 0 !important;"
		apply="com.iispl.cts.controller.inward.maker.InwardBatchController"
		sclass="batch-page">

		<vlayout width="100%" spacing="16px">

			<!-- 1. Unified Page Title -->
			<vlayout spacing="4px" sclass="batch-title-section">
				<label value="BATCH INTAKE" sclass="batch-page-title" />
				<label
					value="Validate each batch before it enters MICR Repair or Data entry."
					sclass="batch-page-subtitle" />
			</vlayout>

			<!-- 2. Main Section Card -->
			<div sclass="batch-section-card" width="100%">

				<vlayout width="100%" spacing="12px">

					<!-- Section Header & Count -->
					<hlayout width="100%" valign="middle"
						sclass="batch-card-header">
						<vlayout spacing="3px">
							<label value="Received Inward Batches"
								sclass="batch-section-title" />
							<label
								value="Inward batch packages detected in the intake directory."
								sclass="batch-section-subtitle" />
						</vlayout>
						<label id="batchCountLabel" value="0 Batches"
							sclass="batch-result-count" />
					</hlayout>

					<!-- Filter Toolbar -->
					<div sclass="batch-filter-bar">
						<hlayout valign="middle" spacing="12px"
							sclass="z-valign-middle">
							<label value="Batch No."
								sclass="filter-label" />
							<textbox id="batchSearchTextbox"
								placeholder="Enter Batch No..." width="180px"
								sclass="batch-filter-input" />

							<label value="Status" sclass="filter-label" />
							<combobox id="statusCombobox"
								readonly="true" width="200px" sclass="batch-filter-combobox"
								value="All">
								<comboitem label="All" />
								<comboitem label="Received" />
								<comboitem label="Parsing" />
								<comboitem label="Processing" />
								<comboitem
									label="Checker Processing Pending" />
								<comboitem label="Checker Processing" />
								<comboitem
									label="Send Back To Maker Micr" />
								<comboitem
									label="Send Back To Maker Data Entry" />
								<comboitem label="Completed" />
								<comboitem label="Pending Validation" />
								<comboitem label="Validation Failed" />
							</combobox>

							<label value="Received Date"
								sclass="filter-label" />
							<datebox id="receivedDatebox"
								placeholder="Select Date" width="140px"
								sclass="batch-filter-datebox" />

							<button id="searchButton" label="Search"
								iconSclass="z-icon-search" sclass="batch-btn-search" />

							<button id="clearButton" label="Clear"
								iconSclass="z-icon-undo" sclass="batch-btn-clear" />
						</hlayout>
					</div>

					<!-- Table with Deep Navy Header, Fixed Height Scroll, and Paging -->
					<div sclass="batch-table-wrapper">
						<listbox id="batchListbox" width="100%"
							mold="paging" pageSize="10" sclass="batch-listbox"
							emptyMessage="No inward batches found">
							<listhead sizable="false">
								<listheader label="BATCH NO."
									width="20%" align="center" />
								<listheader label="RECEIVED ON"
									width="22%" align="center" />
								<listheader label="AMOUNT (INR)"
									width="20%" align="center" />
								<listheader label="STATUS" width="20%"
									align="center" />
								<listheader label="ACTION" width="18%"
									align="center" />
							</listhead>
						</listbox>
					</div>
				</vlayout>

			</div>

		</vlayout>

	</window>
</zk>