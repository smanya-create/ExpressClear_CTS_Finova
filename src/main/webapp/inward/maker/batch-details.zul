<?xml version="1.0" encoding="UTF-8"?>

<zk>
	<style src="/css/inward/maker-batch-details.css" />

	<div id="inwardMakerBatchDetailsDiv" width="100%"
		style="min-height: calc(100vh - 80px); padding-bottom: 40px; box-sizing: border-box;"
		sclass="inward-maker-batch-details"
		apply="com.iispl.cts.controller.inward.maker.InwardMakerBatchDetailsController">

		<div sclass="inward-maker-batch-details-scroll">

			<div sclass="inward-maker-batch-details-card">

				<div sclass="inward-maker-batch-details-heading">
					<div>
						<label value="Batch Details"
							sclass="inward-maker-batch-details-title" />
						<label
							value="View and process inward cheques in this batch."
							sclass="inward-maker-batch-details-subtitle" />
					</div>

					<button id="inwardMakerBtnBack"
						label="BACK TO DASHBOARD"
						sclass="inward-maker-batch-back-button" />
				</div>

				<div sclass="inward-maker-batch-summary">

					<div sclass="inward-maker-batch-summary-item">
						<label value="BATCH ID"
							sclass="inward-maker-batch-summary-label" />
						<label id="inwardMakerLblBatchId" value="-"
							sclass="inward-maker-batch-summary-value" />
					</div>

					<div sclass="inward-maker-batch-summary-item">
						<label value="NO. OF CHEQUES"
							sclass="inward-maker-batch-summary-label" />
						<label id="inwardMakerLblChequeCount" value="0"
							sclass="inward-maker-batch-summary-value" />
					</div>

					<div sclass="inward-maker-batch-summary-item">
						<label value="TOTAL AMOUNT"
							sclass="inward-maker-batch-summary-label" />
						<label id="inwardMakerLblTotalAmount"
							value="₹0.00" sclass="inward-maker-batch-summary-value" />
					</div>

				</div>

				<div sclass="inward-maker-cheque-section">
					<label value="Cheque Details"
						sclass="inward-maker-cheque-section-title" />
					<label
						value="Review inward cheque information and take the required action."
						sclass="inward-maker-cheque-section-subtitle" />
				</div>

				<div sclass="inward-maker-cheque-table-card">

					<grid id="inwardMakerGridChequeDetails"
						width="100%" sclass="inward-maker-cheque-grid">

						<columns sizable="true">
							<column label="Cheque No." width="12%" />
							<column label="Drawee Account No." width="17%" />
							<column label="Cheque Date" width="12%" />
							<column label="MICR Code" width="13%" />
							<column label="Cheque Status" width="18%" />
							<column label="Cheque Amount" width="13%" />
							<column label="Action" width="15%" />
						</columns>

						<rows id="inwardMakerRowsChequeDetails" />

					</grid>

					<vlayout id="inwardMakerVlayoutEmptyState"
						visible="false" sclass="inward-maker-batch-empty-state">
						<label value="No cheques found"
							sclass="inward-maker-batch-empty-title" />
						<label
							value="There are currently no cheques available in this batch."
							sclass="inward-maker-batch-empty-subtitle" />
					</vlayout>

				</div>

				<div sclass="inward-maker-batch-pagination">
					<button id="inwardMakerBtnFirst" label="&lt;&lt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnPrevious" label="&lt;"
						sclass="inward-maker-pagination-button" />
					<label id="inwardMakerLblCurrentPage" value="1 / 1"
						sclass="inward-maker-pagination-label" />
					<button id="inwardMakerBtnNext" label="&gt;"
						sclass="inward-maker-pagination-button" />
					<button id="inwardMakerBtnLast" label="&gt;&gt;"
						sclass="inward-maker-pagination-button" />
				</div>

			</div>

		</div>

	</div>

</zk>