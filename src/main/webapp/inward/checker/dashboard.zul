<?xml version="1.0" encoding="UTF-8"?>
<zk>
    <!-- Custom styling to force Listheader background to White -->
    <style>
        .listbox-header .z-listheader {
            background: #FFFFFF !important;
            border-bottom: 1px solid #E0E6ED !important;
        }
        .listbox-header .z-listheader-content {
            color: #1D2D46 !important;
            font-weight: bold !important;
            font-size: 10px !important;
        }
    </style>

    <!-- Explicitly set Session Attributes before sidebar component renders -->
    <zscript>
        org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("USER_ROLE", "INWARD_CHECKER");
        org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("LOGGED_USER", "Alex");
    </zscript> 

    <borderlayout width="100%" height="100vh">

        <west width="220px" border="0">
            <include src="/components/sidebar.zul?role=INWARD_CHECKER&amp;activeTab=inward-dashboard"/>
        </west>

        <center border="0">
            <borderlayout width="100%" height="100%">

                <north height="55px" border="0">
                    <include src="/components/header.zul?role=INWARD_CHECKER&amp;activeTab=inward-dashboard"/>
                </north>

                <center border="0" autoscroll="true">
                    <vlayout spacing="12px" style="padding:20px">
 
                        <label value="Checker Dashboard"
                               style="font-size:24px;font-weight:bold;color:#1D2D46"/>

                        <label value="Monitor batches submitted by Maker and track cheque verification progress."
                               style="font-size:11px;color:#8793A6"/>

                        <vlayout style="border:1px solid #E0E6ED;border-radius:6px;padding:12px">
                            <label value="Batch Search" style="font-weight:bold;font-size:14px"/>
                            <hlayout spacing="8px">
                                <textbox hflex="1" placeholder="Enter Batch ID" style="font-size:14px"/>
                                <button label="Clear" style="background:#1B4A8F;color:white;border:0"/>
                                <button label="Search" style="background:#1B4A8F;color:white;border:0"/>
                            </hlayout>
                        </vlayout>

                        <!-- Batch Details Table (Listbox) -->
                        <vlayout style="border:1px solid #E0E6ED;border-radius:6px;padding:12px;background:white">
                            <listbox id="batchListbox" sclass="listbox-header" 
                            			emptyMessage="No batch details found" >
                                <listhead>
                                    <listheader label="BATCH ID"/>
                                    <listheader label="TOTAL CHEQUES" align="center"/>
                                    <listheader label="NORMAL CHEQUES" align="center"/>
                                    <listheader label="REJECTION REQUESTS" align="center"/>
                                    <listheader label="ACTION" align="center" width="180px"/>
                                </listhead>
                               
                                
                            </listbox>
                        </vlayout>

                    </vlayout>
                    
                </center>

            </borderlayout>
        </center>

    </borderlayout>
</zk>