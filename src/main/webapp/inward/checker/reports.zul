<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/inward/reports.css"/>

    <zscript>
        org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("CTS_USER_ROLE", "INWARD_CHECKER");
        org.zkoss.zk.ui.Sessions.getCurrent().setAttribute("LOGGED_USER", "Alex");
    </zscript>

    <borderlayout width="100%"
                  height="100%"
                  apply="com.iispl.cts.controller.inward.checker.InwardCheckerReportsController">

        <west width="220px" border="0">
            <include src="/components/sidebar.zul?role=INWARD_CHECKER&amp;activeTab=inward-checker-reports"/>
        </west>

        <center border="0">

            <borderlayout width="100%"
                          height="100%">

                <north height="70px"
                       border="0">
                    <include src="/components/header.zul?pageTitle=Generate Reports&amp;pageSubtitle=Inward Checker"/>
                </north>

                <center border="none"
                        sclass="checker-reports-center">

                    <vlayout spacing="6px"
                             width="100%"
                             height="100%"
                             style="padding:10px;box-sizing:border-box;background:#FFFFFF;"
                             sclass="checker-reports-content">

                        <vlayout spacing="0px">

                            <label value="Generate Reports"
                                   style="font-size:24px;font-weight:bold;color:black"/>

                            <label value="Generate reports for all verified batches"
                                   style="font-size:10px;color:#807977"/>

                        </vlayout>

                        <label value="Batch Search"
                               style="font-weight:bold;font-size:16px"/>

                        <hlayout spacing="6px"
                                 style="align-items:center">

                            <textbox id="txtSearchBatchId"
                                     hflex="1"
                                     height="30px"
                                     placeholder="Enter Batch ID"
                                     style="font-size:13px;padding:2px 8px"/>

                            <button id="btnClear"
                                    label="Clear"
                                    height="30px"
                                    style="background:#1B4A8F;color:white;border:0;font-size:16px;padding:0 14px;border-radius:4px"/>

                            <button id="btnSearch"
                                    label="Search"
                                    height="30px"
                                    style="background:#1B4A8F;color:white;border:0;font-size:16px;padding:0 14px;border-radius:4px"/>

                        </hlayout>

                        <separator style="height:4px"/>

                        <label value="All Batches"
                               style="font-weight:bold;font-size:16px"/>

                        <listbox id="reportListbox"
                                 width="100%"
                                 mold="paging"
                                 pageSize="1"
                                 nonselectableTags="*"
                                 emptyMessage="No report data available"
                                 sclass="compact-report-listbox">

                            <listhead sclass="listbox-header">

                                <listheader label="Batch ID"
                                            align="center"
                                            width="18%"/>

                                <listheader label="Total Cheques"
                                            align="center"
                                            width="15%"/>

                                <listheader label="Approved"
                                            align="center"
                                            width="15%"/>

                                <listheader label="Rejected"
                                            align="center"
                                            width="15%"/>

                                <listheader label="RRF"
                                            align="center"
                                            width="20%"/>

                                <listheader label="BSF"
                                            align="center"
                                            width="20%"/>

                            </listhead>

                        </listbox>

                    </vlayout>

                </center>

            </borderlayout>

        </center>

    </borderlayout>

</zk>